<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- To tell the mobile network from wifi when choosing the streaming quality. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- To let wifi multicast packets through while the app looks for Cast
         devices, which announce themselves in them. ACCESS_LOCAL_NETWORK is
         not asked for: it exists from Android 17 and is requested only by
         apps that target it; targeting 36, INTERNET covers the local
         network. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- PlaybackService's, which keeps playing with the screen off. Its
         notification needs no POST_NOTIFICATIONS: a media session's is let
         through. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- DownloadService's job, which keeps downloads going in the background
         from Android 14, and the notification it shows from Android 13. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backups: the saved sign-in is encrypted with a key that stays in
         this phone's Keystore, so a copy restored elsewhere couldn't be read. -->
    <application
        android:allowBackup="false"
        android:label="${label}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Turning the phone or changing its settings would restart the
             activity, and with it the app; Slint redraws for the new size. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="fonoteca_client" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
