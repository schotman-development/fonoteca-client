                    if root.current == 7: Example {
                        caption: "Album; on a narrow window the text moves under the cover";
                        PageHeader {
                            artwork: root.albums[0].cover;
                            kind: "Album";
                            title: root.albums[0].title;
                            names: root.long-text ? root.many : root.mara;
                            facts: "2021 · Folk · 9 tracks, 41 minutes";
                            open(link) => { root.event = "open " + link; }
                            PlayButton {
                                play => { root.event = "play"; }
                                queue(how) => { root.event = how; }
                            }
                            DownloadButton {
                                state: root.download-state;
                                progress: "3 of 9";
                                clicked => { root.download-state = Math.mod(root.download-state + 1, 3); }
                            }
                            IconButton {
                                icon: Icons.heart;
                                filled: root.loved-album;
                                color: root.loved-album ? Theme.accent : Theme.muted;
                                label: root.loved-album ? "Loved" : "Love";
                                clicked => { root.loved-album = !root.loved-album; }
                            }
                        }
                    }
                    if root.current == 7: Example {
                        caption: "Artist";
                        PageHeader {
                            artwork: root.photo-1;
                            round: true;
                            kind: "Artist";
                            title: root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : "Mara Lind";
                            facts: "6 albums, 2 compilations";
                            PlayButton {
                                play => { root.event = "play"; }
                                queue(how) => { root.event = how; }
                            }
                        }
                    }

                    if root.current == 8: Example {
                        caption: "The current section is highlighted; sections are grouped under headings, such as the library's pages and the playlists, the last without one; the playlists' heading is their page's section, with a menu; more than fit scroll";
                        Sidebar {
                            width: 220px;
                            height: 380px;
                            items: ["Albums", "Artists", "Composers", "Playlists", "Road Trip", root.long-text ? root.long-title : "Sunday Morning", "Running", "Focus", "Dinner Party", "Rainy Day", "Account"];
                            groups: [
                                root.long-text ? "Library on the server down the hall" : "Library",
                                root.long-text ? "Library on the server down the hall" : "Library",
                                root.long-text ? "Library on the server down the hall" : "Library",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                            ];
                            icons: [Icons.album, Icons.artist, Icons.composer, "", "", "", "", "", "", "", Icons.person];
                            selected(index) => { root.event = "section " + index; }
                        }
                    }

                    if root.current == 9: Example {
                        caption: "Back is possible here, forward isn't; press Enter to search";
                        Rectangle {
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            TopBar {
                                can-go-back: true;
                                back => { root.event = "back"; }
                                forward => { root.event = "forward"; }
                                search(query) => { root.event = "search " + query; }
                            }
                        }
                    }

                    if root.current == 10: Example {
                        caption: "Heart, back, forward, a button that can't be pressed, and up or down";
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            IconButton {
                                icon: Icons.heart;
                                filled: root.loved-1;
                                color: root.loved-1 ? Theme.accent : Theme.text;
                                label: "Love";
                                clicked => { root.loved-1 = !root.loved-1; }
                            }
                            IconButton {
                                icon: Icons.back;
                                label: "Back";
                                clicked => { root.event = "back"; }
                            }
                            IconButton {
                                icon: Icons.forward;
                                label: "Forward";
                                clicked => { root.event = "forward"; }
                            }
                            IconButton {
                                icon: Icons.forward;
                                label: "Forward";
                                enabled: false;
                            }
                            IconButton {
                                icon: root.down ? Icons.down : Icons.up;
                                label: "Descending";
                                accessible-checkable: true;
                                accessible-checked: root.down;
                                clicked => { root.down = !root.down; }
                            }
                        }
                    }

                    if root.current == 11: Example {
                        caption: "How many are selected, and the button that ends selecting";
                        HorizontalLayout {
                            alignment: start;
                            SelectionBar {
                                count: root.long-text ? 12345 : 3;
                                clear => { root.event = "clear selection"; }
                            }
                        }
                    }

                    if root.current == 12: Example {
                        caption: "Headings over rows; the title takes the room left over, names are links, empty cells stay empty, the heart loves, a heading sorts, a right-click selects, the dots open the menu";
                        VerticalLayout {
                            TrackHeader {
                                columns: root.table-columns;
                                sort(index) => { root.event = "sort by " + root.table-columns[index].title; }
                            }
                            for line[i] in root.table-lines: TrackLineRow {
                                columns: root.table-columns;
                                line: line;
                                striped: mod(i, 2) == 1;
                                selecting: root.picked-1 || root.picked-2 || root.picked-3;
                                joined-above: i > 0 && root.table-lines[i - 1].selected;
                                joined-below: i + 1 < root.table-lines.length && root.table-lines[i + 1].selected;
                                open(link) => { root.event = link; }
                                select => {
                                    if i == 0 {
                                        root.picked-1 = !root.picked-1;
                                    } else if i == 1 {
                                        root.picked-2 = !root.picked-2;
                                    } else {
                                        root.picked-3 = !root.picked-3;
                                    }
                                    root.event = "select " + i;
                                }
                                toggle-love => {
                                    if i == 0 {
                                        root.loved-1 = !root.loved-1;
                                    } else if i == 1 {
                                        root.loved-2 = !root.loved-2;
                                    } else {
                                        root.loved-3 = !root.loved-3;
                                    }
                                }
                            }
                        }
                    }

                    if root.current == 13: Example {
                        caption: "A list's rows, such as users: the name, a line about it cut short when it is long, the dots open the menu; a row without entries has no dots; a settings section has its icon, a line and an arrow, and opens on a click";
                        VerticalLayout {
                            ListRow {
                                title: root.long-text ? root.long-title : "joe";
                                details: root.long-text ? "joe.with.a.long.address@example.org · Admin · Settings · Stream · Download · Upload · Cover art · Comments · Podcasts · Share" : "Admin · Settings · Stream";
                                entries: [{ id: "edit", label: "Edit", icon: Icons.pencil }];
                                activated(id) => { root.event = id + " joe"; }
                            }
                            ListRow {
                                title: "bea";
                                details: "bea@example.org · Stream";
                                entries: [
                                    { id: "edit", label: "Edit", icon: Icons.pencil },
                                    { id: "password", label: "Change password", icon: Icons.key },
                                    { id: "delete", label: "Delete", icon: Icons.trash, danger: true },
                                ];
                                activated(id) => { root.event = id + " bea"; }
                            }
                            ListRow {
                                title: "guest";
                            }
                            SettingsRow {
                                icon: Icons.sound;
                                title: "Sound processing";
                                summary: root.long-text ? root.long-title : "Headroom, crossfeed, upsampling and EQ";
                                clicked => { root.event = "open sound"; }
                            }
                        }
                    }

                    if root.current == 14: Example {
                        caption: "The track playing, the first with its waveform as the seek bar and the third with the plain bar: the light says how well it reaches the speakers, as Roon colours it, and opens the steps; a click anywhere on the bar but its controls opens the now playing sheet; a problem takes the artists' place, and the artists are no links; on a phone only play and next stay, without the position, shuffle and repeat";
                        PlayerBar {
                            cover: root.albums[0].cover;
                            title: root.long-text ? root.long-title : "Northern Lights";
                            names: root.long-text ? root.many : root.mara;
                            paused: root.player-paused;
                            position: root.player-position;
                            duration: 271;
                            waveform: root.waveform;
                            quality: "Lossless";
                            level: 3;
                            path: [
                                { text: "FLAC 96 kHz 24-bit", quality: 3 },
                                { text: "Exclusive: USB DAC (96000 Hz 24-bit, 2 channels)", quality: 3 },
                            ];
                            shuffled: root.player-shuffled;
                            repeat: root.player-repeat;
                            open-playing => { root.event = "open playing"; }
                            toggle-shuffle => { root.player-shuffled = !root.player-shuffled; }
                            cycle-repeat => { root.player-repeat = mod(root.player-repeat + 1, 3); }
                            toggle-pause => { root.player-paused = !root.player-paused; }
                            previous => { root.event = "previous"; }
                            next => { root.event = "next"; }
                            seek(seconds) => { root.player-position = seconds; }
                        }
                        PlayerBar {
                            cover: root.albums[1].cover;
                            title: "Song of the Sea";
                            problem: "The sound device takes no format this can play.";
                            paused: true;
                            duration: 0;
                            quality: "Low quality";
                            level: 0;
                            path: [
                                { text: "MP3 44.1 kHz", quality: 0 },
                                { text: "Volume leveling -6.2 dB (track)", quality: 2 },
                                { text: "Resampled 44.1 kHz to 48 kHz", quality: 1 },
                                { text: "Shared: Default (48000 Hz 32-bit float, 2 channels)", quality: 1 },
                            ];
                        }
                        PlayerBar {
                            cover: root.albums[2].cover;
                            title: "Equalized";
                            names: root.mara;
                            duration: 200;
                            quality: "Enhanced";
                            level: 2;
                            repeat: 2;
                            shuffled: true;
                            path: [
                                { text: "FLAC 44.1 kHz 16-bit", quality: 3 },
                                { text: "Parametric EQ, 5 bands", quality: 2 },
                                { text: "Exclusive: USB DAC (44100 Hz 24-bit, 2 channels)", quality: 3 },
                            ];
                        }
                    }

                    if root.current == 16: Example {
                        caption: "The queue's rows with a grip each, but for the song playing and the work that is open: drag one by a mouse or a finger, and the row follows as a copy with a line where it lands; the list scrolls when the pointer nears the edge of the view";
                        max-width: 640px;
                        Rectangle {
                            height: 4 * 56px;
                            VerticalLayout {
                                for line[row] in root.reorderables: ListRow {
                                    min-height: 56px;
                                    max-height: 56px;
                                    opacity: reorder.dragged == row ? 0.4 : 1;
                                    reserve: Screen.phone ? 44px : 32px;
                                    title: line.title;
                                    details: line.details;
                                    covered: true;
                                    current: line.current;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                }
                            }
                            reorder := QueueReorder {
                                width: parent.width;
                                height: parent.height;
                                lines: root.reorderables;
                                row-height: 56px;
                                view-top: 0px;
                                view-bottom: root.height;
                                slot-at(lines, from, at) => {
                                    clamp(round(at), 1, lines.length) == from || clamp(round(at), 1, lines.length) == from + 1 ? -1 : clamp(round(at), 1, lines.length)
                                }
                                moved(from, slot) => { root.event = "move row " + from + " to slot " + slot; }
                            }
                        }
                    }

                    if root.current == 16: Example {
                        caption: "What plays, large: the cover, the title, the artists and the album as links, and the signal path, whose steps open from its light; on a narrow page the words go under the cover. The sound device menu opens from the button at the bottom, named beside it, with the long list of an ALSA host under the Long text switch. A phone's controls follow, then the queue's rows, the one playing coloured; a work queued whole is one row that opens to its movements";
                        NowPlaying {
                            available: root.long-text ? 400px : 900px;
                            cover: root.albums[0].cover;
                            title: root.long-text ? root.long-title : "Northern Lights";
                            movement: root.long-text ? root.long-title : "II. Andante";
                            movement-place: "2 of 3";
                            names: root.long-text ? root.many : root.mara;
                            album: { label: "Aurora", link: "album:1" };
                            quality: "High quality";
                            level: 1;
                            path: [
                                { text: "FLAC 96 kHz 24-bit", quality: 3 },
                                { text: "Resampled 96 kHz to 48 kHz", quality: 1 },
                                { text: "Shared: Default (48000 Hz 32-bit float, 2 channels)", quality: 1 },
                            ];
                            open(link) => { root.event = "open " + link; }
                        }
                        PlayerControls {
                            paused: root.player-paused;
                            position: root.player-position;
                            duration: 271;
                            waveform: root.waveform;
                            shuffled: root.player-shuffled;
                            repeat: root.player-repeat;
                            toggle-pause => { root.player-paused = !root.player-paused; }
                            previous => { root.event = "previous"; }
                            next => { root.event = "next"; }
                            seek(seconds) => { root.player-position = seconds; }
                            toggle-shuffle => { root.player-shuffled = !root.player-shuffled; }
                            cycle-repeat => { root.player-repeat = mod(root.player-repeat + 1, 3); }
                        }
                        OutputPicker {
                            output-devices: root.long-text ? root.many-devices : root.output-devices;
                            output-name: root.long-text ? "HDA Intel PCH, ALC3246 Analog (hw:CARD=PCH,DEV=0)" : "System default";
                            list-devices => { root.event = "list devices"; }
                            choose-output(index) => { root.output-device = index; }
                        }
                        VerticalLayout {
                            ListRow {
                                title: "Northern Lights";
                                details: "Mara · 4:31";
                                cover: root.albums[0].cover;
                                covered: true;
                                current: true;
                                entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                activated(id) => { root.event = id + " row 0"; }
                            }
                            ListRow {
                                title: root.long-text ? root.long-title : "Song of the Sea";
                                link: "jump";
                                details: "Mara · 3:12";
                                cover: root.albums[1].cover;
                                covered: true;
                                entries: [
                                    { id: "play", label: "Play now", icon: Icons.play },
                                    { id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true },
                                ];
                                open => { root.event = "jump to row 1"; }
                                activated(id) => { root.event = id + " row 1"; }
                            }
                            ListRow {
                                title: root.long-text ? root.long-title : "Symphony No. 5";
                                link: "jump";
                                details: "4 movements · Wiener Philharmoniker · 29:06";
                                cover: root.albums[1].cover;
                                covered: true;
                                expandable: true;
                                expanded: root.queue-work-open;
                                entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                open => { root.event = "jump to row 2"; }
                                toggled => { root.queue-work-open = !root.queue-work-open; }
                                activated(id) => { root.event = id + " row 2"; }
                            }
                            if root.queue-work-open: VerticalLayout {
                                ListRow {
                                    title: "I. Allegro con brio";
                                    link: "jump";
                                    details: "Wiener Philharmoniker · 7:21";
                                    depth: 1;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                    open => { root.event = "jump to row 3"; }
                                    activated(id) => { root.event = id + " row 3"; }
                                }
                                ListRow {
                                    title: root.long-text ? root.long-title : "II. Andante con moto";
                                    link: "jump";
                                    details: "Wiener Philharmoniker · 9:48";
                                    depth: 1;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                    open => { root.event = "jump to row 4"; }
                                    activated(id) => { root.event = id + " row 4"; }
                                }
                            }
                        }
                    }

                    if root.current == 15: Example {
                        caption: "The EQ as a graph: a point for each band, a click on it adds one, a drag moves one, and the picked band can be removed";
                        max-width: 480px;
                        graph := EqGraph {
                            points: root.eq-points;
                            grid: [
                                { position: 0.23, label: "", vertical: true },
                                { position: 0.33, label: "100", vertical: true },
                                { position: 0.66, label: "1k", vertical: true },
                                { position: 1.0, label: "10k", vertical: true },
                                { position: 0.17, label: "+10", vertical: false },
                                { position: 0.5, label: "0", vertical: false },
                                { position: 0.83, label: "−10", vertical: false },
                            ];
                            curve: "M0 500 C150 500 150 280 250 300 S400 600 550 650 S750 520 860 500 S950 500 1000 500";
                            picked-name: self.selected < 0 ? "" : "Band " + (self.selected + 1) + ", 1000 Hz, +3.5 dB";
                            added(x, y) => { root.event = "add a band at " + x + ", " + y; }
                            moved(row, x, y) => {
                                root.eq-points[row] = { x: x, y: y };
                                root.event = "move band " + (row + 1);
                            }
                            released => { root.event = "let go"; }
                            removed(row) => { root.event = "remove band " + (row + 1); }
                        }
                    }

                    if root.current == 15: Example {
                        caption: "A band of the EQ in the settings: its filter, then its numbers as typed; a pass has no gain";
                        max-width: 480px;
                        EqBandRow {
                            number: 1;
                            selected: true;
                            line: { filter: 1, frequency: "105", gain: "5.5", q: "0.7" };
                            edited(line) => { root.event = "band 1: " + line.filter + " " + line.frequency + " Hz " + line.gain + " dB Q " + line.q; }
                            remove => { root.event = "remove band 1"; }
                        }
                        EqBandRow {
                            number: 2;
                            line: { filter: 4, frequency: root.long-text ? "12345.67" : "30", gain: "0", q: "0.71" };
                            edited(line) => { root.event = "band 2: " + line.filter + " " + line.frequency + " Hz " + line.gain + " dB Q " + line.q; }
                            remove => { root.event = "remove band 2"; }
                        }
                    }
                    if root.current == 17: Example {
                        caption: "A streaming format and quality, for wifi, mobile data and later downloads; Original has no bitrate";
                        max-width: 480px;
                        QualityPicker {
                            name: "Streaming on wifi";
                            format: 0;
                            chosen(format, bitrate) => { root.event = "wifi " + format + " " + bitrate; }
                        }
                        QualityPicker {
                            name: "Streaming on mobile data";
                            format <=> root.quality-format;
                            bitrate <=> root.quality-bitrate;
                            chosen(format, bitrate) => { root.event = "mobile " + format + " " + bitrate; }
                        }
                        QualityPicker {
                            name: "Not available";
                            enabled: false;
                        }
                    }

                    if root.current == 18: Example {
                        caption: "A genre page's banner with its title over it, then the genres' wide tiles: a tile without a banner is plain text on the dark tint; resize the window to change the columns";
                        GenreBanner {
                            height: 200px;
                            picture: root.genres[0].cover;
                            name: root.genres[0].title;
                            name-size: 40px;
                        }
                        GenreGrid {
                            tiles: root.genres;
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                }
            }
        }
    }
}
