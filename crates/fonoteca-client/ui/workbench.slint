                    if root.current == 16: Example {
                        caption: "The queue's rows with a grip each, but for the song playing and the work that is open: drag one by a mouse or a finger, and the row follows as a copy with a line where it lands; the list scrolls when the pointer nears the edge of the view";
                        max-width: 640px;
                        Rectangle {
                            height: 4 * 56px;
                            VerticalLayout {
                                for line[row] in root.reorderables: ListRow {
                                    min-height: 56px;
                                    max-height: 56px;
                                    opacity: reorder.dragged == row ? 0.4 : 1;
                                    reserve: Screen.phone ? Theme.phone-target : 32px;
                                    title: line.title;
                                    details: line.details;
                                    covered: true;
                                    current: line.current;
                                    paused: root.player-paused;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                }
                            }
                            reorder := QueueReorder {
                                width: parent.width;
                                height: parent.height;
                                lines: root.reorderables;
                                row-height: 56px;
                                view-top: 0px;
                                view-bottom: root.height;
                                slot-at(lines, from, at) => {
                                    clamp(round(at), 1, lines.length) == from || clamp(round(at), 1, lines.length) == from + 1 ? -1 : clamp(round(at), 1, lines.length)
                                }
                                moved(from, slot) => { root.event = "move row " + from + " to slot " + slot; }
                            }
                        }
                    }

