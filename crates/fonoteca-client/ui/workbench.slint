                        }
                        TrackRow {
                            title: root.long-text ? root.long-title : "II. Andante con moto";
                            names: [{ label: "Mara Lind", link: "artist:1" }, { label: "Ove Strand", link: "artist:2" }];
                            duration: "9:48";
                            part: true;
                            clicked => { root.event = "play track:5"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.event = "love track:5"; }
                        }
                        TrackRow {
                            title: root.long-text ? root.long-title : "Egmont Overture, Op. 84";
                            names: [{ label: "Ludwig van Beethoven", link: "artist:8" }, { label: "Mara Lind", link: "artist:1" }];
                            split: 1;
                            duration: "8:20";
                            years: "1809 – 1810";
                            performed: "Performed Nov 1992, Concertgebouw";
                            strong: true;
                            clicked => { root.event = "play track:6"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.event = "love track:6"; }
                        }
                    }

                    if root.current == 5: Shelf {
                        title: "New albums";
                        more: true;
                        see-all => { root.event = "see all new albums"; }
                        for album in root.shelf: CoverTile {
                            cover: album.cover;
                            title: album.title;
                            names: album.names;
                            clicked => { root.event = "open " + album.link; }
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                    if root.current == 5: Shelf {
                        title: "Performers";
                        PersonTile { photo: root.photo-1; name: "Mara Lind"; role: "Vocals"; }
                        PersonTile { photo: root.photo-2; name: "Ines Varga"; role: "Piano"; }
                        PersonTile { photo: root.none; name: "Tomas Reed"; role: "Bass"; }
                    }

                    if root.current == 6: Example {
                        caption: "Swipe, drag, scroll sideways or use the buttons: it comes to rest in the grid's columns";
                        CoverShelf {
                            title: "Recently added";
                            tiles: root.grid;
                            open(link) => { root.event = "open " + link; }
                            select(index) => { root.event = "select tile " + index; }
                        }
                    }
                    if root.current == 6: Example {
                        caption: "Resize the window: tiles widen to fill a row, then move to the next";
                        CoverGrid {
                            tiles: root.grid;
                            open(link) => { root.event = "open " + link; }
                            select(index) => { root.event = "select tile " + index; }
