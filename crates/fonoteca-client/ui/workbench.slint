                            OutputPicker {
                                horizontal-stretch: 1;
                                output-devices: root.long-text ? root.many-devices : root.output-devices;
                                output-name: root.long-text ? "HDA Intel PCH, ALC3246 Analog (hw:CARD=PCH,DEV=0)" : "System default";
                                list-devices => { root.event = "list devices"; }
                                choose-output(index) => { root.output-device = index; }
                            }
                            IconButton {
                                cross-axis-self-alignment: center;
                                icon: Icons.sound;
                                label: "Sound processing";
                                clicked => { root.event = "sound settings"; }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            IconButton {
                                icon: Icons.lyrics;
                                label: "Lyrics";
                                clicked => { root.event = "lyrics"; }
                            }
                            IconButton {
                                icon: Icons.heart;
                                filled: root.loved-1;
                                color: root.loved-1 ? Theme.accent : Theme.text;
                                label: "Love Northern Lights";
                                clicked => { root.loved-1 = !root.loved-1; }
                            }
                            TrackMenu {
                                line: {
                                    title: "Northern Lights",
                                    loved: root.loved-1,
                                    album: { label: "Aurora", link: "album:1" },
                                    artists: root.mara,
                                };
                                playlists: [{ label: "Road Trip", link: "1" }, { label: "Running", link: "2" }];
                                taggable: true;
                                selectable: false;
                                open(link) => { root.event = "open " + link; }
                                toggle-love => { root.loved-1 = !root.loved-1; }
                                add-to-playlist(id) => { root.event = "add to playlist " + id; }
                                tag => { root.event = "tag"; }
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Button {
                                text: "Queue";
                                clicked => { root.event = "queue"; }
                            }
                        }
                        LyricsView {
                            available: 360px;
                            lyrics: root.long-text ? root.long-title + "\n" + root.long-title : "Let the northern lights\nShow us the way home\n\nOver the frozen sea";
                        }
                        LyricsView {
                            available: 360px;
                            note: "No lyrics for this song.";
                        }
                        // A live station: no album, no position, only play.
                        NowPlaying {
                            active: true;
                            available: root.long-text ? 280px : 360px;
                            cover: root.albums[3].cover;
                            title: root.long-text ? root.long-title : "Radio 3";
                            names: [{ label: "Live radio", link: "" }];
                        }
                        PlayerControls {
                            paused: root.player-paused;
                            live: true;
                            toggle-pause => { root.player-paused = !root.player-paused; }
                        }
                        VerticalLayout {
                            ListRow {
                                title: root.long-text ? root.long-title : "Ocean Floor";
                                link: "jump";
                                details: "Ove Strand · 3:40";
                                cover: root.albums[1].cover;
                                covered: true;
                                entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                open => { root.event = "jump to the played row"; }
                                activated(id) => { root.event = id + " played row"; }
                            }
                            ListRow {
                                title: "Northern Lights";
                                details: "Mara · 4:31";
                                cover: root.albums[0].cover;
                                covered: true;
                                current: true;
                                paused: root.player-paused;
                                entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                activated(id) => { root.event = id + " row 0"; }
                            }
                            ListRow {
                                title: root.long-text ? root.long-title : "Song of the Sea";
                                link: "jump";
                                details: "Mara · 3:12";
                                cover: root.albums[1].cover;
                                covered: true;
                                entries: [
                                    { id: "play", label: "Play now", icon: Icons.play },
                                    { id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true },
                                ];
                                open => { root.event = "jump to row 1"; }
                                activated(id) => { root.event = id + " row 1"; }
                            }
                            ListRow {
                                title: root.long-text ? root.long-title : "Symphony No. 5";
                                link: "jump";
                                details: "4 movements · Wiener Philharmoniker · 29:06";
                                cover: root.albums[1].cover;
                                covered: true;
                                expandable: true;
                                expanded: root.queue-work-open;
                                entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                open => { root.event = "jump to row 2"; }
                                toggled => { root.queue-work-open = !root.queue-work-open; }
                                activated(id) => { root.event = id + " row 2"; }
                            }
                            if root.queue-work-open: VerticalLayout {
                                ListRow {
                                    title: "I. Allegro con brio";
                                    link: "jump";
                                    details: "Wiener Philharmoniker · 7:21";
                                    depth: 1;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                    open => { root.event = "jump to row 3"; }
                                    activated(id) => { root.event = id + " row 3"; }
                                }
                                ListRow {
                                    title: root.long-text ? root.long-title : "II. Andante con moto";
                                    link: "jump";
                                    details: "Wiener Philharmoniker · 9:48";
                                    depth: 1;
                                    entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                    open => { root.event = "jump to row 4"; }
                                    activated(id) => { root.event = id + " row 4"; }
                                }
                            }
                        }
                    }

                    if root.current == 15: Example {
                        caption: "The EQ as a graph: a point for each band, a click on it adds one, a drag moves one, and the picked band can be removed";
                        max-width: 480px;
                        graph := EqGraph {
                            points: root.eq-points;
                            grid: [
                                { position: 0.23, label: "", vertical: true },
                                { position: 0.33, label: "100", vertical: true },
                                { position: 0.66, label: "1k", vertical: true },
                                { position: 1.0, label: "10k", vertical: true },
                                { position: 0.17, label: "+10", vertical: false },
                                { position: 0.5, label: "0", vertical: false },
                                { position: 0.83, label: "−10", vertical: false },
                            ];
                            curve: "M0 500 C150 500 150 280 250 300 S400 600 550 650 S750 520 860 500 S950 500 1000 500";
                            picked-name: self.selected < 0 ? "" : "Band " + (self.selected + 1) + ", 1000 Hz, +3.5 dB";
                            added(x, y) => { root.event = "add a band at " + x + ", " + y; }
                            moved(row, x, y) => {
                                root.eq-points[row] = { x: x, y: y };
                                root.event = "move band " + (row + 1);
                            }
                            released => { root.event = "let go"; }
                            removed(row) => { root.event = "remove band " + (row + 1); }
                        }
                    }

                    if root.current == 15: Example {
                        caption: "A band of the EQ in the settings: its filter, then its numbers as typed; a pass has no gain";
                        max-width: 480px;
                        EqBandRow {
                            number: 1;
                            selected: true;
                            line: { filter: 1, frequency: "105", gain: "5.5", q: "0.7" };
                            edited(line) => { root.event = "band 1: " + line.filter + " " + line.frequency + " Hz " + line.gain + " dB Q " + line.q; }
                            remove => { root.event = "remove band 1"; }
                        }
                        EqBandRow {
                            number: 2;
                            line: { filter: 4, frequency: root.long-text ? "12345.67" : "30", gain: "0", q: "0.71" };
                            edited(line) => { root.event = "band 2: " + line.filter + " " + line.frequency + " Hz " + line.gain + " dB Q " + line.q; }
                            remove => { root.event = "remove band 2"; }
                        }
                    }
                    if root.current == 17: Example {
                        caption: "A streaming format and quality, for wifi, mobile data and later downloads; Original has no bitrate";
                        max-width: 480px;
                        QualityPicker {
                            name: "Streaming on wifi";
                            format: 0;
                            chosen(format, bitrate) => { root.event = "wifi " + format + " " + bitrate; }
                        }
                        QualityPicker {
                            name: "Streaming on mobile data";
                            format <=> root.quality-format;
                            bitrate <=> root.quality-bitrate;
                            chosen(format, bitrate) => { root.event = "mobile " + format + " " + bitrate; }
                        }
                        QualityPicker {
                            name: "Not available";
                            enabled: false;
                        }
                    }

                    if root.current == 18: Example {
                        caption: "A genre page's banner with its title over it, then the genres' wide tiles: a tile without a banner is plain text on the dark tint; resize the window to change the columns";
                        GenreBanner {
                            height: 200px;
                            picture: root.genres[0].cover;
                            name: root.genres[0].title;
                            name-size: 40px;
                        }
                        GenreGrid {
                            tiles: root.genres;
                            open(link) => { root.event = "open " + link; }
                        }
                    }

                    if root.current == 19: Example {
                        caption: "A phone's navigation along the bottom: the current entry lit like the sidebar's";
                        BottomBar {
                            entries: [
                                { title: "Home", icon: Icons.home },
                                { title: "Browse", icon: Icons.genre },
                                { title: "Library", icon: Icons.album },
                                { title: "Settings", icon: Icons.settings },
                            ];
                            current: root.bar-current;
                            selected(index) => {
                                root.bar-current = index;
                                root.event = "bar " + index;
                            }
                        }
                    }

                    if root.current == 20: Example {
                        caption: "The user's most played on ListenBrainz: a period to pick, and a ranking each of albums, artists and genres; a place in the library opens its page, the others have no link; three columns when three rows fit across, else two with the genres below, else one slide at a time with arrows and dots";
                        ListeningStats {
                            periods: ["This week", "This month", "This year", "All time"];
                            period: root.stat-period;
                            lists: [
                                {
                                    title: "Top albums",
                                    pictured: true,
                                    entries: [
                                        { rank: 1, title: root.long-text ? root.long-title : "Night Harbour", detail: "Mara Lind", plays: "480 plays", picture: root.no-art ? root.none : @image-url("samples/cover-1.svg"), link: "album:1" },
                                        { rank: 2, title: "Onwards System", detail: "Cell", plays: "452 plays", picture: root.none },
                                        { rank: 3, title: "Seeker", detail: "Carbon Based Lifeforms", plays: "1 play", picture: root.none },
                                    ],
                                },
                                {
                                    title: "Top artists",
                                    pictured: true,
                                    round: true,
                                    entries: [
                                        { rank: 1, title: "Mara Lind", plays: "1569 plays", picture: root.no-art ? root.none : @image-url("samples/photo-1.svg"), link: "artist:1" },
                                        { rank: 2, title: "Röyksopp", plays: "859 plays", picture: root.none },
                                    ],
                                },
                                {
                                    title: "Top genres",
                                    note: "ListenBrainz hasn't worked this out yet.",
                                    entries: [
                                        { rank: 1, title: "Ambient", plays: "1234 plays" },
                                        { rank: 2, title: "Electronic", plays: "987 plays" },
                                        { rank: 3, title: "Shoegaze", plays: "654 plays" },
                                        { rank: 4, title: "Folk", plays: "321 plays" },
                                        { rank: 5, title: "Jazz", plays: "210 plays" },
                                    ],
                                },
                            ];
                            period-picked(index) => {
                                root.stat-period = index;
                                root.event = "period " + index;
                            }
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                }
            }
        }
    }
}
