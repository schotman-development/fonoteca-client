// Every shared component on its own, with sample data and switches for the
// cases that break layouts. Run with `cargo run --bin workbench`.

import { CheckBox, ComboBox, Palette, ScrollView } from "std-widgets.slint";
import { AlbumTile, Artwork, CoverGrid, CoverShelf, CoverTile, EqBandRow, DownloadButton, EqGraph, EqPoint, GenreBanner, GenreGrid, IconButton, Icons, Link, Links, LinksLine, ListRow, MenuEntry, Name, NowPlaying, OutputPicker, PageHeader, PlayerControls, PathStep, PersonTile, PlayButton, PlayerBar, QualityPicker, QueueLine, QueueReorder, Screen, SelectionBar, SettingsRow, Shelf, Sidebar, Theme, TopBar, TrackColumn, TrackHeader, TrackLine, TrackLineRow, TrackRow } from "components.slint";

component Example inherits VerticalLayout {
    in property <string> caption;
    spacing: 12px;
    Text {
        text: root.caption;
        font-size: Theme.small;
        color: Theme.muted;
        wrap: word-wrap;
    }
    @children
}

export component Workbench inherits Window {
    title: "Fonoteca workbench";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Palette.background;

    changed width => { Screen.width = self.width; }
    changed height => { Screen.height = self.height; }
    init => {
        Screen.width = self.width;
        Screen.height = self.height;
    }

    // The graph's points, which dragging moves.
    property <[EqPoint]> eq-points: [{ x: 0.2, y: 0.3 }, { x: 0.55, y: 0.65 }, { x: 0.86, y: 0.5 }];
    property <[string]> entries: [
        "Artwork",
        "Links",
        "Cover tile",
        "Person tile",
        "Track row",
        "Shelf",
        "Cover grid and shelf",
        "Page header",
        "Sidebar",
        "Top bar",
        "Icon button",
        "Selection bar",
        "Track table",
        "List row",
        "Player bar",
        "EQ band",
        "Now playing",
        "Quality picker",
        "Genre tiles and banner",
    ];
    property <int> current;
    property <bool> long-text;
    property <bool> no-art;
    property <string> event;

    property <image> none;
    property <bool> player-paused;
    property <float> player-position: 42;
    property <string> waveform: "M0.20 0.418h0.6v0.164h-0.6zM1.20 0.410h0.6v0.180h-0.6zM2.20 0.371h0.6v0.257h-0.6zM3.20 0.375h0.6v0.251h-0.6zM4.20 0.368h0.6v0.264h-0.6zM5.20 0.316h0.6v0.368h-0.6zM6.20 0.234h0.6v0.532h-0.6zM7.20 0.227h0.6v0.545h-0.6zM8.20 0.212h0.6v0.576h-0.6zM9.20 0.277h0.6v0.446h-0.6zM10.20 0.212h0.6v0.576h-0.6zM11.20 0.241h0.6v0.517h-0.6zM12.20 0.248h0.6v0.504h-0.6zM13.20 0.250h0.6v0.500h-0.6zM14.20 0.220h0.6v0.561h-0.6zM15.20 0.067h0.6v0.866h-0.6zM16.20 0.075h0.6v0.850h-0.6zM17.20 0.070h0.6v0.860h-0.6zM18.20 0.063h0.6v0.874h-0.6zM19.20 0.189h0.6v0.621h-0.6zM20.20 0.160h0.6v0.680h-0.6zM21.20 0.086h0.6v0.828h-0.6zM22.20 0.061h0.6v0.879h-0.6zM23.20 0.033h0.6v0.934h-0.6zM24.20 0.028h0.6v0.943h-0.6zM25.20 0.208h0.6v0.584h-0.6zM26.20 0.097h0.6v0.807h-0.6zM27.20 0.088h0.6v0.825h-0.6zM28.20 0.130h0.6v0.739h-0.6zM29.20 0.207h0.6v0.586h-0.6zM30.20 0.154h0.6v0.692h-0.6zM31.20 0.240h0.6v0.520h-0.6zM32.20 0.087h0.6v0.826h-0.6zM33.20 0.115h0.6v0.769h-0.6zM34.20 0.188h0.6v0.624h-0.6zM35.20 0.244h0.6v0.511h-0.6zM36.20 0.162h0.6v0.677h-0.6zM37.20 0.232h0.6v0.536h-0.6zM38.20 0.207h0.6v0.587h-0.6zM39.20 0.233h0.6v0.534h-0.6zM40.20 0.295h0.6v0.410h-0.6zM41.20 0.324h0.6v0.351h-0.6zM42.20 0.325h0.6v0.350h-0.6zM43.20 0.360h0.6v0.280h-0.6zM44.20 0.399h0.6v0.203h-0.6zM45.20 0.406h0.6v0.188h-0.6zM46.20 0.373h0.6v0.255h-0.6zM47.20 0.406h0.6v0.188h-0.6zM48.20 0.391h0.6v0.218h-0.6zM49.20 0.320h0.6v0.359h-0.6zM50.20 0.337h0.6v0.326h-0.6zM51.20 0.290h0.6v0.419h-0.6zM52.20 0.280h0.6v0.440h-0.6zM53.20 0.280h0.6v0.439h-0.6zM54.20 0.167h0.6v0.667h-0.6zM55.20 0.274h0.6v0.453h-0.6zM56.20 0.224h0.6v0.551h-0.6zM57.20 0.248h0.6v0.505h-0.6zM58.20 0.157h0.6v0.686h-0.6zM59.20 0.212h0.6v0.576h-0.6zM60.20 0.186h0.6v0.627h-0.6zM61.20 0.097h0.6v0.806h-0.6zM62.20 0.176h0.6v0.647h-0.6zM63.20 0.118h0.6v0.763h-0.6zM64.20 0.036h0.6v0.927h-0.6zM65.20 0.208h0.6v0.585h-0.6zM66.20 0.214h0.6v0.573h-0.6zM67.20 0.174h0.6v0.651h-0.6zM68.20 0.053h0.6v0.894h-0.6zM69.20 0.087h0.6v0.826h-0.6zM70.20 0.174h0.6v0.653h-0.6zM71.20 0.155h0.6v0.689h-0.6zM72.20 0.193h0.6v0.614h-0.6zM73.20 0.137h0.6v0.725h-0.6zM74.20 0.232h0.6v0.535h-0.6zM75.20 0.103h0.6v0.793h-0.6zM76.20 0.074h0.6v0.851h-0.6zM77.20 0.076h0.6v0.847h-0.6zM78.20 0.133h0.6v0.734h-0.6zM79.20 0.107h0.6v0.785h-0.6zM80.20 0.287h0.6v0.426h-0.6zM81.20 0.254h0.6v0.493h-0.6zM82.20 0.164h0.6v0.673h-0.6zM83.20 0.212h0.6v0.575h-0.6zM84.20 0.282h0.6v0.437h-0.6zM85.20 0.233h0.6v0.534h-0.6zM86.20 0.293h0.6v0.414h-0.6zM87.20 0.293h0.6v0.413h-0.6zM88.20 0.364h0.6v0.273h-0.6zM89.20 0.389h0.6v0.222h-0.6zM90.20 0.389h0.6v0.223h-0.6zM91.20 0.422h0.6v0.156h-0.6zM92.20 0.389h0.6v0.221h-0.6zM93.20 0.324h0.6v0.352h-0.6zM94.20 0.357h0.6v0.286h-0.6zM95.20 0.373h0.6v0.255h-0.6zM96.20 0.355h0.6v0.290h-0.6zM97.20 0.326h0.6v0.349h-0.6zM98.20 0.228h0.6v0.544h-0.6zM99.20 0.269h0.6v0.462h-0.6z";
    property <bool> player-shuffled;
    property <int> player-repeat;
    property <bool> queue-work-open;
    property <[QueueLine]> reorderables: [
        { title: "Northern Lights", details: "Mara · 4:31", current: true },
        { title: "Song of the Sea", details: "Mara · 3:12" },
        { title: "Symphony No. 5", details: "4 movements · 29:06", work: true },
        { title: "Harbour Lights", details: "Ove Strand · 5:02" },
    ];
    property <int> quality-format: 1;
    property <int> quality-bitrate: 2;
    property <int> output-device;
    property <[MenuEntry]> output-devices: [
        { id: "0", label: "System default", icon: root.output-device == 0 ? Icons.check : Icons.blank },
        { id: "1", label: "USB DAC", detail: "hw:CARD=DAC,DEV=0", icon: root.output-device == 1 ? Icons.check : Icons.blank },
        { id: "2", label: "Built-in Audio Analog Stereo", detail: "hw:CARD=PCH,DEV=0", icon: root.output-device == 2 ? Icons.check : Icons.blank },
    ];
    // What a laptop's ALSA lists: every card again as hw, plughw, dmix and so on.
    property <[MenuEntry]> many-devices: [
        { id: "0", label: "System default", icon: Icons.check },
        { id: "1", label: "HDA Intel PCH, ALC3246 Analog", detail: "hw:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "2", label: "HDA Intel PCH, ALC3246 Analog", detail: "plughw:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "3", label: "HDA Intel PCH, ALC3246 Analog", detail: "sysdefault:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "4", label: "HDA Intel PCH, ALC3246 Analog", detail: "front:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "5", label: "HDA Intel PCH, ALC3246 Analog", detail: "surround40:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "6", label: "HDA Intel PCH, ALC3246 Analog", detail: "iec958:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "7", label: "HDA Intel PCH, ALC3246 Analog", detail: "dmix:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "8", label: "HDA Intel PCH, ALC3246 Analog", detail: "dsnoop:CARD=PCH,DEV=0", icon: Icons.blank },
        { id: "9", label: "USB Audio DAC, USB Audio", detail: "hw:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "10", label: "USB Audio DAC, USB Audio", detail: "plughw:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "11", label: "USB Audio DAC, USB Audio", detail: "sysdefault:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "12", label: "USB Audio DAC, USB Audio", detail: "front:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "13", label: "USB Audio DAC, USB Audio", detail: "surround40:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "14", label: "USB Audio DAC, USB Audio", detail: "iec958:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "15", label: "USB Audio DAC, USB Audio", detail: "dmix:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "16", label: "USB Audio DAC, USB Audio", detail: "dsnoop:CARD=DAC,DEV=0", icon: Icons.blank },
        { id: "17", label: "HDA NVidia, HDMI 0", detail: "hw:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "18", label: "HDA NVidia, HDMI 0", detail: "plughw:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "19", label: "HDA NVidia, HDMI 0", detail: "sysdefault:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "20", label: "HDA NVidia, HDMI 0", detail: "front:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "21", label: "HDA NVidia, HDMI 0", detail: "surround40:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "22", label: "HDA NVidia, HDMI 0", detail: "iec958:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "23", label: "HDA NVidia, HDMI 0", detail: "dmix:CARD=HDMI,DEV=0", icon: Icons.blank },
        { id: "24", label: "HDA NVidia, HDMI 0", detail: "dsnoop:CARD=HDMI,DEV=0", icon: Icons.blank },
    ];
    property <string> long-title: "An unusually long title that keeps going, to show where text wraps and where it is cut short";
    property <[Name]> many: [
        { label: "Mara Lind", link: "artist:1" },
        { label: "Tomas Reed", link: "artist:4" },
        { label: "Ines Varga", link: "artist:3" },
        { label: "Kolibri Ensemble", link: "artist:5" },
        { label: "The Pale Orchard", link: "artist:2" },
        { label: "Oskar Brandt-Falkenberg", link: "artist:6" },
        { label: "Noor Haddad", link: "artist:7" },
        { label: "Session strings", link: "" },
    ];
    property <[Name]> mara: [{ label: "Mara Lind", link: "artist:1" }];
    property <[Name]> credits: root.long-text ? root.many : [
        { label: "Mara Lind", link: "artist:1" },
        { label: "Tomas Reed", link: "artist:4" },
        { label: "Session strings", link: "" },
    ];
    property <[AlbumTile]> albums: [
        {
            title: root.long-text ? root.long-title : "Night Harbour",
            names: root.long-text ? root.many : root.mara,
            cover: root.no-art ? root.none : @image-url("samples/cover-1.svg"),
            link: "album:1",
        },
        {
            title: "Tall Windows",
            names: [{ label: "The Pale Orchard", link: "artist:2" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-2.svg"),
            link: "album:2",
        },
        {
            title: "Low Country",
            names: [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-3.svg"),
            link: "album:3",
        },
        {
            title: "Triangle Songs",
            names: [{ label: "Kolibri Ensemble", link: "artist:5" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-4.svg"),
            link: "album:4",
        },
    ];
    property <[AlbumTile]> shelf: [
        root.albums[0], root.albums[1], root.albums[2], root.albums[3],
        root.albums[1], root.albums[3], root.albums[0], root.albums[2],
    ];
    property <[AlbumTile]> grid: [
        root.albums[0], root.albums[1], root.albums[2], root.albums[3],
        root.albums[2], root.albums[0], root.albums[3], root.albums[1],
        root.albums[3], root.albums[2], root.albums[1], root.albums[0],
    ];
    property <[AlbumTile]> genres: [
        { title: root.long-text ? root.long-title : "Jazz", names: [{ label: "42 albums", link: "" }], cover: root.no-art ? root.none : @image-url("samples/banner-1.svg"), link: "genre:Jazz" },
        { title: "Classical", names: [{ label: "120 albums", link: "" }], cover: root.no-art ? root.none : @image-url("samples/banner-2.svg"), link: "genre:Classical" },
        { title: "Folk", names: [{ label: "1 album", link: "" }], link: "genre:Folk" },
        { title: "Hip-hop", names: [{ label: "3 albums", link: "" }], cover: root.no-art ? root.none : @image-url("samples/banner-2.svg"), link: "genre:Hip-hop" },
        { title: "Blues", names: [{ label: "9 albums", link: "" }], cover: root.no-art ? root.none : @image-url("samples/banner-1.svg"), link: "genre:Blues" },
    ];
    property <image> photo-1: root.no-art ? root.none : @image-url("samples/photo-1.svg");
    property <image> photo-2: root.no-art ? root.none : @image-url("samples/photo-2.svg");
    property <bool> loved-1;
    property <bool> down;
    property <bool> loved-2: true;
    property <bool> loved-3;
    property <bool> loved-album;
    property <int> download-state: 1;
    property <[TrackColumn]> table-columns: [
        { title: "Cover", width: 42px, least: 42px, cover: true },
        { title: "Title", width: 240px, least: 144px, stretch: true },
        { title: "Artists", width: 180px, least: 108px },
        { title: "Album", width: 200px, least: 120px },
        { title: "Year", width: 56px, least: 56px, sorted: true, descending: root.long-text },
        { title: "Duration", width: 72px, least: 72px },
        { title: "Loved", width: 40px, least: 40px, heart: true },
    ];
    property <bool> picked-1;
    property <bool> picked-2;
    property <bool> picked-3;
    property <[TrackLine]> table-lines: [
        {
            cells: [
                [],
                [{ label: root.long-text ? root.long-title : "Harbour Lights", link: "" }],
                root.long-text ? root.many : root.mara,
                [{ label: root.long-text ? root.long-title : "Night Harbour", link: "album:1" }],
                [{ label: "2021", link: "" }],
                [{ label: "4:12", link: "" }],
                [],
            ],
            loved: root.loved-1,
            selected: root.picked-1,
            album: { label: "Night Harbour", link: "album:1" },
            artists: root.mara,
            cover: root.no-art ? root.none : @image-url("samples/cover-1.svg"),
        },
        {
            cells: [
                [],
                [{ label: "Rope and Anchor", link: "" }],
                [{ label: "Session strings", link: "" }],
                [],
                [],
                [{ label: "3:38", link: "" }],
                [],
            ],
            loved: root.loved-2,
            selected: root.picked-2,
        },
        {
            cells: [
                [],
                [{ label: "Low Tide", link: "" }],
                [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
                [{ label: "Low Country", link: "album:3" }],
                [{ label: "2019", link: "" }],
                [{ label: "1:02:05", link: "" }],
                [],
            ],
            loved: root.loved-3,
            selected: root.picked-3,
            album: { label: "Low Country", link: "album:3" },
            artists: [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-3.svg"),
        },
    ];

    HorizontalLayout {
        Sidebar {
            width: 240px;
            items: root.entries;
            current <=> root.current;
        }
        VerticalLayout {
            FlexboxLayout {
                padding: 12px;
                spacing: 16px;
                cross-axis-alignment: center;
                CheckBox {
                    text: "Long text";
                    checked <=> root.long-text;
                }
                CheckBox {
                    text: "No artwork";
                    checked <=> root.no-art;
                }
                ComboBox {
                    model: ["Follow the system", "Light", "Dark"];
                    selected => {
                        Palette.color-scheme = self.current-index == 1 ? ColorScheme.light : self.current-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
                    }
                }
                Text {
                    text: root.event == "" ? "Events show here." : "Event: " + root.event;
                    color: Theme.muted;
                }
            }
            scroll := ScrollView {
                content-width: self.visible-width;
                content-height: stage.preferred-height;
                stage := VerticalLayout {
                    width: scroll.visible-width;
                    padding: 24px;
                    spacing: 32px;
                    alignment: start;

                    if root.current == 0: Example {
                        caption: "Square for covers, round for people; drawn when there is no image";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            Artwork { source: root.albums[0].cover; }
                            Artwork { source: root.none; }
                            Artwork { round: true; source: root.photo-1; }
                            Artwork { round: true; source: root.none; }
                        }
                    }
                    if root.current == 0: Example {
                        caption: "Any size";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: end;
                            Artwork { size: 48px; source: root.albums[1].cover; }
                            Artwork { size: 96px; source: root.albums[1].cover; }
                            Artwork { size: 220px; source: root.albums[1].cover; }
                        }
                    }

                    if root.current == 1: Example {
                        caption: "Link";
                        HorizontalLayout {
                            alignment: start;
                            Link {
                                text: "Mara Lind";
                                clicked => { root.event = "open artist:1"; }
                            }
                        }
                    }
                    if root.current == 1: Example {
                        caption: "Links that wrap; a name without a page isn't clickable";
                        Links {
                            names: root.credits;
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                    if root.current == 1: Example {
                        caption: "Links on one line, 220px wide: names that don't fit are left out";
                        LinksLine {
                            width: 220px;
                            names: root.credits;
                            open(link) => { root.event = "open " + link; }
                        }
                    }

                    if root.current == 2: Example {
                        caption: "Click the cover or the title for the album, a name for the artist";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for album[i] in root.albums: CoverTile {
                                cover: album.cover;
                                title: album.title;
                                names: album.names;
                                downloadable: true;
                                downloaded: i == 1;
                                clicked => { root.event = "open " + album.link; }
                                activated(id) => { root.event = id + " " + album.link; }
                                context-clicked => { root.event = "select " + album.link; }
                                open(link) => { root.event = "open " + link; }
                            }
                        }
                    }
                    if root.current == 2: Example {
                        caption: "Round, for artists; the first selected";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for i in 3: CoverTile {
                                round: true;
                                cover: i == 0 ? root.photo-1 : i == 1 ? root.photo-2 : root.none;
                                title: i == 0 && root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : i == 0 ? "Mara Lind" : i == 1 ? "Ines Varga" : "Tomas Reed";
                                names: [{ label: i == 0 ? "6 albums" : "1 album", link: "" }];
                                selecting: i == 0;
                                selected: i == 0;
                                downloaded: i == 0;
                                clicked => { root.event = "open artist:" + i; }
                                context-clicked => { root.event = "select artist:" + i; }
                            }
                        }
                    }
                    if root.current == 2: Example {
                        caption: "While selecting: the first selected, the others not";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for album[i] in root.albums: CoverTile {
                                cover: album.cover;
                                title: album.title;
                                names: album.names;
                                selecting: true;
                                selected: i == 0;
                                clicked => { root.event = "select " + album.link; }
                                context-clicked => { root.event = "select " + album.link; }
                                open(link) => { root.event = "select " + album.link; }
                            }
                        }
                    }

                    if root.current == 3: Example {
                        caption: "With and without a role";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            PersonTile {
                                photo: root.photo-1;
                                name: root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : "Mara Lind";
                                role: "Vocals, guitar";
                                clicked => { root.event = "open artist:1"; }
                            }
                            PersonTile {
                                photo: root.photo-2;
                                name: "Ines Varga";
                                role: "Composer";
