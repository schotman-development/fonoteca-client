// Every shared component on its own, with sample data and switches for the
// cases that break layouts. Run with `cargo run --bin workbench`.

import { CheckBox, ComboBox, Palette, ScrollView } from "std-widgets.slint";
import { AlbumTile, Artwork, CoverGrid, CoverShelf, CoverTile, IconButton, Icons, Link, Links, LinksLine, Name, PageHeader, PersonTile, SelectionBar, Shelf, Sidebar, Theme, TopBar, TrackColumn, TrackHeader, TrackLine, TrackLineRow, TrackRow } from "components.slint";

component Example inherits VerticalLayout {
    in property <string> caption;
    spacing: 12px;
    Text {
        text: root.caption;
        font-size: Theme.small;
        color: Theme.muted;
        wrap: word-wrap;
    }
    @children
}

export component Workbench inherits Window {
    title: "Fonoteca workbench";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Palette.background;

    property <[string]> entries: [
        "Artwork",
        "Links",
        "Cover tile",
        "Person tile",
        "Track row",
        "Shelf",
        "Cover grid and shelf",
        "Page header",
        "Sidebar",
        "Top bar",
        "Icon button",
        "Selection bar",
        "Track table",
    ];
    property <int> current;
    property <bool> long-text;
    property <bool> no-art;
    property <string> event;

    property <image> none;
    property <string> long-title: "An unusually long title that keeps going, to show where text wraps and where it is cut short";
    property <[Name]> many: [
        { label: "Mara Lind", link: "artist:1" },
        { label: "Tomas Reed", link: "artist:4" },
        { label: "Ines Varga", link: "artist:3" },
        { label: "Kolibri Ensemble", link: "artist:5" },
        { label: "The Pale Orchard", link: "artist:2" },
        { label: "Oskar Brandt-Falkenberg", link: "artist:6" },
        { label: "Noor Haddad", link: "artist:7" },
        { label: "Session strings", link: "" },
    ];
    property <[Name]> mara: [{ label: "Mara Lind", link: "artist:1" }];
    property <[Name]> credits: root.long-text ? root.many : [
        { label: "Mara Lind", link: "artist:1" },
        { label: "Tomas Reed", link: "artist:4" },
        { label: "Session strings", link: "" },
    ];
    property <[AlbumTile]> albums: [
        {
            title: root.long-text ? root.long-title : "Night Harbour",
            names: root.long-text ? root.many : root.mara,
            cover: root.no-art ? root.none : @image-url("samples/cover-1.svg"),
            link: "album:1",
        },
        {
            title: "Tall Windows",
            names: [{ label: "The Pale Orchard", link: "artist:2" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-2.svg"),
            link: "album:2",
        },
        {
            title: "Low Country",
            names: [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-3.svg"),
            link: "album:3",
        },
        {
            title: "Triangle Songs",
            names: [{ label: "Kolibri Ensemble", link: "artist:5" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-4.svg"),
            link: "album:4",
        },
    ];
    property <[AlbumTile]> shelf: [
        root.albums[0], root.albums[1], root.albums[2], root.albums[3],
        root.albums[1], root.albums[3], root.albums[0], root.albums[2],
    ];
    property <[AlbumTile]> grid: [
        root.albums[0], root.albums[1], root.albums[2], root.albums[3],
        root.albums[2], root.albums[0], root.albums[3], root.albums[1],
        root.albums[3], root.albums[2], root.albums[1], root.albums[0],
    ];
    property <image> photo-1: root.no-art ? root.none : @image-url("samples/photo-1.svg");
    property <image> photo-2: root.no-art ? root.none : @image-url("samples/photo-2.svg");
    property <bool> loved-1;
    property <bool> down;
    property <bool> loved-2: true;
    property <bool> loved-3;
    property <bool> loved-album;
    property <[TrackColumn]> table-columns: [
        { title: "Cover", width: 42px, cover: true },
        { title: "Title", width: 240px, stretch: true },
        { title: "Artists", width: 180px },
        { title: "Album", width: 200px },
        { title: "Year", width: 56px, sorted: true, descending: root.long-text },
        { title: "Duration", width: 72px },
        { title: "Loved", width: 40px, heart: true },
    ];
    property <bool> picked-1;
    property <bool> picked-2;
    property <bool> picked-3;
    property <[TrackLine]> table-lines: [
        {
            cells: [
                [],
                [{ label: root.long-text ? root.long-title : "Harbour Lights", link: "" }],
                root.long-text ? root.many : root.mara,
                [{ label: root.long-text ? root.long-title : "Night Harbour", link: "album:1" }],
                [{ label: "2021", link: "" }],
                [{ label: "4:12", link: "" }],
                [],
            ],
            loved: root.loved-1,
            selected: root.picked-1,
            album: { label: "Night Harbour", link: "album:1" },
            artists: root.mara,
            cover: root.no-art ? root.none : @image-url("samples/cover-1.svg"),
        },
        {
            cells: [
                [],
                [{ label: "Rope and Anchor", link: "" }],
                [{ label: "Session strings", link: "" }],
                [],
                [],
                [{ label: "3:38", link: "" }],
                [],
            ],
            loved: root.loved-2,
            selected: root.picked-2,
        },
        {
            cells: [
                [],
                [{ label: "Low Tide", link: "" }],
                [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
                [{ label: "Low Country", link: "album:3" }],
                [{ label: "2019", link: "" }],
                [{ label: "1:02:05", link: "" }],
                [],
            ],
            loved: root.loved-3,
            selected: root.picked-3,
            album: { label: "Low Country", link: "album:3" },
            artists: [{ label: "Ines Varga", link: "artist:3" }, { label: "Tomas Reed", link: "artist:4" }],
            cover: root.no-art ? root.none : @image-url("samples/cover-3.svg"),
        },
    ];

    HorizontalLayout {
        Sidebar {
            width: 160px;
            items: root.entries;
            current <=> root.current;
        }
        VerticalLayout {
            FlexboxLayout {
                padding: 12px;
                spacing: 16px;
                cross-axis-alignment: center;
                CheckBox {
                    text: "Long text";
                    checked <=> root.long-text;
                }
                CheckBox {
                    text: "No artwork";
                    checked <=> root.no-art;
                }
                ComboBox {
                    model: ["Follow the system", "Light", "Dark"];
                    selected => {
                        Palette.color-scheme = self.current-index == 1 ? ColorScheme.light : self.current-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
                    }
                }
                Text {
                    text: root.event == "" ? "Events show here." : "Event: " + root.event;
                    color: Theme.muted;
                }
            }
            scroll := ScrollView {
                content-width: self.visible-width;
                content-height: stage.preferred-height;
                stage := VerticalLayout {
                    width: scroll.visible-width;
                    padding: 24px;
                    spacing: 32px;
                    alignment: start;

                    if root.current == 0: Example {
                        caption: "Square for covers, round for people; drawn when there is no image";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            Artwork { source: root.albums[0].cover; }
                            Artwork { source: root.none; }
                            Artwork { round: true; source: root.photo-1; }
                            Artwork { round: true; source: root.none; }
                        }
                    }
                    if root.current == 0: Example {
                        caption: "Any size";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: end;
                            Artwork { size: 48px; source: root.albums[1].cover; }
                            Artwork { size: 96px; source: root.albums[1].cover; }
                            Artwork { size: 220px; source: root.albums[1].cover; }
                        }
                    }

                    if root.current == 1: Example {
                        caption: "Link";
                        HorizontalLayout {
                            alignment: start;
                            Link {
                                text: "Mara Lind";
                                clicked => { root.event = "open artist:1"; }
                            }
                        }
                    }
                    if root.current == 1: Example {
                        caption: "Links that wrap; a name without a page isn't clickable";
                        Links {
                            names: root.credits;
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                    if root.current == 1: Example {
                        caption: "Links on one line, 220px wide: names that don't fit are left out";
                        LinksLine {
                            width: 220px;
                            names: root.credits;
                            open(link) => { root.event = "open " + link; }
                        }
                    }

                    if root.current == 2: Example {
                        caption: "Click the cover or the title for the album, a name for the artist";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for album in root.albums: CoverTile {
                                cover: album.cover;
                                title: album.title;
                                names: album.names;
                                clicked => { root.event = "open " + album.link; }
                                context-clicked => { root.event = "select " + album.link; }
                                open(link) => { root.event = "open " + link; }
                            }
                        }
                    }
                    if root.current == 2: Example {
                        caption: "Round, for artists; the first selected";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for i in 3: CoverTile {
                                round: true;
                                cover: i == 0 ? root.photo-1 : i == 1 ? root.photo-2 : root.none;
                                title: i == 0 && root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : i == 0 ? "Mara Lind" : i == 1 ? "Ines Varga" : "Tomas Reed";
                                names: [{ label: i == 0 ? "6 albums" : "1 album", link: "" }];
                                selecting: i == 0;
                                selected: i == 0;
                                clicked => { root.event = "open artist:" + i; }
                                context-clicked => { root.event = "select artist:" + i; }
                            }
                        }
                    }
                    if root.current == 2: Example {
                        caption: "While selecting: the first selected, the others not";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            for album[i] in root.albums: CoverTile {
                                cover: album.cover;
                                title: album.title;
                                names: album.names;
                                selecting: true;
                                selected: i == 0;
                                clicked => { root.event = "select " + album.link; }
                                context-clicked => { root.event = "select " + album.link; }
                                open(link) => { root.event = "select " + album.link; }
                            }
                        }
                    }

                    if root.current == 3: Example {
                        caption: "With and without a role";
                        FlexboxLayout {
                            spacing: Theme.gap;
                            cross-axis-alignment: start;
                            PersonTile {
                                photo: root.photo-1;
                                name: root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : "Mara Lind";
                                role: "Vocals, guitar";
                                clicked => { root.event = "open artist:1"; }
                            }
                            PersonTile {
                                photo: root.photo-2;
                                name: "Ines Varga";
                                role: "Composer";
                                clicked => { root.event = "open artist:3"; }
                            }
                            PersonTile {
                                photo: root.none;
                                name: "Tomas Reed";
                                clicked => { root.event = "open artist:4"; }
                            }
                        }
                    }

                    if root.current == 4: Example {
                        caption: "Click a row, a name or the heart";
                        TrackRow {
                            title: "Harbour Lights";
                            names: root.mara;
                            duration: "4:12";
                            loved: root.loved-1;
                            clicked => { root.event = "play track:1"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.loved-1 = !root.loved-1; }
                        }
                        TrackRow {
                            title: root.long-text ? root.long-title : "Rope and Anchor";
                            names: root.credits;
                            duration: "3:48";
                            loved: root.loved-2;
                            clicked => { root.event = "play track:2"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.loved-2 = !root.loved-2; }
                        }
                        TrackRow {
                            title: "Inland";
                            duration: "11:27";
                            loved: root.loved-3;
                            clicked => { root.event = "play track:3"; }
                            toggle-love => { root.loved-3 = !root.loved-3; }
                        }
                    }

                    if root.current == 4: Example {
                        caption: "A work's row over its movements, and a work on one track, as on a classical album";
                        TrackRow {
                            title: root.long-text ? root.long-title : "Symphony No. 5 in C minor, Op. 67";
                            names: root.long-text ? root.many : [{ label: "Ludwig van Beethoven", link: "artist:8" }, { label: "Mara Lind", link: "artist:1" }];
                            split: root.long-text ? 3 : 1;
                            duration: "17:09";
                            years: "1804 – 1808";
                            performed: root.long-text ? "Performed " + root.long-title : "Performed 30 Mar 2006 – 31 Oct 2006, Teldex Studio Berlin";
                            lovable: false;
                            strong: true;
                            clicked => { root.event = "play work:5"; }
                            open(link) => { root.event = "open " + link; }
                        }
                        TrackRow {
                            title: "I. Allegro con brio";
                            duration: "7:21";
                            part: true;
                            clicked => { root.event = "play track:4"; }
                            toggle-love => { root.event = "love track:4"; }
                        }
                        TrackRow {
                            title: root.long-text ? root.long-title : "II. Andante con moto";
                            names: [{ label: "Mara Lind", link: "artist:1" }, { label: "Ove Strand", link: "artist:2" }];
                            duration: "9:48";
                            part: true;
                            clicked => { root.event = "play track:5"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.event = "love track:5"; }
                        }
                        TrackRow {
                            title: root.long-text ? root.long-title : "Egmont Overture, Op. 84";
                            names: [{ label: "Ludwig van Beethoven", link: "artist:8" }, { label: "Mara Lind", link: "artist:1" }];
                            split: 1;
                            duration: "8:20";
                            years: "1809 – 1810";
                            performed: "Performed Nov 1992, Concertgebouw";
                            strong: true;
                            clicked => { root.event = "play track:6"; }
                            open(link) => { root.event = "open " + link; }
                            toggle-love => { root.event = "love track:6"; }
                        }
                    }

                    if root.current == 5: Shelf {
                        title: "New albums";
                        more: true;
                        see-all => { root.event = "see all new albums"; }
                        for album in root.shelf: CoverTile {
                            cover: album.cover;
                            title: album.title;
                            names: album.names;
                            clicked => { root.event = "open " + album.link; }
                            open(link) => { root.event = "open " + link; }
                        }
                    }
                    if root.current == 5: Shelf {
                        title: "Performers";
                        PersonTile { photo: root.photo-1; name: "Mara Lind"; role: "Vocals"; }
                        PersonTile { photo: root.photo-2; name: "Ines Varga"; role: "Piano"; }
                        PersonTile { photo: root.none; name: "Tomas Reed"; role: "Bass"; }
                    }

                    if root.current == 6: Example {
                        caption: "Swipe, drag, scroll sideways or use the buttons: it comes to rest in the grid's columns";
                        CoverShelf {
                            title: "Recently added";
                            tiles: root.grid;
                            open(link) => { root.event = "open " + link; }
                            select(index) => { root.event = "select tile " + index; }
                        }
                    }
                    if root.current == 6: Example {
                        caption: "Resize the window: tiles widen to fill a row, then move to the next";
                        CoverGrid {
                            tiles: root.grid;
                            open(link) => { root.event = "open " + link; }
                            select(index) => { root.event = "select tile " + index; }
                        }
                    }

                    if root.current == 7: Example {
                        caption: "Album; on a narrow window the text moves under the cover";
                        PageHeader {
                            artwork: root.albums[0].cover;
                            kind: "Album";
                            title: root.albums[0].title;
                            names: root.long-text ? root.many : root.mara;
                            facts: "2021 · Folk · 9 tracks, 41 minutes";
                            open(link) => { root.event = "open " + link; }
                            IconButton {
                                icon: Icons.heart;
                                filled: root.loved-album;
                                color: root.loved-album ? Theme.accent : Theme.muted;
                                label: root.loved-album ? "Loved" : "Love";
                                clicked => { root.loved-album = !root.loved-album; }
                            }
                        }
                    }
                    if root.current == 7: Example {
                        caption: "Artist";
                        PageHeader {
                            artwork: root.photo-1;
                            round: true;
                            kind: "Artist";
                            title: root.long-text ? "Oskar Brandt-Falkenberg von Hohenstein" : "Mara Lind";
                            facts: "6 albums, 2 compilations";
                        }
                    }

                    if root.current == 8: Example {
                        caption: "The current section is highlighted; sections are grouped under headings, such as the library's pages and the playlists, the last without one; more than fit scroll";
                        Sidebar {
                            width: 220px;
                            height: 380px;
                            items: ["Albums", "Artists", "Composers", "Playlists", "Road Trip", root.long-text ? root.long-title : "Sunday Morning", "Running", "Focus", "Dinner Party", "Rainy Day", "Account"];
                            groups: [
                                root.long-text ? "Library on the server down the hall" : "Library",
                                root.long-text ? "Library on the server down the hall" : "Library",
                                root.long-text ? "Library on the server down the hall" : "Library",
                                root.long-text ? "Library on the server down the hall" : "Library",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                                "Playlists",
                            ];
                            selected(index) => { root.event = "section " + index; }
                        }
                    }

                    if root.current == 9: Example {
                        caption: "Back is possible here, forward isn't; press Enter to search";
                        Rectangle {
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            TopBar {
                                can-go-back: true;
                                back => { root.event = "back"; }
                                forward => { root.event = "forward"; }
                                search(query) => { root.event = "search " + query; }
                            }
                        }
                    }

                    if root.current == 10: Example {
                        caption: "Heart, back, forward, a button that can't be pressed, and up or down";
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            IconButton {
                                icon: Icons.heart;
                                filled: root.loved-1;
                                color: root.loved-1 ? Theme.accent : Theme.text;
                                label: "Love";
                                clicked => { root.loved-1 = !root.loved-1; }
                            }
                            IconButton {
                                icon: Icons.back;
                                label: "Back";
                                clicked => { root.event = "back"; }
                            }
                            IconButton {
                                icon: Icons.forward;
                                label: "Forward";
                                clicked => { root.event = "forward"; }
                            }
                            IconButton {
                                icon: Icons.forward;
                                label: "Forward";
                                enabled: false;
                            }
                            IconButton {
                                icon: root.down ? Icons.down : Icons.up;
                                label: "Descending";
                                accessible-checkable: true;
                                accessible-checked: root.down;
                                clicked => { root.down = !root.down; }
                            }
                        }
                    }

                    if root.current == 11: Example {
                        caption: "How many are selected, and the button that ends selecting";
                        HorizontalLayout {
                            alignment: start;
                            SelectionBar {
                                count: root.long-text ? 12345 : 3;
                                clear => { root.event = "clear selection"; }
                            }
                        }
                    }

                    if root.current == 12: Example {
                        caption: "Headings over rows; the title takes the room left over, names are links, empty cells stay empty, the heart loves, a heading sorts, a right-click selects, the dots open the menu";
                        VerticalLayout {
                            TrackHeader {
                                columns: root.table-columns;
                                sort(index) => { root.event = "sort by " + root.table-columns[index].title; }
                            }
                            for line[i] in root.table-lines: TrackLineRow {
                                columns: root.table-columns;
                                line: line;
                                striped: mod(i, 2) == 1;
                                selecting: root.picked-1 || root.picked-2 || root.picked-3;
                                joined-above: i > 0 && root.table-lines[i - 1].selected;
                                joined-below: i + 1 < root.table-lines.length && root.table-lines[i + 1].selected;
                                open(link) => { root.event = link; }
                                select => {
                                    if i == 0 {
                                        root.picked-1 = !root.picked-1;
                                    } else if i == 1 {
                                        root.picked-2 = !root.picked-2;
                                    } else {
                                        root.picked-3 = !root.picked-3;
                                    }
                                    root.event = "select " + i;
                                }
                                toggle-love => {
                                    if i == 0 {
                                        root.loved-1 = !root.loved-1;
                                    } else if i == 1 {
                                        root.loved-2 = !root.loved-2;
                                    } else {
                                        root.loved-3 = !root.loved-3;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
