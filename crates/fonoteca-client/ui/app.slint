import { Button, ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { AlbumTile, CoverGrid, IconButton, Icons, Name, PageHeader, SelectionBar, Sidebar, Theme, TopBar, TrackRow } from "components.slint";

export { AlbumTile, Name }

export enum Step { opening, server, sign-in, listenbrainz, done }

export enum Page { albums, album, artist, account }

export struct Track {
    title: string,
    // Who wrote this track, `split` of them, then who plays it, as far as its
    // row says: a movement names only performers its work's row doesn't.
    names: [Name],
    split: int,
    duration: string,
    loved: bool,
    // For a work's only track: the years the work was written, and when and
    // where the track was recorded.
    years: string,
    performed: string,
    // The work of several tracks this one starts, its names, length, years
    // and recording as above, for the row that heads them; empty on every
    // other track.
    work: string,
    work-names: [Name],
    work-split: int,
    work-duration: string,
    work-years: string,
    work-performed: string,
    // A movement, under its work's row.
    part: bool,
    // A work's only track on the album, a row as strong as a work's.
    alone: bool,
}

component Heading inherits Text {
    font-size: 24px;
    font-weight: 600;
    wrap: word-wrap;
}

component Note inherits Text {
    wrap: word-wrap;
    color: Palette.foreground.transparentize(30%);
}

component Problem inherits Text {
    wrap: word-wrap;
    color: #d33;
}

// Starts at the top again whenever `visit` changes, that is on every page
// shown. Says when the bottom is less than a screen away, so more can load
// before it's reached.
component PageScroll inherits ScrollView {
    in property <int> visit;
    callback near-end();
    changed visit => {
        self.content-y = 0;
    }
    changed content-y => {
        self.check-end();
    }
    changed content-height => {
        self.check-end();
    }
    function check-end() {
        if -self.content-y + 2 * self.visible-height >= self.content-height {
            self.near-end();
        }
    }
}

// The albums page's Sort menu and direction.
component SortControls inherits HorizontalLayout {
    in-out property <int> sort;
    in-out property <bool> descending;
    callback sort-selected();
    spacing: 12px;
    ComboBox {
        min-width: 96px;
        horizontal-stretch: 0;
        accessible-label: "Sort by";
        // In the order browse.rs's `arranged` takes them.
        model: ["Name", "Artist", "Recently added", "Year"];
        current-index <=> root.sort;
        // Names start A to Z, dates newest first.
        selected => {
            root.descending = root.sort >= 2;
            root.sort-selected();
        }
    }
    IconButton {
        cross-axis-self-alignment: center;
        icon: root.descending ? Icons.down : Icons.up;
        label: "Descending";
        accessible-checkable: true;
        accessible-checked: root.descending;
        clicked => {
            root.descending = !root.descending;
            root.sort-selected();
        }
    }
}

// The albums page's filter, with the sort controls beside it or, when
// `stacked`, under it.
component AlbumControls inherits VerticalLayout {
    in property <bool> stacked;
    in-out property <string> filter;
    in-out property <int> sort;
    in-out property <bool> descending;
    callback filter-edited();
    callback sort-selected();
    spacing: 12px;
    HorizontalLayout {
        spacing: 12px;
        LineEdit {
            min-width: 64px;
            preferred-width: 240px;
            placeholder-text: "Filter";
            text <=> root.filter;
            edited => { root.filter-edited(); }
        }
        if !root.stacked: SortControls {
            sort <=> root.sort;
            descending <=> root.descending;
            sort-selected => { root.sort-selected(); }
        }
    }
    if root.stacked: SortControls {
        alignment: start;
        sort <=> root.sort;
        descending <=> root.descending;
        sort-selected => { root.sort-selected(); }
    }
}

export component AppWindow inherits Window {
    title: "Fonoteca";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Palette.background;

    in-out property <Step> step: Step.opening;
    in property <bool> busy;
    in-out property <string> problem;

    in-out property <string> address;
    in property <bool> api-key-offered;
    in property <bool> unencrypted;
    in-out property <int> login-method: 0;
    in-out property <string> api-key;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> listenbrainz-token;

    in property <string> server-name;
    in property <string> signed-in;
    in property <string> listenbrainz-user;
    in property <string> saved-note;

    callback find-server();
    callback sign-in();
    callback connect-listenbrainz();
    callback skip-listenbrainz();
    callback sign-out();

    in property <Page> page;
    in property <int> visit;
    in property <bool> loading;
    in property <string> page-problem;
    // Why the library couldn't be opened with the saved account.
    in property <string> offline;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in-out property <int> section;
    in property <[AlbumTile]> tiles;
    in property <bool> more-tiles;
    in property <image> header-image;
    in property <string> header-title;
    in property <[Name]> header-names;
    in property <string> header-facts;
    in property <[Track]> tracks;
    // How many albums are selected, on this page or others. While any are,
    // the selection bar is up and a click on a tile selects it.
    in property <int> selected-tiles;
    // The albums page's order, as the index into its Sort menu, its
    // direction, and the filter typed on it.
    in-out property <int> album-sort;
    in-out property <bool> album-descending;
    in-out property <string> album-filter;

    callback open(link: string);
    callback back();
    callback forward();
    callback show-section(index: int);
    callback show-more();
    callback sort-albums();
    callback filter-albums();
    // The tiles whose covers to fetch next.
    callback tiles-in-view(first: int, last: int);
    callback toggle-love(row: int);
    callback reconnect();
    // Selects the tile at `index`, or lets it go if it is selected.
    callback select-tile(index: int);
    callback clear-selection();

    property <length> sidebar-width: 200px;

    if root.step == Step.done: HorizontalLayout {
        Sidebar {
            width: root.sidebar-width;
            items: ["Albums", "Account"];
            groups: ["Library"];
            current <=> root.section;
            selected(index) => { root.show-section(index); }
        }
        VerticalLayout {
            TopBar {
                can-go-back: root.can-go-back;
                can-go-forward: root.can-go-forward;
                searchable: false;
                back => { root.back(); }
                forward => { root.forward(); }
            }
            scroll := PageScroll {
                visit: root.visit;
                near-end => {
                    if root.page == Page.albums && root.more-tiles && !root.loading && root.page-problem == "" {
                        root.show-more();
                    }
                }
                content-width: self.visible-width;
                content-height: stage.preferred-height;
                stage := VerticalLayout {
                    width: scroll.visible-width;
                    padding: 24px;
                    padding-top: 8px;
                    // Room to scroll the last tiles out from under the bar.
                    padding-bottom: root.selected-tiles > 0 ? 96px : 24px;
                    spacing: 24px;
                    alignment: start;

                    if root.offline != "": VerticalLayout {
                        spacing: 8px;
                        Problem { text: root.offline; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Try again";
                                clicked => { root.reconnect(); }
                            }
                        }
                    }
                    // The filter and sort controls go beside the heading, or
                    // under it in two rows when the page is too narrow.
                    if root.page == Page.albums: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Heading {
                                horizontal-stretch: 1;
                                text: "Albums";
                                vertical-alignment: center;
                            }
                            if scroll.visible-width >= 600px: AlbumControls {
                                horizontal-stretch: 0;
                                filter <=> root.album-filter;
                                sort <=> root.album-sort;
                                descending <=> root.album-descending;
                                filter-edited => { root.filter-albums(); }
                                sort-selected => { root.sort-albums(); }
                            }
                        }
                        if scroll.visible-width < 600px: AlbumControls {
                            stacked: true;
                            filter <=> root.album-filter;
                            sort <=> root.album-sort;
                            descending <=> root.album-descending;
                            filter-edited => { root.filter-albums(); }
                            sort-selected => { root.sort-albums(); }
                        }
                    }
                    if root.page == Page.album || root.page == Page.artist: PageHeader {
                        artwork: root.header-image;
                        round: root.page == Page.artist;
                        kind: root.page == Page.artist ? "Artist" : "Album";
                        title: root.header-title;
                        names: root.header-names;
                        facts: root.header-facts;
                        open(link) => { root.open(link); }
                    }
                    if root.page == Page.albums || root.page == Page.artist: CoverGrid {
                        tiles: root.tiles;
                        view-top: -scroll.content-y - self.y;
                        view-height: scroll.visible-height;
                        open(link) => { root.open(link); }
                        in-view(first, last) => { root.tiles-in-view(first, last); }
                        selecting: root.selected-tiles > 0;
                        select(index) => { root.select-tile(index); }
                    }
                    if root.page == Page.album: VerticalLayout {
                        for track[row] in root.tracks: VerticalLayout {
                            if track.work != "": TrackRow {
                                title: track.work;
                                names: track.work-names;
                                split: track.work-split;
                                duration: track.work-duration;
                                years: track.work-years;
                                performed: track.work-performed;
                                lovable: false;
                                strong: true;
                                open(link) => { root.open(link); }
                            }
                            TrackRow {
                                title: track.title;
                                names: track.names;
                                split: track.split;
                                duration: track.duration;
                                loved: track.loved;
                                years: track.years;
                                performed: track.performed;
                                strong: track.alone;
                                part: track.part;
                                open(link) => { root.open(link); }
                                toggle-love => { root.toggle-love(row); }
                            }
                        }
                    }
                    if root.page == Page.albums && root.album-filter != "" && root.tiles.length == 0 && !root.loading && root.page-problem == "": Note {
                        text: "No albums match.";
                    }
                    if root.page-problem != "": Problem { text: root.page-problem; }
                    if root.page == Page.albums && (root.more-tiles || root.tiles.length == 0) && root.page-problem != "" && !root.loading: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Try again";
                            clicked => { root.show-more(); }
                        }
                    }
                    if root.loading: Note { text: "Loading…"; }
                    if root.page == Page.account: VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Account"; }
                        Text {
                            text: root.server-name == "" ? root.address : root.server-name + " at " + root.address;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.signed-in;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.listenbrainz-user == "" ? "ListenBrainz not connected" : "ListenBrainz: " + root.listenbrainz-user;
                            wrap: word-wrap;
                        }
                        if root.saved-note != "": Note { text: root.saved-note; }
                        if root.problem != "": Problem { text: root.problem; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Sign out";
                                enabled: !root.busy;
                                clicked => { root.sign-out(); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.step == Step.done && root.selected-tiles > 0: SelectionBar {
        x: root.sidebar-width + (root.width - root.sidebar-width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: self.preferred-width;
        height: self.preferred-height;
        count: root.selected-tiles;
        clear => { root.clear-selection(); }
    }

    if root.step != Step.done: VerticalLayout {
        alignment: center;
        padding: 16px;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                preferred-width: 420px;
                max-width: 420px;
                spacing: 12px;

                if root.step == Step.opening: Note { text: "Reading your saved sign-in…"; }

                if root.step == Step.server: VerticalLayout {
                    spacing: 12px;
                    Heading { text: "Connect to your music server"; }
                    Note { text: "The address of an OpenSubsonic or Subsonic server, such as Navidrome."; }
                    LineEdit {
                        placeholder-text: "https://music.example.org";
                        text <=> root.address;
                        enabled: !root.busy;
                        accepted => { root.find-server(); }
                    }
                    if root.problem != "": Problem { text: root.problem; }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: root.busy ? "Checking…" : "Continue";
                            primary: true;
                            enabled: !root.busy && root.address != "";
                            clicked => { root.find-server(); }
                        }
                    }
                }

                if root.step == Step.sign-in: VerticalLayout {
                    spacing: 12px;
                    Heading { text: "Sign in"; }
                    Note { text: root.address; }
                    if root.unencrypted: Problem {
                        text: "This address isn't encrypted (http). Anyone on the network between you and the server can read what you send.";
                    }
                    if root.api-key-offered: ComboBox {
                        model: ["API key", "Username and password"];
                        current-index <=> root.login-method;
                        enabled: !root.busy;
                    }
                    if root.api-key-offered && root.login-method == 0: LineEdit {
                        placeholder-text: "API key";
                        input-type: InputType.password;
                        text <=> root.api-key;
                        enabled: !root.busy;
                        accepted => { root.sign-in(); }
                    }
                    if !root.api-key-offered || root.login-method == 1: VerticalLayout {
                        spacing: 12px;
                        LineEdit {
                            placeholder-text: "Username";
                            text <=> root.username;
                            enabled: !root.busy;
                        }
                        LineEdit {
                            placeholder-text: "Password";
                            input-type: InputType.password;
                            text <=> root.password;
                            enabled: !root.busy;
                            accepted => { root.sign-in(); }
                        }
                    }
                    if root.problem != "": Problem { text: root.problem; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Back";
                            enabled: !root.busy;
                            clicked => {
                                root.problem = "";
                                root.step = Step.server;
                            }
                        }
                        Rectangle { }
                        Button {
                            text: root.busy ? "Signing in…" : "Sign in";
                            primary: true;
                            enabled: !root.busy;
                            clicked => { root.sign-in(); }
                        }
                    }
                }

                if root.step == Step.listenbrainz: VerticalLayout {
                    spacing: 12px;
                    Heading { text: "ListenBrainz"; }
                    Note { text: "Optional. Connect ListenBrainz to love and hate recordings there. Your user token is on https://listenbrainz.org/settings/"; }
                    LineEdit {
                        placeholder-text: "User token";
                        input-type: InputType.password;
                        text <=> root.listenbrainz-token;
                        enabled: !root.busy;
                        accepted => { root.connect-listenbrainz(); }
                    }
                    if root.problem != "": Problem { text: root.problem; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Back";
                            enabled: !root.busy;
                            clicked => {
                                root.problem = "";
                                root.step = Step.sign-in;
                            }
                        }
                        Rectangle { }
                        Button {
                            text: "Skip";
                            enabled: !root.busy;
                            clicked => { root.skip-listenbrainz(); }
                        }
                        Button {
                            text: root.busy ? "Checking…" : "Connect";
                            primary: true;
                            enabled: !root.busy && root.listenbrainz-token != "";
                            clicked => { root.connect-listenbrainz(); }
                        }
                    }
                }
            }
        }
    }
}
