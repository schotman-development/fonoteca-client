import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Switch, TextEdit } from "std-widgets.slint";
import { AlbumTile, CoverGrid, CoverShelf, Drag, EqBandLine, EqBandRow, DownloadButton, EqGraph, EqGridLine, EqPoint, FingerSpeed, Fling, GenreBanner, GenreGrid, IconButton, Icons, Input, Landing, Link, Links, ListRow, MenuEntry, MoreMenu, Name, NowPlaying, OutputPicker, PageHeader, PathStep, PlayButton, PlayerBar, PlayerControls, QueueLine, QueueReorder, Pressable, Screen, SelectionBar, SettingsRow, Sidebar, Theme, TopBar, TrackColumn, TrackHeader, TrackLine, TrackLineRow, TrackRow, QualityPicker } from "components.slint";

export { AlbumTile, Drag, Icons, Input, MenuEntry, Name, TrackColumn, TrackLine }

export enum Step { opening, server, sign-in, listenbrainz, done }

export enum Page { home, albums, artists, tracks, playlists, album, artist, playlist, account, composers, compositions, composer, composition, track, folders, settings, setting, radio, stations, tags, tag, genres, genre, downloads }

// What the dialog over the page asks: a new playlist's name, the playlist's
// new name, or whether to delete it, and the same of a playlist folder; a
// new password for the account signed in; a new radio station, changes to
// one, or whether to delete one; a new tag, a tag's new name, or whether to
// delete it; and which tags songs have.
enum Asking { nothing, new-playlist, rename-playlist, delete-playlist, new-folder, rename-folder, delete-folder, own-password, new-station, edit-station, delete-station, new-tag, rename-tag, delete-tag, tag-songs, save-eq-preset, import-eq, remove-download, remove-all-downloads }

// A headphone found in OPRA's presets, and one of the presets it has. The
// summary is its bands in words; the problem is why the EQ can't hold it,
// when it can't.
export struct HeadphoneRow {
    title: string,
    details: string,
}

export struct HeadphonePresetLine {
    author: string,
    details: string,
    summary: string,
    link: string,
    problem: string,
}

// A tag on the tags page: its id, name and how many tracks have it, how
// deep under other tags it sits, and where it can be moved.
export struct TagRow {
    id: string,
    title: string,
    details: string,
    depth: int,
    targets: [Name],
}

// A tag in the tags dialog, as deep as it sits, ticked when every song the
// dialog is for has it.
export struct TagChoice {
    title: string,
    depth: int,
    ticked: bool,
}

// A radio station on the radio page: its id, name, where it streams from
// and its home page, and a line with both.
export struct StationRow {
    id: string,
    name: string,
    stream: string,
    homepage: string,
    details: string,
}

// A shelf of the radio directory: its title, the page with all of it, and
// its stations as tiles.
export struct StationShelf {
    title: string,
    link: string,
    tiles: [AlbumTile],
    // Which of the app's genres it is.
    shelf: int,
}

// What a track's page says about it under one heading, such as its album.
export struct Detail {
    label: string,
    names: [Name],
}

// One of the library's counts on the home page, "…" until it is known, and
// the page that lists them.
export struct Stat {
    icon: string,
    label: string,
    value: string,
    link: string,
}

// A column the tracks table can show, or a language whose stations the
// radio page shows first, and whether it does.
export struct ColumnChoice {
    title: string,
    shown: bool,
}

export struct Track {
    title: string,
    // Who wrote this track, `split` of them, then who plays it, as far as its
    // row says: a movement names only performers its work's row doesn't. On a
    // playlist, who plays it, `split` of them, then its album.
    names: [Name],
    split: int,
    duration: string,
    loved: bool,
    // Whether the song is kept on this device, and whether it was asked for
    // on its own.
    downloaded: bool,
    downloaded-alone: bool,
    // For a work's only track: the years the work was written, and when and
    // where the track was recorded.
    years: string,
    performed: string,
    // The work of several tracks this one starts, its names, length, years
    // and recording as above, for the row that heads them; empty on every
    // other track.
    work: string,
    work-names: [Name],
    work-split: int,
    work-duration: string,
    work-years: string,
    work-performed: string,
    // How many tracks the work spans, for its row to queue them all.
    work-tracks: int,
    // A movement, under its work's row.
    part: bool,
    // A work's only track on the album, a row as strong as a work's.
    alone: bool,
    // The page a click on the row opens: a composition's, or on its page a
    // performance's album. Empty on albums and playlists.
    link: string,
}

component Heading inherits Text {
    font-size: 24px * Theme.zoom;
    font-weight: 600;
    wrap: word-wrap;
}

// A heading over a part of a page, set off from what is above it.
component SectionHeading inherits VerticalLayout {
    in property <string> text;
    padding-top: 12px;
    Text {
        text: root.text;
        font-size: Theme.heading;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }
}

// A screen reader reads both out when they appear or change.
component Note inherits Text {
    wrap: word-wrap;
    color: Palette.foreground.transparentize(30%);
    accessible-live-region: polite;
}

component Problem inherits Text {
    wrap: word-wrap;
    color: Theme.danger;
    accessible-live-region: assertive;
}

// A thin bar along one side of the pages' scroll view, where the page is
// and as much of it as shows; wider while pointed at, and dragged to scroll.
// `value` is the page's offset, 0 down to -`maximum`.
component PageBar {
    in property <bool> horizontal;
    in property <length> maximum;
    in property <length> page-size;
    in-out property <length> value;

    property <length> track: root.horizontal ? root.width : root.height;
    property <length> length: max(32px, root.track * root.page-size / (root.maximum + root.page-size));
    property <length> thickness: touch.has-hover || touch.pressed ? 6px : 3px;
    animate thickness { duration: 150ms; easing: ease-out; }
    visible: root.maximum > 0;

    Rectangle {
        x: root.horizontal ? (root.track - root.length) * (-root.value / root.maximum) : root.width - 4px - self.width;
        y: root.horizontal ? root.height - 4px - self.height : (root.track - root.length) * (-root.value / root.maximum);
        width: root.horizontal ? root.length : root.thickness;
        height: root.horizontal ? root.thickness : root.length;
        border-radius: root.thickness / 2;
        background: Theme.muted.transparentize(40%);
    }
    touch := TouchArea {
        property <length> start;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start = root.value;
            }
        }
        moved => {
            if self.pressed {
                let by = root.horizontal ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y;
                root.value = -clamp(by * root.maximum / (root.track - root.length) - self.start, 0, root.maximum);
            }
        }
    }
}

// What letting go of a pull or a swipe does, as a round button that comes
// with the finger: faint at first, lit once the finger has come all the way.
component GestureHint inherits Rectangle {
    in property <string> icon;
    // How much of the way the finger has come.
    in property <float> progress;

    property <bool> ready: root.progress >= 1;
    width: 40px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.ready ? Theme.accent : Theme.surface;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #0000004d;
    opacity: min(root.progress, 1);

    Path {
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.ready ? Palette.accent-foreground : Theme.text;
        stroke-width: 1.75px;
        fill: transparent;
    }
}

// The pages' scroll view: a Flickable of its own rather than a ScrollView, for
// the wheel, the keys and the bars, and a drag of its own for a finger, which
// Slint 1.18's Flickable gets wrong on a phone. A finger's drag follows the
// finger from where it went down and glides on when let go, as Android's
// lists do (Fling), along one axis: up or down, or sideways on a page wider
// than the view, whichever way it went more. Sideways on a shelf it slides
// the shelf instead; it leaves alone a control with a drag of its own, as a
// seek bar has, and a shelf sliding itself (Landing). A finger that stops a
// glide taps nothing, as on Android, and the wheel or a key take over from it.
// Starts at the top left again whenever `visit` changes, that is on every page
// shown. Takes the keys when `arrival` does, on a page opened, so Tab goes on
// from the page's top and a screen reader names the page; not on a new sort or
// filter, which goes on taking them.
// Says when the bottom is less than a screen away, so more can load before
// it's reached. The arrow keys, Page Up and Down, Home and End scroll it
// when what has the keys doesn't take them; Escape goes to `escape`, and
// Android's back button and gesture to `back` while there is a page to go
// back to; with none they close the app.
// A finger pulling the page down from its top asks for `refresh`; one
// swiping in from the left edge for `back`, from the right edge for
// `forward`. A mouse does neither, as its drags move playlists.
component PageScroll inherits FocusScope {
    in property <int> visit;
    in property <int> arrival;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    // Whether it takes the keys back when Input.refocus asks: the page
    // doesn't while the sheet is over it, nor the sheet once it is gone.
    in property <bool> active: true;
    // Whether more may come below its end, as a long list's next hundred.
    in property <bool> open-ended;
    out property <length> visible-width: flick.width;
    out property <length> visible-height: flick.height;
    in-out property <length> content-width <=> flick.content-width;
    in-out property <length> content-height <=> flick.content-height;
    in-out property <length> content-x <=> flick.content-x;
    in-out property <length> content-y <=> flick.content-y;
    callback near-end();
    callback escape();
    callback back();
    callback forward();
    callback refresh();
    horizontal-stretch: 1;
    vertical-stretch: 1;
    focus-on-click: false;
    accessible-role: main;

    // How far a finger pulls or swipes for letting go to count, and how
    // wide the edges are that a swipe starts from.
    property <length> reach: 72px;
    property <length> edge: 20px;
    // How much of `reach` the finger has come, on each: a pull is a drag
    // down past the page's top.
    property <float> pulled: drag.swiping && root.from-top ? root.dragged-to / root.reach : 0;
    property <float> backed: back-edge.pressed ? (back-edge.mouse-x - back-edge.pressed-x) / root.reach : 0;
    property <float> forwarded: forward-edge.pressed ? (forward-edge.pressed-x - forward-edge.mouse-x) / root.reach : 0;

    // Whether the finger has gone more up or down than sideways since it
    // went down, which the drag waits for before it takes the finger.
    property <bool> upright: abs(finger.mouse-y - drag.pressed-position.y) >= abs(finger.mouse-x - drag.pressed-position.x);
    // How far right and down the page goes.
    property <length> right: min(0, flick.width - flick.content-width);
    property <length> bottom: min(0, flick.height - flick.content-height);
    // Whether the drag has the finger, and whether sideways; how far the
    // page goes that way, where it was when the drag took the finger, and
    // where the finger has dragged it to since, past its top when pulled.
    property <bool> taken;
    property <bool> across;
    property <length> far: root.across ? root.right : root.bottom;
    property <length> page-at: root.across ? flick.content-x : flick.content-y;
    property <length> taken-at;
    property <length> finger-at: root.across ? drag.current-position.x : drag.current-position.y;
    property <length> pressed-at: root.across ? drag.pressed-position.x : drag.pressed-position.y;
    property <length> dragged-to: root.taken-at + root.finger-at - root.pressed-at;
    // Whether the drag took the finger down from the page's top, a pull.
    property <bool> from-top: !root.across && root.taken-at >= 0;
    // Whether the drag slides a shelf the finger went sideways on rather
    // than the page.
    property <bool> shelving;

    // When the finger landed, and whether a control with a drag of its own,
    // or a shelf, claimed it on its first move (Landing). The drag leaves
    // the finger to such a control, and to a shelf sliding itself.
    property <duration> landed-at;
    property <bool> gripped: Landing.gripped == Landing.count;
    property <bool> shelved: Landing.shelved == Landing.count;
    property <bool> yielded: Input.sliding || root.gripped;
    // Whether the finger stopped a glide, which leaves it tapping nothing.
    property <bool> caught;

    // Where a fling glides the page from, how far, for how long, how far
    // along its curve it has come, and where it last put the page.
    property <length> glide-from;
    property <length> glide-by;
    property <duration> glide-time;
    property <bool> gliding;
    property <float> glided;
    property <length> glided-to;
    states [
        flung when root.gliding: {
            glided: 1;
            in {
                animate glided { duration: root.glide-time; easing: Fling.curve; }
            }
        }
    ]
    changed glided => {
        if !root.gliding {
            return;
        }
        // The wheel, a key or a bar moved the page meanwhile: they take over.
        if root.page-at != root.glided-to {
            root.gliding = false;
            return;
        }
        let to = root.glide-from + root.glide-by * root.glided;
        root.move-to(to);
        root.glided-to = root.page-at;
        if root.glided >= 1 || to < root.far || to > 0 {
            root.gliding = false;
        }
    }

    // Puts the page `at` along the drag's axis, as far as it goes.
    function move-to(at: length) {
        if root.across {
            flick.content-x = clamp(at, root.right, 0);
        } else {
            flick.content-y = clamp(at, root.bottom, 0);
        }
    }

    // A finger landed: it stops a glide, and what is under it may claim it
    // anew.
    function land() {
        Landing.count += 1;
        root.landed-at = animation-tick();
        root.caught = root.gliding;
        root.gliding = false;
    }

    // The drag takes the finger, along the way it went more.
    function take() {
        root.taken = true;
        root.caught = false;
        root.across = !root.upright;
        root.shelving = root.across && root.shelved;
        root.taken-at = root.page-at;
        root.gliding = false;
        if root.shelving {
            // Its first move went to the shelf, which claimed it then.
            speed.begin-from(root.pressed-at, root.landed-at, root.finger-at);
            Landing.sliding = true;
        } else {
            speed.begin(root.finger-at);
        }
    }

    changed visit => {
        self.content-x = 0;
        self.content-y = 0;
        self.gliding = false;
        Input.sliding = false;
    }
    changed arrival => {
        if !Input.modal {
            self.focus();
        }
    }
    property <int> refocus: Input.refocus;
    changed refocus => {
        if root.active {
            self.focus();
        }
    }
    key-pressed(event) => {
        let line = 48px;
        let page = max(line, self.visible-height - line);
        let by = event.text == Key.DownArrow ? -line
            : event.text == Key.UpArrow ? line
            : event.text == Key.PageDown || (event.text == Key.Space && !event.modifiers.shift) ? -page
            : event.text == Key.PageUp || (event.text == Key.Space && event.modifiers.shift) ? page
            : event.text == Key.Home ? 100000px
            : event.text == Key.End ? -100000px
            : 0;
        if by != 0 {
            self.content-y = clamp(self.content-y + by, min(0, self.visible-height - self.content-height), 0);
            return accept;
        }
        if event.text == Key.Escape {
            self.escape();
            return accept;
        }
        if event.text == Key.Back && root.can-go-back {
            root.back();
            return accept;
        }
        reject
    }
    changed content-y => {
        self.check-end();
    }
    changed content-height => {
        self.check-end();
    }
    function check-end() {
        if -self.content-y + 2 * self.visible-height >= self.content-height {
            self.near-end();
        }
    }

    speed := FingerSpeed { }

    // Around the drag, so it sees each move first, as Slint asks the outer
    // element first: where the finger is, for `upright`. Lifting a finger
    // leaves the window, so each one lands anew.
    finger := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: drag.enabled;
        changed has-hover => {
            if self.has-hover {
                root.land();
            }
        }

        // It holds every press back a moment to see where it goes. Up or
        // down it takes the finger from its first move on; sideways on a
        // page wider than the view, or on a shelf once the shelf has seen
        // that first move and claimed the finger.
        drag := SwipeGestureHandler {
            width: parent.width;
            height: parent.height;
            enabled: Input.finger;
            handle-swipe-up: root.upright && !root.yielded;
            handle-swipe-down: root.upright && !root.yielded;
            handle-swipe-left: !root.upright && (root.right < 0 || root.shelved) && !root.yielded;
            handle-swipe-right: !root.upright && (root.right < 0 || root.shelved) && !root.yielded;
            moved => {
                if !self.swiping {
                    return;
                }
                if root.taken {
                    speed.follow(root.finger-at);
                } else {
                    root.take();
                }
                if root.shelving {
                    Landing.slid = root.finger-at - root.pressed-at;
                } else {
                    root.move-to(root.dragged-to);
                }
            }
            swiped => {
                root.taken = false;
                let flung = speed.at-release(root.finger-at);
                if root.shelving {
                    Landing.slid = root.finger-at - root.pressed-at;
                    Landing.flung = flung;
                    Landing.sliding = false;
                    return;
                }
                if root.from-top && root.dragged-to >= root.reach {
                    root.refresh();
                    return;
                }
                root.glide-from = clamp(root.dragged-to, root.far, 0);
                root.glided-to = root.page-at;
                // Short of an end, it eases into it rather than stopping dead
                // on it, as a shelf comes to rest on its last tile; in that
                // much less time, so it still leaves the finger as fast as the
                // finger went. Not into a bottom that more may come under.
                let natural = Fling.distance(flung);
                let open = root.open-ended && !root.across && natural < 0;
                root.glide-by = open ? natural : clamp(root.glide-from + natural, root.far, 0) - root.glide-from;
                root.glide-time = natural == 0px ? 0ms : Fling.time(flung) * (root.glide-by / natural);
                root.gliding = root.glide-by != 0;
            }
            // A shelf goes back to where it rested.
            cancelled => {
                root.taken = false;
                if root.shelving {
                    Landing.slid = 0;
                    Landing.flung = 0;
                    Landing.sliding = false;
                }
            }

            // Slint drops the held press, and the page doesn't scroll, when the
            // finger moves meanwhile over nothing that takes the move; this,
            // under all of the page, takes it.
            TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: drag.enabled;
            }
            flick := Flickable {
                width: parent.width;
                height: parent.height;
                // A finger has the drag above. A touch screen's touches
                // before a press has told a finger from a mouse are the
                // Flickable's own, but not while a shelf slides.
                interactive: !Input.finger && !Input.sliding;
                // A mouse drags playlists; it scrolls with the wheel and the bars.
                mouse-drag-pan-enabled: false;
                @children
            }
            // Over the page while a finger that stopped a glide is down, to
            // take its tap: on Android one taps nothing.
            TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: root.caught;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.caught = false;
                    }
                }
            }
        }
    }
    PageBar {
        x: parent.width - self.width;
        width: 14px;
        height: parent.height - (across.visible ? 14px : 0);
        maximum: flick.content-height - flick.height;
        page-size: flick.height;
        value <=> flick.content-y;
    }
    across := PageBar {
        y: parent.height - self.height;
        width: parent.width - 14px;
        height: 14px;
        horizontal: true;
        maximum: flick.content-width - flick.width;
        page-size: flick.width;
        value <=> flick.content-x;
    }
    back-edge := TouchArea {
        x: 0;
        width: root.edge;
        enabled: Input.finger && root.can-go-back;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && self.mouse-x - self.pressed-x >= root.reach {
                root.back();
            }
        }
    }
    forward-edge := TouchArea {
        x: parent.width - self.width;
        width: root.edge;
        enabled: Input.finger && root.can-go-forward;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && self.pressed-x - self.mouse-x >= root.reach {
                root.forward();
            }
        }
    }
    // Cut off at the page's sides, so the hints come in from beyond them.
    Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        if root.pulled > 0: GestureHint {
            y: min(root.pulled, 1) * root.reach - self.height;
            icon: Icons.refresh;
            progress: root.pulled;
        }
        if root.backed > 0: GestureHint {
            x: min(root.backed, 1) * root.reach - self.width;
            y: back-edge.mouse-y - self.height / 2;
            icon: Icons.back;
            progress: root.backed;
        }
        if root.forwarded > 0: GestureHint {
            x: parent.width - min(root.forwarded, 1) * root.reach;
            y: forward-edge.mouse-y - self.height / 2;
            icon: Icons.forward;
            progress: root.forwarded;
        }
    }
}

// The filter of a page, named for what it filters, such as "Filter albums".
// Android's back in it hands the keys back to the page, whose next back
// goes back a page; a filter over a table isn't in the page to pass it on.
component Filter inherits LineEdit {
    in property <string> what;
    min-width: 64px;
    preferred-width: 240px;
    placeholder-text: "Filter";
    accessible-label: "Filter " + self.what;
    enabled: !Input.modal;
    key-pressed(event) => {
        if event.text == Key.Back {
            Input.refocus += 1;
            return accept;
        }
        reject
    }
}

// The library's counts in cards across the width, in as few rows as fit,
// shared out evenly. Where they don't all fit in one row, as on a phone,
// they go without their icons and smaller, which does.
component StatCards {
    in property <[Stat]> stats;
    callback open(link: string);
    property <bool> compact: (self.width + Theme.gap) / (180px + Theme.gap) < self.stats.length;
    property <length> gap: self.compact ? 8px : Theme.gap;
    property <length> card-height: (self.compact ? 64px : 88px) * Theme.zoom;
    property <int> fit: max(1, floor((self.width + self.gap) / ((self.compact ? 64px : 180px) + self.gap)));
    property <int> rows: ceil(self.stats.length / self.fit);
    property <int> columns: max(1, ceil(self.stats.length / max(1, self.rows)));
    property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
    height: max(0px, self.rows * (self.card-height + self.gap) - self.gap);

    for stat[i] in root.stats: card := Pressable {
        x: mod(i, root.columns) * (root.card-width + root.gap);
        y: floor(i / root.columns) * (root.card-height + root.gap);
        width: root.card-width;
        height: root.card-height;
        label: stat.value + " " + stat.label.to-lowercase();
        clicked => { root.open(stat.link); }
        Rectangle {
            border-radius: Theme.radius;
            background: card.hovered ? Theme.hover : Theme.surface;
        }
        HorizontalLayout {
            padding-left: root.compact ? 10px : 24px;
            padding-right: root.compact ? 6px : 16px;
            spacing: 16px;
            if !root.compact: Path {
                cross-axis-self-alignment: center;
                width: 36px;
                height: 36px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: stat.icon;
                stroke: Theme.text;
                stroke-width: 1.5px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: stat.value;
                    font-size: (root.compact ? 22px : 26px) * Theme.zoom;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: stat.label.to-uppercase();
                    font-size: 11px * Theme.zoom;
                    letter-spacing: 0.5px;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
        }
    }
}

// The genre a page of albums or artists has, which opens its page, and a
// button that shows them `all`.
component GenreFilter inherits HorizontalLayout {
    in property <string> genre;
    in property <string> all;
    callback open(link: string);
    alignment: start;
    spacing: 4px;

    Text {
        text: "Genre";
        font-size: Theme.body;
        color: Theme.muted;
        vertical-alignment: center;
    }
    Link {
        text: root.genre;
        color: Theme.text;
        clicked => { root.open("genre:" + root.genre); }
    }
    IconButton {
        icon: Icons.close;
        label: "All " + root.all;
        clicked => { root.open(root.all); }
    }
}

// The heading of the composers page, with its filter beside it, or under
// it when `narrow`.
component FilterHeading inherits VerticalLayout {
    in property <string> title;
    in property <bool> narrow;
    in-out property <string> filter;
    callback edited();
    spacing: 12px;
    HorizontalLayout {
        spacing: 12px;
        Heading {
            horizontal-stretch: 1;
            text: root.title;
            vertical-alignment: center;
        }
        if !root.narrow: Filter {
            horizontal-stretch: 0;
            what: root.title.to-lowercase();
            text <=> root.filter;
            edited => { root.edited(); }
        }
    }
    if root.narrow: Filter {
        what: root.title.to-lowercase();
        text <=> root.filter;
        edited => { root.edited(); }
    }
}

// The buttons under an onboarding step: in a row with the main one on the
// right, or on a phone stacked full width, the main one first. An empty
// `other` or a false `back` leaves that button out.
component StepButtons inherits VerticalLayout {
    in property <bool> phone;
    in property <bool> busy;
    in property <string> main;
    in property <bool> main-enabled: true;
    in property <string> other;
    in property <bool> back;
    callback main-clicked();
    callback other-clicked();
    callback back-clicked();

    if !root.phone: HorizontalLayout {
        spacing: 8px;
        if root.back: Button {
            text: "Back";
            enabled: !root.busy;
            clicked => { root.back-clicked(); }
        }
        Rectangle { }
        if root.other != "": Button {
            text: root.other;
            enabled: !root.busy;
            clicked => { root.other-clicked(); }
        }
        Button {
            text: root.main;
            primary: true;
            enabled: root.main-enabled;
            clicked => { root.main-clicked(); }
        }
    }
    if root.phone: VerticalLayout {
        spacing: 8px;
        Button {
            height: 48px;
            text: root.main;
            primary: true;
            enabled: root.main-enabled;
            clicked => { root.main-clicked(); }
        }
        if root.other != "": Button {
            height: 48px;
            text: root.other;
            enabled: !root.busy;
            clicked => { root.other-clicked(); }
        }
        if root.back: Button {
            height: 48px;
            text: "Back";
            enabled: !root.busy;
            clicked => { root.back-clicked(); }
        }
    }
}

// The albums page's Sort menu and direction.
component SortControls inherits HorizontalLayout {
    in-out property <int> sort;
    in-out property <bool> descending;
    callback sort-selected();
    spacing: 12px;
    ComboBox {
        min-width: 96px;
        horizontal-stretch: 0;
        enabled: !Input.modal;
        accessible-label: "Sort by";
        // In the order browse.rs's `arranged` takes them.
        model: ["Name", "Artist", "Recently added", "Year"];
        current-index <=> root.sort;
        // Names start A to Z, dates newest first.
        selected => {
            root.descending = root.sort >= 2;
            root.sort-selected();
        }
    }
    IconButton {
        cross-axis-self-alignment: center;
        icon: root.descending ? Icons.down : Icons.up;
        label: "Descending";
        accessible-checkable: true;
        accessible-checked: root.descending;
        clicked => {
            root.descending = !root.descending;
            root.sort-selected();
        }
    }
}

// The albums page's filter, with the sort controls beside it or, when
// `stacked`, under it.
component AlbumControls inherits VerticalLayout {
    in property <bool> stacked;
    in-out property <string> filter;
    in-out property <int> sort;
    in-out property <bool> descending;
    callback filter-edited();
    callback sort-selected();
    spacing: 12px;
    HorizontalLayout {
        spacing: 12px;
        Filter {
            what: "albums";
            text <=> root.filter;
            edited => { root.filter-edited(); }
        }
        if !root.stacked: SortControls {
            sort <=> root.sort;
            descending <=> root.descending;
            sort-selected => { root.sort-selected(); }
        }
    }
    if root.stacked: SortControls {
        alignment: start;
        sort <=> root.sort;
        descending <=> root.descending;
        sort-selected => { root.sort-selected(); }
    }
}

export component AppWindow inherits Window {
    title: "Fonoteca";
    icon: @image-url("../../../packaging/linux/hicolor/128x128/apps/io.github.schotman_development.fonoteca.png");
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Palette.background;

    in-out property <Step> step: Step.opening;
    in property <bool> busy;
    in-out property <string> problem;

    in-out property <string> address;
    in property <bool> api-key-offered;
    in property <bool> unencrypted;
    in-out property <int> login-method: 0;
    in-out property <string> api-key;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> listenbrainz-token;

    in property <string> server-name;
    in property <string> signed-in;
    in property <string> listenbrainz-user;
    in property <string> saved-note;

    callback find-server();
    callback sign-in();
    callback connect-listenbrainz();
    callback skip-listenbrainz();
    callback remove-listenbrainz();
    callback sign-out();
    callback change-server();

    in property <Page> page;
    in property <int> visit;
    // Counts the pages opened, and back and forward; `visit` counts a new
    // sort or filter too.
    in property <int> arrival;
    in property <bool> loading;
    in property <string> page-problem;
    // Why the library couldn't be opened with the saved account.
    in property <string> offline;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    // The sidebar's entries and their groups: the library's pages, the
    // playlists and the account. `section` is the current one.
    in property <[string]> sections;
    in property <[string]> section-groups;
    in property <[string]> section-icons;
    in-out property <int> section;
    in property <[AlbumTile]> tiles;
    in property <bool> more-tiles;
    in property <[Stat]> stats;
    in property <image> header-image;
    in property <string> header-title;
    // What a screen reader calls the page: its heading, or its section's.
    property <string> page-name: root.header-title != "" ? root.header-title : root.sections[root.section];
    in property <[Name]> header-names;
    in property <string> header-facts;
    in property <[Detail]> details;
    // An artist's biography or an album's notes, and the start of it shown
    // until opened; the artist's similar artists.
    in property <string> about;
    in property <string> about-short;
    in-out property <bool> about-open;
    // Where a genre's description comes from: the source's name, and its
    // address.
    in property <string> about-source;
    in property <string> about-url;
    // The wide picture over a genre page's title.
    in property <image> genre-banner;
    // A genre's popular radio stations, for its page.
    in property <StationShelf> genre-radio;
    in property <[Name]> similar;
    // The settings page's word on the server's scan of its libraries, and
    // whether one is going.
    in property <string> scan-status;
    in property <bool> scanning;
    // What the account signed in may do, as far as the server said; whether
    // it may do what only admins may, such as have the server scan or change
    // its radio stations, which it may when the server doesn't say.
    in property <string> roles;
    in property <bool> may-administer: true;
    // Whether this build can keep songs on the device and the account may
    // download; how much of the album or playlist on screen is kept (0 none,
    // 1 on its way, 2 all) and how far it is.
    in property <bool> can-download;
    in property <bool> may-download: true;
    in property <int> download-state;
    in property <string> download-progress;
    // The settings' downloads: how many songs are kept, what they take, what
    // is wrong or to go, and the entry of the size limit.
    in property <int> download-songs;
    // What signing out frees by removing the downloads; empty without any.
    in property <string> sign-out-frees;
    in property <string> download-space;
    in property <string> download-status;
    in-out property <int> download-limit;
    in property <[StationRow]> station-rows;
    // The radio directory's shelves, each a genre's stations with the most
    // votes, and the stations saved on the server, for the home page.
    in property <[StationShelf]> station-shelves;
    in property <[AlbumTile]> saved-stations;
    // The genres page's genres, or on a genre's page those under it; and its
    // artists, those with the most of its albums first.
    in property <[AlbumTile]> genre-tiles;
    in property <[AlbumTile]> genre-artists;
    // The radio directory's languages, ticked where the genres show their
    // stations first.
    in property <[ColumnChoice]> language-choices;
    in property <[Track]> tracks;
    // Whether this build plays music, and the track it plays, if any: as
    // PlayerBar shows it.
    in property <bool> can-play;
    in property <bool> playing;
    in property <image> playing-cover;
    in property <string> playing-title;
    // Which movement of the work in the title plays, and its place in it.
    in property <string> playing-movement;
    in property <string> playing-movement-place;
    in property <[Name]> playing-names;
    in property <bool> playing-paused;
    in property <float> playing-position;
    in property <float> playing-duration;
    in property <string> playing-waveform;
    in property <string> playing-quality;
    in property <int> playing-level: -1;
    in property <[PathStep]> playing-path;
    in property <string> playing-problem;
    // For the now playing sheet: the cover large, the album, and the queue
    // from the track playing on, with how many more there are than it shows.
    in property <image> playing-art;
    in property <Name> playing-album;
    out property <bool> now-playing-open;
    // Whether what plays moves on the sheet: the motion cover plays only
    // while the sheet is open and the song plays.
    property <bool> now-playing-moving: root.now-playing-open && root.playing && !root.playing-paused;
    callback now-playing-moving-changed(moving: bool);
    changed now-playing-moving => { root.now-playing-moving-changed(root.now-playing-moving); }
    in property <[QueueLine]> queue-lines;
    // Every row of the queue is as high as this, which a drag works from.
    property <length> queue-row-height: 56px;
    // The row that has the keys once the list is made anew after a move.
    property <int> queue-focus-row: -1;
    in property <int> queue-more;
    // Whether the queue is shuffled, and whether it repeats: 0 not, 1 all
    // of it, 2 the track.
    in property <bool> shuffled;
    in-out property <int> repeat;
    // The queue's entries in an album's or a playlist's tile menu; and the
    // tiles' menu on the page on screen: those on albums and playlists, and
    // moving to a folder on the playlists page.
    property <[MenuEntry]> queue-entries: [
        { id: "play", label: "Play now", icon: Icons.play },
        { id: "next", label: "Play next", icon: Icons.next },
        { id: "queue", label: "Add to queue", icon: Icons.queue },
    ];
    property <bool> tiles-queued: root.can-play && (root.page == Page.albums || root.page == Page.artist || root.page == Page.playlists || root.page == Page.downloads);
    property <bool> tiles-moved: root.page == Page.playlists && root.tile-moves.length > 0;
    property <[MenuEntry]> tile-entries: root.tiles-queued && root.tiles-moved ? [
        { id: "play", label: "Play now", icon: Icons.play },
        { id: "next", label: "Play next", icon: Icons.next },
        { id: "queue", label: "Add to queue", icon: Icons.queue },
        { id: "move", label: "Move to folder", icon: Icons.folder, choices: root.tile-moves },
    ] : root.tiles-queued ? root.queue-entries : root.tiles-moved ? [{ id: "move", label: "Move to folder", icon: Icons.folder, choices: root.tile-moves }] : [];
    // The sound devices to play on, the system's default first, and the one
    // chosen; volume leveling: off, by track or by album.
    in property <[MenuEntry]> output-devices;
    in property <string> output-name;
    in-out property <int> leveling;
    // The streaming format and bitrate entries for wifi and for mobile data;
    // a device without mobile data has just the first.
    in property <bool> has-mobile-data;
    in-out property <int> wifi-format;
    in-out property <int> wifi-bitrate;
    in-out property <int> mobile-format;
    in-out property <int> mobile-bitrate;
    // The sound processing: the headroom's, crossfeed's and upsampling's
    // entries; whether the EQ is on, its preamp and bands as typed, its
    // presets after a first "Custom" entry, and which of them it is.
    in-out property <int> headroom;
    in-out property <int> crossfeed;
    in-out property <int> upsampling;
    in-out property <bool> eq-on;
    in-out property <string> eq-preamp;
    in property <[EqBandLine]> eq-bands;
    // The graph: a point for each band, the curve of them all, its grid, and
    // the band picked on it or in a row, or -1.
    in property <[EqPoint]> eq-points;
    in property <string> eq-curve;
    in property <[EqGridLine]> eq-grid;
    in-out property <int> eq-selected: -1;
    in property <[string]> eq-presets;
    in-out property <int> eq-preset;
    // The headphone presets page: what is typed, the headphones that match
    // it, a line on what that is, the headphone picked and its presets.
    in-out property <string> headphone-filter;
    in property <[HeadphoneRow]> headphone-results;
    in property <string> headphone-status;
    in property <string> headphone-picked;
    in property <[HeadphonePresetLine]> headphone-presets;
    // The tracks or compositions page's table: the columns shown, their
    // rows, how wide they are together, how narrow they get together, and
    // every column there is to pick from.
    in property <[TrackColumn]> track-columns;
    in property <[TrackLine]> track-lines;
    // Whether the table's rows hold a song, not only folders.
    in property <bool> songs-listed;
    in property <length> track-table-width;
    in property <length> track-table-least;
    in property <[ColumnChoice]> track-choices;
    // How many albums and tracks are selected, on this page or others. While
    // any are, the selection bar is up and a click on a tile or row selects
    // it.
    in property <int> selected-tiles;
    // The playlists a song can be added to, as names linking to their ids,
    // and whether the playlist on screen can be changed.
    in property <[Name]> playlist-targets;
    in property <bool> playlist-editable;
    property <[Name]> no-names;
    // Whether the server has playlist folders and tags. The playlist folder
    // or tag on screen, by id, and where it or the playlist on screen can
    // be moved, as names linking to folder or tag ids, "" the top level.
    in property <bool> folders-offered;
    in property <bool> tags-offered;
    in property <string> shown-id;
    in property <[Name]> move-targets;
    // Where the playlists on the playlists page can be moved, and those
    // selected: none without folders, or with no playlist selected.
    in property <[Name]> tile-moves;
    in property <[Name]> selection-moves;
    // The tags page's rows; the tags dialog's tags, while not waiting for
    // what the songs have.
    in property <[TagRow]> tag-rows;
    in property <[TagChoice]> tag-choices;
    in property <bool> tag-choices-loading;
    // A short word on what was just done, such as songs added to a playlist.
    in property <string> notice;
    // The albums page's order, as the index into its Sort menu, its
    // direction, and the filter typed on it.
    in-out property <int> album-sort;
    in-out property <bool> album-descending;
    in-out property <string> album-filter;
    in-out property <string> artist-filter;
    in-out property <string> composer-filter;
    in-out property <string> composition-filter;
    in-out property <string> track-filter;
    in-out property <string> folder-filter;

    callback open(link: string);
    callback back();
    callback forward();
    // Shows the page on screen again, asked for anew.
    callback refresh();
    callback show-section(index: int);
    callback show-more();
    callback sort-albums();
    callback filter-albums();
    callback filter-artists();
    callback filter-composers();
    callback filter-compositions();
    callback filter-tracks();
    callback filter-folders();
    // The tiles or tracks table rows whose covers to fetch next.
    callback tiles-in-view(first: int, last: int);
    callback toggle-love(row: int);
    callback toggle-line-love(row: int);
    callback toggle-track-column(index: int);
    // Sorts the page's table by its `index`th column shown, or turns that
    // around.
    callback sort-tracks(index: int);
    callback reconnect();
    // Selects the tile or tracks table row at `index`, or lets it go if it
    // is selected.
    callback select-tile(index: int, range: bool);
    callback select-line(index: int, range: bool);
    callback clear-selection();
    callback resized();
    // Playlists: a new one with this name; the one on screen renamed or
    // deleted, or its `row`th track taken off; a song added to the playlist
    // with this id, from a row of the tracks table, of the album or playlist
    // on screen, or every song selected.
    callback create-playlist(name: string);
    callback rename-playlist(name: string);
    callback delete-playlist();
    callback start-scan();
    callback remove-from-playlist(row: int);
    callback add-line-to-playlist(row: int, id: string);
    callback add-track-to-playlist(row: int, id: string);
    // Keeps the album or playlist on screen on this device, or removes it.
    callback download-page();
    callback remove-page-download();
    // A song of the page's rows, or the album or playlist at a link, kept or
    // let go.
    callback download-track(row: int);
    callback remove-track-download(row: int);
    callback download-link(link: string);
    callback remove-link-download(link: string);
    callback choose-download-limit(index: int);
    callback remove-all-downloads();
    // Plays the album's, playlist's or artist's tracks, or the songs of the
    // table on screen, from the `row`th.
    callback play-tracks(row: int);
    // Said when a signed-in library opens, for what keeps its state on the
    // server, such as the play queue.
    callback library-started();
    callback toggle-pause();
    callback previous-track();
    callback next-track();
    callback seek(seconds: float);
    callback toggle-shuffle();
    callback cycle-repeat();
    // Puts `count` tracks of the page from the `row`th in the queue, to play
    // next or at its end; the songs of an album's or a playlist's link, to play now,
    // next or at the end; or the songs of the album or playlist on screen,
    // as `how` says: "next", "queue", or "shuffle-now", "shuffle-next" or
    // "shuffle-last" for them in a random order.
    callback queue-tracks(row: int, count: int, next: bool);
    callback queue-link(link: string, how: string);
    callback queue-page(how: string);
    // The queue on the now playing sheet, by its rows there: the first is
    // the track playing.
    callback jump-to(row: int);
    callback toggle-queued-work(row: int);
    callback play-queued-next(row: int);
    callback remove-queued(row: int);
    // Moves a row to a slot, the gap above the row of that number (the
    // list's length for the one below the last); `drop-slot` gives the slot a
    // row dragged to a place in the list lands in, and `step-slot` the one
    // a step up or down, or -1 when there is none.
    callback move-queued(from: int, slot: int);
    pure callback drop-slot(lines: [QueueLine], from: int, at: float) -> int;
    pure callback step-slot(lines: [QueueLine], from: int, down: bool) -> int;
    callback clear-queue();
    // A sound device or volume leveling chosen in the settings, by its
    // index in the list.
    callback choose-output(index: int);
    // Looks for the sound devices there are now, such as one just plugged in.
    callback list-devices();
    // The sound processing changed in the settings. Pasting AutoEQ's
    // settings answers what is wrong with them, or nothing.
    callback choose-headroom(index: int);
    callback choose-crossfeed(index: int);
    callback choose-upsampling(index: int);
    callback toggle-eq(on: bool);
    callback edit-preamp(text: string);
    callback edit-band(row: int, line: EqBandLine);
    callback add-band();
    // A click on the graph asks for a band there; a point dragged moves its
    // band as it goes, and lets go once.
    callback add-band-at(x: float, y: float);
    callback move-band(row: int, x: float, y: float);
    callback release-band();
    callback remove-band(row: int);
    callback choose-eq-preset(index: int);
    callback save-eq-preset(name: string);
    callback delete-eq-preset();
    callback import-eq(text: string) -> string;
    callback open-headphones();
    callback search-headphones(text: string);
    callback pick-headphone(row: int);
    callback load-headphone(row: int);
    callback choose-leveling(index: int);
    callback choose-stream-quality(mobile: bool, format: int, bitrate: int);
    callback add-selection-to-playlist(id: string);
    // Playlist folders: a new one with this name in the folder on screen;
    // the one on screen renamed, moved into the folder with this id, or to
    // the top level for "", or deleted; the playlist on screen moved.
    callback create-folder(name: string);
    callback rename-folder(name: string);
    callback move-folder(target: string);
    callback delete-folder();
    callback move-playlist(target: string);
    // The playlist of the `index`th tile moved, the playlists selected, and
    // the playlist being dragged, dropped onto the `index`th tile or
    // sidebar entry.
    callback move-tile(index: int, target: string);
    callback move-selection(target: string);
    callback drop-on-tile(index: int);
    callback drop-on-section(index: int);
    // Tags: a new one under the tag `parent`, or at the top level for "";
    // one renamed, moved as a folder is, or deleted. The tags dialog for the
    // song of a row of the tracks table, of the album or playlist on
    // screen, or for every song selected; a tag ticked or unticked there,
    // or a new one made and ticked.
    callback create-tag(parent: string, name: string);
    callback rename-tag(id: string, name: string);
    callback move-tag(id: string, target: string);
    callback delete-tag(id: string);
    callback tag-line(row: int);
    callback tag-track(row: int);
    callback tag-selection();
    callback toggle-tag(index: int);
    callback tag-with-new(name: string);
    // The account signed in given a new password.
    callback change-own-password(password: string);
    // Radio stations: one added, changed or deleted.
    callback create-station(name: string, stream: string, homepage: string);
    callback update-station(id: string, name: string, stream: string, homepage: string);
    callback delete-station(id: string, name: string);
    // A shelf's tiles on screen, whose pictures to fetch; a station of a
    // shelf, or of a genre's page when `shelf` is -1, to save on the server.
    callback station-shelf-in-view(shelf: int, first: int, last: int);
    callback save-station(shelf: int, index: int);
    callback toggle-language(index: int);

    property <Asking> asking;
    property <string> asked-name;
    property <string> asked-password;
    property <string> asked-repeat;
    property <string> asked-id;
    property <string> asked-stream;
    property <string> asked-homepage;
    // AutoEQ's settings pasted in, and what is wrong with them.
    property <string> asked-text;
    property <string> asked-problem;
    property <bool> asks-station: root.asking == Asking.new-station || root.asking == Asking.edit-station;
    property <bool> asks-name: root.asking == Asking.new-playlist || root.asking == Asking.rename-playlist || root.asking == Asking.new-folder || root.asking == Asking.rename-folder || root.asks-station || root.asking == Asking.new-tag || root.asking == Asking.rename-tag || root.asking == Asking.save-eq-preset;
    property <bool> asks-password: root.asking == Asking.own-password;
    property <bool> deleting: root.asking == Asking.delete-playlist || root.asking == Asking.delete-folder || root.asking == Asking.delete-station || root.asking == Asking.delete-tag || root.asking == Asking.remove-download || root.asking == Asking.remove-all-downloads;

    // Shows the dialog for `what`, the window behind out of the keys' reach.
    function open-dialog(what: Asking) {
        Input.modal = true;
        root.asking = what;
    }

    // Lets the dialog go; the page takes the keys back, or the menu that
    // opened it.
    function close-dialog() {
        root.asked-password = "";
        root.asked-repeat = "";
        root.asked-text = "";
        root.asked-problem = "";
        root.asking = Asking.nothing;
        Input.modal = false;
        Input.refocus += 1;
    }

    // About the page's playlist or playlist folder.
    function ask(what: Asking) {
        root.asked-name = what == Asking.rename-playlist || what == Asking.rename-folder || what == Asking.delete-folder ? root.header-title : "";
        root.open-dialog(what);
    }

    // About the tag with this id and name; for a new tag, the one to put it
    // under, "" for the top level.
    function ask-tag(what: Asking, id: string, name: string) {
        root.asked-id = id;
        root.asked-name = name;
        root.open-dialog(what);
    }

    // Asks about this station, or a new one when `station` is empty.
    function ask-station(what: Asking, station: StationRow) {
        root.asked-id = station.id;
        root.asked-name = station.name;
        root.asked-stream = station.stream;
        root.asked-homepage = station.homepage;
        root.open-dialog(what);
    }

    function answer() {
        if root.asking == Asking.new-playlist {
            root.create-playlist(root.asked-name);
        } else if root.asking == Asking.rename-playlist {
            root.rename-playlist(root.asked-name);
        } else if root.asking == Asking.delete-playlist {
            root.delete-playlist();
        } else if root.asking == Asking.new-folder {
            root.create-folder(root.asked-name);
        } else if root.asking == Asking.rename-folder {
            root.rename-folder(root.asked-name);
        } else if root.asking == Asking.delete-folder {
            root.delete-folder();
        } else if root.asking == Asking.new-tag {
            root.create-tag(root.asked-id, root.asked-name);
        } else if root.asking == Asking.rename-tag {
            root.rename-tag(root.asked-id, root.asked-name);
        } else if root.asking == Asking.delete-tag {
            root.delete-tag(root.asked-id);
        } else if root.asking == Asking.own-password {
            root.change-own-password(root.asked-password);
        } else if root.asking == Asking.new-station {
            root.create-station(root.asked-name, root.asked-stream, root.asked-homepage);
        } else if root.asking == Asking.edit-station {
            root.update-station(root.asked-id, root.asked-name, root.asked-stream, root.asked-homepage);
        } else if root.asking == Asking.delete-station {
            root.delete-station(root.asked-id, root.asked-name);
        } else if root.asking == Asking.remove-download {
            root.remove-page-download();
        } else if root.asking == Asking.remove-all-downloads {
            root.remove-all-downloads();
        } else if root.asking == Asking.save-eq-preset {
            root.save-eq-preset(root.asked-name);
        } else if root.asking == Asking.import-eq {
            root.asked-problem = root.import-eq(root.asked-text);
            if root.asked-problem != "" {
                return;
            }
        }
        root.close-dialog();
    }

    function asked-title() -> string {
        if root.asking == Asking.new-playlist { return "New playlist"; }
        if root.asking == Asking.rename-playlist { return "Rename playlist"; }
        if root.asking == Asking.delete-playlist { return "Delete “" + root.header-title + "”?"; }
        if root.asking == Asking.new-folder { return "New folder"; }
        if root.asking == Asking.rename-folder { return "Rename folder"; }
        if root.asking == Asking.new-tag { return "New tag"; }
        if root.asking == Asking.rename-tag { return "Rename tag"; }
        if root.asking == Asking.tag-songs { return "Tags"; }
        if root.asking == Asking.own-password { return "Change your password"; }
        if root.asking == Asking.new-station { return "New radio station"; }
        if root.asking == Asking.edit-station { return "Edit radio station"; }
        if root.asking == Asking.save-eq-preset { return "Save EQ as preset"; }
        if root.asking == Asking.import-eq { return "Paste AutoEQ settings"; }
        if root.asking == Asking.remove-download { return "Remove the download of “" + root.header-title + "”?"; }
        if root.asking == Asking.remove-all-downloads { return "Remove all downloads?"; }
        return "Delete “" + root.asked-name + "”?";
    }

    function asked-action() -> string {
        if root.asking == Asking.remove-download || root.asking == Asking.remove-all-downloads { return "Remove"; }
        if root.deleting { return "Delete"; }
        if root.asking == Asking.rename-playlist || root.asking == Asking.rename-folder || root.asking == Asking.rename-tag { return "Rename"; }
        if root.asking == Asking.tag-songs { return "Done"; }
        if root.asking == Asking.edit-station || root.asking == Asking.save-eq-preset { return "Save"; }
        if root.asking == Asking.import-eq { return "Use"; }
        if root.asking == Asking.own-password { return "Change"; }
        return "Create";
    }

    // Whether what is needed is filled in: a name, the password twice, the
    // same, and a station's stream.
    function may-answer() -> bool {
        return (!root.asks-name || root.asked-name != "")
            && (!root.asks-station || root.asked-stream != "")
            && (root.asking != Asking.import-eq || root.asked-text != "")
            && (!root.asks-password || (root.asked-password != "" && root.asked-password == root.asked-repeat));
    }

    // A page that is a table: the tracks, the compositions, a folder or a
    // tag.
    property <bool> table: root.page == Page.tracks || root.page == Page.compositions || root.page == Page.folders || root.page == Page.tag;

    // One physical pixel, which changes with the scale.
    property <length> physical-pixel: 1phx;

    changed width => {
        root.resized();
        root.share-size();
    }
    changed physical-pixel => { root.resized(); }
    changed height => { root.share-size(); }
    changed bottom-inset => { root.share-size(); }
    init => {
        root.share-size();
        Theme.zoom = root.text-zoom;
    }

    // How much bigger than its usual 14px the system's text size setting
    // makes text: Android's font size, Windows' text size; only bigger counts.
    // Other systems report none, which leaves 12px.
    property <float> text-zoom: max(1, 1rem / 14px);
    changed text-zoom => { Theme.zoom = self.text-zoom; }

    function share-size() {
        Screen.width = root.width;
        Screen.height = root.height;
        Screen.bottom = root.bottom-inset;
    }

    // The sidebar sits beside the pages on a wide window, wider the wider it
    // is; on a narrow one, such as a phone's or an upright tablet's, it stays
    // closed until the top bar's menu button opens it over the page.
    property <bool> docked: root.width >= 900px;
    property <length> sidebar-width: root.docked ? clamp(root.width * 0.14, 240px, 320px) : 0px;
    property <bool> sidebar-open;

    changed docked => { root.sidebar-open = false; }

    // A phone-sized window, where the onboarding is a form from the top
    // with bigger text and buttons.
    property <bool> phone: root.width < 600px;
    // What a phone covers at the bottom: its navigation bar, or the keyboard
    // when that is open, which the pages and forms stay above.
    property <length> bottom-inset: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);

    if root.step == Step.done: HorizontalLayout {
        // Clear of the bars a phone draws over the window.
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.bottom-inset;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        if root.docked: Sidebar {
            width: root.sidebar-width;
            items: root.sections;
            groups: root.section-groups;
            icons: root.section-icons;
            current <=> root.section;
            selected(index) => {
                root.close-now-playing();
                root.show-section(index);
            }
            new-playlist => { root.ask(Asking.new-playlist); }
            dropped(index) => { root.drop-on-section(index); }
        }
        VerticalLayout {
            TopBar {
                visible: !root.page-covered;
                can-go-back: root.can-go-back;
                can-go-forward: root.can-go-forward;
                searchable: false;
                menu: !root.docked;
                phone: root.phone;
                back => { root.back(); }
                forward => { root.forward(); }
                open-menu => { root.sidebar-open = true; }
                settings => { root.open("settings"); }
                account => { root.open("account"); }
            }
            // A table page's heading, filter and the table's headings stay
            // put while the rows scroll, and follow them sideways. A
            // folder's or tag's heading is its name; a tag's menu goes
            // beside it, and the tags under it below it.
            if root.table: VerticalLayout {
                visible: !root.page-covered;
                vertical-stretch: 0;
                padding-top: 8px;
                spacing: 12px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    Heading {
                        horizontal-stretch: 1;
                        text: root.page == Page.compositions ? "Compositions" : root.page == Page.folders || root.page == Page.tag ? root.header-title : "Tracks";
                        vertical-alignment: center;
                    }
                    if root.page == Page.tag: MoreMenu {
                        cross-axis-self-alignment: center;
                        label: "Tag";
                        opening => {
                            self.entries = [
                                { id: "new", label: "New tag in it", icon: Icons.plus },
                                { id: "rename", label: "Rename", icon: Icons.pencil },
                            ];
                            if root.move-targets.length > 0 {
                                self.entries.push({ id: "move", label: "Move to", icon: Icons.tag, choices: root.move-targets });
                            }
                            self.entries.push({ id: "delete", label: "Delete", icon: Icons.trash, danger: true });
                        }
                        activated(id, choice) => {
                            if id == "new" {
                                root.ask-tag(Asking.new-tag, root.shown-id, "");
                            } else if id == "rename" {
                                root.ask-tag(Asking.rename-tag, root.shown-id, root.header-title);
                            } else if id == "move" {
                                root.move-tag(root.shown-id, choice);
                            } else {
                                root.ask-tag(Asking.delete-tag, root.shown-id, root.header-title);
                            }
                        }
                    }
                    if root.can-play && root.page != Page.compositions && root.songs-listed: PlayButton {
                        horizontal-stretch: 0;
                        enabled: !Input.modal;
                        play => { root.play-tracks(0); }
                        queue(how) => { root.queue-page(how); }
                    }
                    if root.page == Page.tracks && root.width - root.sidebar-width >= 600px: Filter {
                        what: "tracks";
                        horizontal-stretch: 0;
                        text <=> root.track-filter;
                        edited => { root.filter-tracks(); }
                    }
                    if root.page == Page.compositions && root.width - root.sidebar-width >= 600px: Filter {
                        what: "compositions";
                        horizontal-stretch: 0;
                        text <=> root.composition-filter;
                        edited => { root.filter-compositions(); }
                    }
                    if (root.page == Page.folders || root.page == Page.tag) && root.width - root.sidebar-width >= 600px: Filter {
                        what: "tracks";
                        horizontal-stretch: 0;
                        text <=> root.folder-filter;
                        edited => { root.filter-folders(); }
                    }
                    Button {
                        horizontal-stretch: 0;
                        cross-axis-self-alignment: center;
                        text: "Columns";
                        enabled: !Input.modal;
                        accessible-expandable: true;
                        accessible-expanded: columns.is-open;
                        clicked => { columns.show(); }
                    }
                }
                if root.page == Page.tag && root.header-names.length > 0: HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    Links {
                        names: root.header-names;
                        open(link) => { root.open(link); }
                    }
                }
                if root.width - root.sidebar-width < 600px: HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    if root.page == Page.tracks: Filter {
                        what: "tracks";
                        text <=> root.track-filter;
                        edited => { root.filter-tracks(); }
                    }
                    if root.page == Page.compositions: Filter {
                        what: "compositions";
                        text <=> root.composition-filter;
                        edited => { root.filter-compositions(); }
                    }
                    if root.page == Page.folders || root.page == Page.tag: Filter {
                        what: "tracks";
                        text <=> root.folder-filter;
                        edited => { root.filter-folders(); }
                    }
                }
                Rectangle {
                    height: header.height;
                    clip: true;
                    background: Palette.background;
                    // Cut off where the rows are, at the page's edges.
                    header := TrackHeader {
                        x: scroll.content-x + 24px;
                        width: stage.width - 48px;
                        columns: root.track-columns;
                        sort(index) => {
                            scroll.content-y = 0;
                            root.sort-tracks(index);
                        }
                    }
                }
                columns := PopupWindow {
                    x: parent.width - self.width - 24px;
                    y: 52px;
                    width: 260px;
                    height: min(420px, root.height - 120px);
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    Rectangle {
                        background: Palette.background;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.hover;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: #0000004d;
                        choices := ScrollView {
                            content-width: self.visible-width;
                            content-height: picks.preferred-height;
                            picks := VerticalLayout {
                                width: choices.visible-width;
                                padding: 12px;
                                spacing: 4px;
                                for choice[i] in root.track-choices: CheckBox {
                                    text: choice.title;
                                    checked: choice.shown;
                                    toggled => { root.toggle-track-column(i); }
                                }
                            }
                        }
                    }
                }
            }
            scroll := PageScroll {
                visible: !root.page-covered;
                active: !root.now-playing-open;
                visit: root.visit;
                arrival: root.arrival;
                can-go-back: root.can-go-back;
                can-go-forward: root.can-go-forward;
                accessible-label: root.page-name;
                back => { root.back(); }
                forward => { root.forward(); }
                refresh => { root.refresh(); }
                escape => {
                    if root.selected-tiles > 0 {
                        root.clear-selection();
                    }
                }
                open-ended: (root.page == Page.albums || root.page == Page.artists || root.page == Page.composers || root.page == Page.stations || root.table) && root.more-tiles && root.page-problem == "";
                near-end => {
                    if self.open-ended && !root.loading {
                        root.show-more();
                    }
                }
                content-width: max(scroll.visible-width, stage.width);
                // As far as the page's elements are drawn. Its preferred
                // height falls short on a phone: Slint 1.18 measures some
                // sections there with their text on fewer lines than it
                // draws them, and lays them out overflowing it.
                content-height: end.y - stage.spacing + stage.padding-bottom;
                stage := VerticalLayout {
                    // Set, so the content height doesn't depend on itself;
                    // and at the top, where a set height would centre it.
                    y: 0;
                    height: self.preferred-height;
                    // At most 1600px wide and centred, but for a table,
                    // which is wider than the page when its columns don't
                    // fit.
                    x: max(0px, (scroll.visible-width - self.width) / 2);
                    // A phone's menu buttons are wider than browse.rs counts,
                    // and its columns don't narrow.
                    width: root.table ? max(scroll.visible-width, (Screen.phone ? root.track-table-width + 12px : root.track-table-least) + 48px) : min(scroll.visible-width, 1600px);
                    padding: 24px;
                    padding-top: 8px;
                    // Room to scroll the last tiles out from under the bar.
                    padding-bottom: root.selected-tiles > 0 ? 96px : 24px;
                    spacing: 24px;
                    alignment: start;

                    if root.offline != "": VerticalLayout {
                        spacing: 8px;
                        Problem { text: root.offline; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Try again";
                                enabled: !Input.modal;
                                clicked => { root.reconnect(); }
                            }
                        }
                    }
                    // The library at a glance, its newest albums sliding by.
                    if root.page == Page.home: Heading { text: root.username == "" ? "Welcome" : "Welcome, " + root.username; }
                    if root.page == Page.home: StatCards {
                        stats: root.stats;
                        open(link) => { root.open(link); }
                    }
                    if root.page == Page.home && root.tiles.length > 0: CoverShelf {
                        title: "Recently added";
                        tiles: root.tiles;
                        entries: root.can-play ? root.queue-entries : [];
                        activated(index, id) => { root.queue-link(root.tiles[index].link, id); }
                        open(link) => { root.open(link); }
                        in-view(first, last) => { root.tiles-in-view(first, last); }
                        selecting: root.selected-tiles > 0;
                        select(index, range) => { root.select-tile(index, range); }
                    }
                    if root.page == Page.home && root.saved-stations.length > 0: CoverShelf {
                        title: "Saved stations";
                        tiles: root.saved-stations;
                        more: true;
                        see-all => { root.open("radio"); }
                    }
                    // The filter and sort controls go beside the heading, or
                    // under it in two rows when the page is too narrow.
                    if root.page == Page.albums: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Heading {
                                horizontal-stretch: 1;
                                text: "Albums";
                                vertical-alignment: center;
                            }
                            if scroll.visible-width >= 600px: AlbumControls {
                                horizontal-stretch: 0;
                                filter <=> root.album-filter;
                                sort <=> root.album-sort;
                                descending <=> root.album-descending;
                                filter-edited => { root.filter-albums(); }
                                sort-selected => { root.sort-albums(); }
                            }
                        }
                        if scroll.visible-width < 600px: AlbumControls {
                            stacked: true;
                            filter <=> root.album-filter;
                            sort <=> root.album-sort;
                            descending <=> root.album-descending;
                            filter-edited => { root.filter-albums(); }
                            sort-selected => { root.sort-albums(); }
                        }
                        if root.header-title != "": GenreFilter {
                            genre: root.header-title;
                            all: "albums";
                            open(link) => { root.open(link); }
                        }
                    }
                    // Its filter too goes under the heading when narrow.
                    if root.page == Page.artists: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Heading {
                                horizontal-stretch: 1;
                                text: "Artists";
                                vertical-alignment: center;
                            }
                            if scroll.visible-width >= 600px: Filter {
                                what: "artists";
                                horizontal-stretch: 0;
                                text <=> root.artist-filter;
                                edited => { root.filter-artists(); }
                            }
                        }
                        if scroll.visible-width < 600px: Filter {
                            what: "artists";
                            text <=> root.artist-filter;
                            edited => { root.filter-artists(); }
                        }
                        if root.header-title != "": GenreFilter {
                            genre: root.header-title;
                            all: "artists";
                            open(link) => { root.open(link); }
                        }
                    }
                    if root.page == Page.composers: FilterHeading {
                        title: "Composers";
                        narrow: scroll.visible-width < 600px;
                        filter <=> root.composer-filter;
                        edited => { root.filter-composers(); }
                    }
                    // The playlists at the top level or in a folder, with a
                    // menu to make more there and, in a folder, to change it.
                    if root.page == Page.playlists: HorizontalLayout {
                        spacing: 8px;
                        Heading {
                            horizontal-stretch: 1;
                            text: root.header-title;
                            vertical-alignment: center;
                        }
                        MoreMenu {
                            cross-axis-self-alignment: center;
                            label: root.shown-id == "" ? "Playlists" : "Folder";
                            opening => {
                                self.entries = [{ id: "new", label: "New playlist", icon: Icons.plus }];
                                if root.folders-offered {
                                    self.entries.push({ id: "folder", label: "New folder", icon: Icons.folder });
                                }
                                if root.shown-id != "" {
                                    self.entries.push({ id: "rename", label: "Rename", icon: Icons.pencil });
                                    if root.move-targets.length > 0 {
                                        self.entries.push({ id: "move", label: "Move to", icon: Icons.folder, choices: root.move-targets });
                                    }
                                    self.entries.push({ id: "delete", label: "Delete", icon: Icons.trash, danger: true });
                                }
                            }
                            activated(id, choice) => {
                                if id == "new" {
                                    root.ask(Asking.new-playlist);
                                } else if id == "folder" {
                                    root.ask(Asking.new-folder);
                                } else if id == "rename" {
                                    root.ask(Asking.rename-folder);
                                } else if id == "move" {
                                    root.move-folder(choice);
                                } else {
                                    root.ask(Asking.delete-folder);
                                }
                            }
                        }
                    }
                    if root.page == Page.album || root.page == Page.artist || root.page == Page.playlist || root.page == Page.composer || root.page == Page.composition || root.page == Page.track: PageHeader {
                        artwork: root.header-image;
                        round: root.page == Page.artist || root.page == Page.composer;
                        kind: root.page == Page.artist ? "Artist" : root.page == Page.playlist ? "Playlist" : root.page == Page.composer ? "Composer" : root.page == Page.composition ? "Composition" : root.page == Page.track ? "Track" : "Album";
                        title: root.header-title;
                        names: root.header-names;
                        facts: root.header-facts;
                        open(link) => { root.open(link); }
                        if root.can-play && (((root.page == Page.album || root.page == Page.playlist) && root.tracks.length > 0) || (root.page == Page.artist && root.tiles.length > 0)): PlayButton {
                            enabled: !Input.modal;
                            // An artist's songs on their page are their top ones; Play is all their own albums.
                            play => {
                                if root.page == Page.artist {
                                    root.queue-page("play");
                                } else {
                                    root.play-tracks(0);
                                }
                            }
                            queue(how) => { root.queue-page(how); }
                        }
                        if root.can-download && root.may-download && (root.page == Page.album || root.page == Page.playlist) && root.tracks.length > 0: DownloadButton {
                            state: root.download-state;
                            progress: root.download-progress;
                            clicked => {
                                if root.download-state == 0 {
                                    root.download-page();
                                } else {
                                    root.ask(Asking.remove-download);
                                }
                            }
                        }
                        // Any playlist can go in a folder, read-only too.
                        if root.page == Page.playlist && (root.playlist-editable || root.move-targets.length > 0): MoreMenu {
                            label: "Playlist";
                            opening => {
                                self.entries = [];
                                if root.page == Page.playlist && root.playlist-editable {
                                    self.entries.push({ id: "rename", label: "Rename", icon: Icons.pencil });
                                }
                                if root.page == Page.playlist && root.move-targets.length > 0 {
                                    self.entries.push({ id: "move", label: "Move to folder", icon: Icons.folder, choices: root.move-targets });
                                }
                                if root.page == Page.playlist && root.playlist-editable {
                                    self.entries.push({ id: "delete", label: "Delete", icon: Icons.trash, danger: true });
                                }
                            }
                            activated(id, choice) => {
                                if id == "move" {
                                    root.move-playlist(choice);
                                } else {
                                    root.ask(id == "rename" ? Asking.rename-playlist : Asking.delete-playlist);
                                }
                            }
                        }
                    }
                    // A genre's banner with its name over it, then the genres it
                    // sits under and how much the library has of it.
                    if root.page == Page.genre: VerticalLayout {
                        spacing: 8px;
                        GenreBanner {
                            height: Screen.phone ? 200px : 320px * Theme.zoom;
                            picture: root.genre-banner;
                            name: root.header-title;
                            name-size: Screen.phone ? 28px * Theme.zoom : 40px * Theme.zoom;
                        }
                        if root.header-names.length > 0: Links {
                            names: root.header-names;
                            font-size: Theme.body;
                            text-color: Theme.text;
                            open(link) => { root.open(link); }
                        }
                        if root.header-facts != "": Text {
                            text: root.header-facts;
                            font-size: Theme.body;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                    // Each value at the width it has, so one that wraps
                    // measures all its lines.
                    if root.page == Page.track: about := VerticalLayout {
                        property <length> value-width: min(scroll.visible-width, 1600px) - 48px - 156px;
                        spacing: 8px;
                        for detail in root.details: HorizontalLayout {
                            spacing: 16px;
                            Text {
                                width: 140px;
                                text: detail.label;
                                font-size: Theme.body;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            if detail.names.length == 1 && detail.names[0].link == "": Text {
                                preferred-width: about.value-width;
                                horizontal-stretch: 1;
                                text: detail.names[0].label;
                                font-size: Theme.body;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            if detail.names.length > 1 || detail.names[0].link != "": Links {
                                preferred-width: about.value-width;
                                horizontal-stretch: 1;
                                names: detail.names;
                                text-color: Theme.text;
                                open(link) => { root.open(link); }
                            }
                        }
                    }
                    // An artist's biography or an album's notes, the start
                    // until opened, at the width it has so it wraps. In a
                    // HorizontalLayout, which measures it at its 800px most
                    // where a VerticalLayout would at its own whole width.
                    if (root.page == Page.artist || root.page == Page.album || root.page == Page.genre) && root.about != "": VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: start;
                            Text {
                                preferred-width: min(scroll.visible-width - 48px, 800px);
                                max-width: 800px;
                                text: root.about-open ? root.about : root.about-short;
                                font-size: Theme.body;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                        if root.about-short != root.about: HorizontalLayout {
                            alignment: start;
                            Link {
                                text: root.about-open ? "Less" : "More";
                                font-weight: 600;
                                clicked => { root.about-open = !root.about-open; }
                            }
                        }
                        // As the text's licence asks: where it comes from.
                        if root.about-source != "": HorizontalLayout {
                            alignment: start;
                            spacing: 4px;
                            Text {
                                text: "Source:";
                                font-size: Theme.small;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            if root.about-url != "": Link {
                                text: root.about-source;
                                font-size: Theme.small;
                                clicked => { Platform.open-url(root.about-url); }
                            }
                            if root.about-url == "": Text {
                                text: root.about-source;
                                font-size: Theme.small;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // An artist's top tracks, the artists like them, and a
                    // heading over their albums when the page has more.
                    if root.page == Page.artist && root.tracks.length > 0: Text {
                        text: "Top tracks";
                        font-size: Theme.heading;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    if root.page == Page.album || root.page == Page.playlist || root.page == Page.artist: VerticalLayout {
                        for track[row] in root.tracks: VerticalLayout {
                            if track.work != "": TrackRow {
                                title: track.work;
                                names: track.work-names;
                                split: track.work-split;
                                duration: track.work-duration;
                                years: track.work-years;
                                performed: track.work-performed;
                                lovable: false;
                                strong: true;
                                playable: root.can-play;
                                open(link) => { root.open(link); }
                                play => { root.play-tracks(row); }
                                queue(next) => { root.queue-tracks(row, track.work-tracks, next); }
                            }
                            TrackRow {
                                title: track.title;
                                names: track.names;
                                split: track.split;
                                duration: track.duration;
                                loved: track.loved;
                                years: track.years;
                                performed: track.performed;
                                strong: track.alone;
                                part: track.part;
                                downloaded: track.downloaded;
                                playlists: root.playlist-targets;
                                removable: root.page == Page.playlist && root.playlist-editable;
                                taggable: root.tags-offered;
                                playable: root.can-play;
                                downloadable: root.can-download && root.may-download;
                                download-removable: track.downloaded-alone;
                                open(link) => { root.open(link); }
                                play => { root.play-tracks(row); }
                                download => { root.download-track(row); }
                                remove-download => { root.remove-track-download(row); }
                                queue(next) => { root.queue-tracks(row, 1, next); }
                                add-to-playlist(id) => { root.add-track-to-playlist(row, id); }
                                remove => { root.remove-from-playlist(row); }
                                toggle-love => { root.toggle-love(row); }
                                tag => {
                                    root.tag-track(row);
                                    root.ask(Asking.tag-songs);
                                }
                            }
                        }
                    }
                    if root.page == Page.artist && root.similar.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Similar artists";
                            font-size: Theme.heading;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Links {
                            preferred-width: min(scroll.visible-width, 1600px) - 48px;
                            names: root.similar;
                            text-color: Theme.text;
                            open(link) => { root.open(link); }
                        }
                    }
                    // A genre's albums, artists and popular radio stations
                    // sliding by, each with all of them behind "See all",
                    // then its subgenres.
                    if root.page == Page.genre && root.tiles.length > 0: CoverShelf {
                        title: "Albums";
                        tiles: root.tiles;
                        more: true;
                        see-all => { root.open("albums:" + root.header-title); }
                        entries: root.can-play ? root.queue-entries : [];
                        activated(index, id) => { root.queue-link(root.tiles[index].link, id); }
                        open(link) => { root.open(link); }
                        in-view(first, last) => { root.tiles-in-view(first, last); }
                        selecting: root.selected-tiles > 0;
                        select(index, range) => { root.select-tile(index, range); }
                    }
                    if root.page == Page.genre && root.genre-artists.length > 0: CoverShelf {
                        title: "Artists";
                        tiles: root.genre-artists;
                        round: true;
                        more: true;
                        see-all => { root.open("artists:" + root.header-title); }
                        open(link) => { root.open(link); }
                    }
                    if root.page == Page.genre && root.genre-radio.tiles.length > 0: CoverShelf {
                        title: root.genre-radio.title;
                        tiles: root.genre-radio.tiles;
                        more: true;
                        entries: root.may-administer ? [{ id: "save", label: "Save", icon: Icons.plus }] : [];
                        see-all => { root.open(root.genre-radio.link); }
                        activated(index) => { root.save-station(root.genre-radio.shelf, index); }
                        in-view(first, last) => { root.station-shelf-in-view(root.genre-radio.shelf, first, last); }
                    }
                    if root.page == Page.genre && root.genre-tiles.length > 0: Text {
                        text: "Subgenres";
                        font-size: Theme.heading;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    if root.page == Page.genre && root.genre-tiles.length > 0: GenreGrid {
                        tiles: root.genre-tiles;
                        open(link) => { root.open(link); }
                    }
                    if root.page == Page.artist && (root.tracks.length > 0 || root.similar.length > 0) && root.tiles.length > 0: Text {
                        text: "Albums";
                        font-size: Theme.heading;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    if root.page == Page.downloads: Heading { text: "Downloads"; }
                    if root.page == Page.downloads && root.tiles.length == 0 && root.tracks.length == 0: Note { text: "Nothing is downloaded yet."; }
                    if root.page == Page.albums || root.page == Page.artists || root.page == Page.playlists || root.page == Page.artist || root.page == Page.composers || root.page == Page.downloads: CoverGrid {
                        tiles: root.tiles;
                        round: root.page == Page.artists || root.page == Page.composers;
                        view-top: -scroll.content-y - self.y;
                        view-height: scroll.visible-height;
                        open(link) => { root.open(link); }
                        in-view(first, last) => { root.tiles-in-view(first, last); }
                        selecting: root.selected-tiles > 0;
                        select(index, range) => { root.select-tile(index, range); }
                        movable: root.page == Page.playlists && root.folders-offered;
                        downloadable: root.can-download && root.may-download && root.page != Page.artists && root.page != Page.composers;
                        entries: root.tile-entries;
                        activated(index, id, choice) => {
                            if id == "move" {
                                root.move-tile(index, choice);
                            } else if id == "download" {
                                root.download-link(root.tiles[index].link);
                            } else if id == "remove-download" {
                                root.remove-link-download(root.tiles[index].link);
                            } else {
                                root.queue-link(root.tiles[index].link, id);
                            }
                        }
                        dropped(index) => { root.drop-on-tile(index); }
                    }
                    // The songs kept on their own, under the albums and
                    // playlists kept.
                    if root.page == Page.downloads && root.tracks.length > 0: Text {
                        text: "Songs";
                        font-size: Theme.heading;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    if root.page == Page.downloads: VerticalLayout {
                        for track[row] in root.tracks: TrackRow {
                            title: track.title;
                            names: track.names;
                            split: track.split;
                            duration: track.duration;
                            lovable: false;
                            downloaded: track.downloaded;
                            playable: root.can-play;
                            downloadable: root.can-download && root.may-download;
                            download-removable: track.downloaded-alone;
                            open(link) => { root.open(link); }
                            play => { root.play-tracks(row); }
                            queue(next) => { root.queue-tracks(row, 1, next); }
                            remove-download => { root.remove-track-download(row); }
                        }
                    }
                    // The library's genres, each opening its page.
                    if root.page == Page.genres: Heading { text: "Genres"; }
                    if root.page == Page.genres: GenreGrid {
                        tiles: root.genre-tiles;
                        open(link) => { root.open(link); }
                    }
                    // A genre of the radio directory, most votes first.
                    if root.page == Page.stations: Heading { text: root.header-title; }
                    if root.page == Page.stations: CoverGrid {
                        tiles: root.tiles;
                        view-top: -scroll.content-y - self.y;
                        view-height: scroll.visible-height;
                        entries: root.may-administer ? [{ id: "save", label: "Save", icon: Icons.plus }] : [];
                        activated(index) => { root.save-station(-1, index); }
                        in-view(first, last) => { root.tiles-in-view(first, last); }
                    }
                    if root.table: VerticalLayout {
                        // The rows on screen and a screen below, by
                        // TrackLineRow's height, whose covers to fetch.
                        property <length> view-top: -scroll.content-y - self.y;
                        property <int> first-in-view: max(0, floor(self.view-top / (54px * Theme.zoom)));
                        property <int> last-in-view: min(root.track-lines.length, floor((self.view-top + 2 * scroll.visible-height) / (54px * Theme.zoom)) + 1) - 1;
                        init => {
                            root.tiles-in-view(self.first-in-view, self.last-in-view);
                        }
                        changed first-in-view => {
                            root.tiles-in-view(self.first-in-view, self.last-in-view);
                        }
                        changed last-in-view => {
                            root.tiles-in-view(self.first-in-view, self.last-in-view);
                        }
                        for line[row] in root.track-lines: TrackLineRow {
                            columns: root.track-columns;
                            line: line;
                            striped: mod(row, 2) == 1;
                            selecting: root.selected-tiles > 0;
                            joined-above: row > 0 && root.track-lines[row - 1].selected;
                            joined-below: row + 1 < root.track-lines.length && root.track-lines[row + 1].selected;
                            // A composition is no song to add or tag.
                            playlists: root.page == Page.compositions ? root.no-names : root.playlist-targets;
                            taggable: root.tags-offered && root.page != Page.compositions;
                            playable: root.can-play && root.page != Page.compositions;
                            open(link) => { root.open(link); }
                            play => { root.play-tracks(row); }
                            queue(next) => { root.queue-tracks(row, 1, next); }
                            toggle-love => { root.toggle-line-love(row); }
                            select(range) => { root.select-line(row, range); }
                            add-to-playlist(id) => { root.add-line-to-playlist(row, id); }
                            tag => {
                                root.tag-line(row);
                                root.ask(Asking.tag-songs);
                            }
                        }
                    }
                    // A composer's compositions or a composition's
                    // performances, each a row that opens its page. A
                    // composition is a strong row, as a work is on an album.
                    if root.page == Page.composer || root.page == Page.composition: VerticalLayout {
                        for track in root.tracks: TrackRow {
                            title: track.title;
                            names: track.names;
                            split: track.split;
                            duration: track.duration;
                            years: track.years;
                            performed: track.performed;
                            strong: root.page != Page.composition;
                            lovable: false;
                            enabled: track.link != "";
                            clicked => { root.open(track.link); }
                            open(link) => { root.open(link); }
                        }
                    }
                    if ((root.page == Page.albums && root.album-filter != "") || (root.page == Page.artists && root.artist-filter != "") || (root.page == Page.composers && root.composer-filter != "")) && root.tiles.length == 0 && !root.loading && root.page-problem == "": Note {
                        text: root.page == Page.artists ? "No artists match." : root.page == Page.composers ? "No composers match." : "No albums match.";
                    }
                    if root.page == Page.compositions && root.track-lines.length == 0 && !root.more-tiles && !root.loading && root.page-problem == "": Note { text: root.composition-filter != "" ? "No compositions match." : "No compositions yet."; }
                    if root.page == Page.playlists && root.tiles.length == 0 && !root.loading && root.page-problem == "": Note { text: "No playlists yet."; }
                    if root.page == Page.genres && root.genre-tiles.length == 0 && !root.loading && root.page-problem == "": Note { text: "No genres yet."; }
                    if root.page == Page.tracks && root.track-lines.length == 0 && !root.more-tiles && !root.loading && root.page-problem == "": Note { text: root.track-filter != "" ? "No tracks match." : "No tracks yet."; }
                    if root.page == Page.folders && root.track-lines.length == 0 && !root.more-tiles && !root.loading && root.page-problem == "": Note { text: root.folder-filter != "" ? "Nothing here matches." : "This folder is empty."; }
                    if root.page == Page.tag && root.track-lines.length == 0 && !root.more-tiles && !root.loading && root.page-problem == "": Note { text: root.folder-filter != "" ? "No tracks match." : "No tracks have this tag yet."; }
                    if root.page-problem != "": Problem { text: root.page-problem; }
                    if (root.page == Page.home || root.page == Page.radio || root.page == Page.tags || root.page == Page.genres || root.page == Page.genre || ((root.page == Page.albums || root.page == Page.artists || root.page == Page.playlists || root.page == Page.composers || root.page == Page.stations || root.table) && (root.more-tiles || root.tiles.length == 0))) && root.page-problem != "" && !root.loading: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Try again";
                            enabled: !Input.modal;
                            clicked => { root.show-more(); }
                        }
                    }
                    if root.loading: Note { text: "Loading…"; }
                    if root.page == Page.account: VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Account"; }
                        Text {
                            text: root.server-name == "" ? root.address : root.server-name + " at " + root.address;
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        Text {
                            text: root.signed-in;
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        if root.roles != "": Text {
                            text: "Roles: " + root.roles;
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        Text {
                            text: root.listenbrainz-user == "" ? "ListenBrainz not connected" : "ListenBrainz: " + root.listenbrainz-user;
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        if root.saved-note != "": Note {
                            text: root.saved-note;
                            font-size: Theme.body;
                        }
                        if root.problem != "": Problem {
                            text: root.problem;
                            font-size: Theme.body;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: root.sign-out-frees == "" ? "Sign out" : "Sign out and free " + root.sign-out-frees;
                                enabled: !root.busy && !Input.modal;
                                clicked => { root.sign-out(); }
                            }
                            Button {
                                text: "Change password";
                                enabled: !root.busy && !Input.modal;
                                clicked => { root.open-dialog(Asking.own-password); }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Change server";
                                enabled: !root.busy && !Input.modal;
                                clicked => { root.change-server(); }
                            }
                        }
                    }
                    // The settings: the server's scan of its libraries, which only
                    // its admins may start.
                    if root.page == Page.settings: VerticalLayout {
                        max-width: 480px;
                        spacing: 4px;
                        Heading { text: "Settings"; }
                        SettingsRow {
                            icon: Icons.album;
                            title: "Library";
                            summary: "Have the server scan its libraries";
                            clicked => { root.open("setting:library"); }
                        }
                        SettingsRow {
                            icon: Icons.key;
                            title: "ListenBrainz";
                            summary: "The token that connects your ListenBrainz account";
                            clicked => { root.open("setting:listenbrainz"); }
                        }
                        if root.can-play: SettingsRow {
                            icon: Icons.play;
                            title: "Playback";
                            summary: "Leveling and streaming quality";
                            clicked => { root.open("setting:playback"); }
                        }
                        if root.can-download: SettingsRow {
                            icon: Icons.download;
                            title: "Downloads";
                            summary: "Music kept on this device, and the space it takes";
                            clicked => { root.open("setting:downloads"); }
                        }
                        if root.can-play: SettingsRow {
                            icon: Icons.sound;
                            title: "Sound processing";
                            summary: "Headroom, crossfeed, upsampling and EQ";
                            clicked => { root.open("setting:sound"); }
                        }
                    }
                    if root.page == Page.setting && root.shown-id == "listenbrainz": VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "ListenBrainz"; }
                        Text {
                            text: root.listenbrainz-user == "" ? "No token is set." : "A token is set, for " + root.listenbrainz-user + ". It stays when you sign out.";
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        LineEdit {
                            placeholder-text: "User token";
                            accessible-label: "ListenBrainz user token";
                            input-type: InputType.password;
                            text <=> root.listenbrainz-token;
                            enabled: !root.busy && !Input.modal;
                            accepted => { root.connect-listenbrainz(); }
                        }
                        if root.problem != "": Problem {
                            text: root.problem;
                            font-size: Theme.body;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: root.listenbrainz-user == "" ? "Set token" : "Replace token";
                                enabled: !root.busy && !Input.modal && root.listenbrainz-token != "";
                                clicked => { root.connect-listenbrainz(); }
                            }
                            Button {
                                text: "Remove token";
                                enabled: !root.busy && !Input.modal && root.listenbrainz-user != "";
                                clicked => { root.remove-listenbrainz(); }
                            }
                        }
                    }
                    if root.page == Page.setting && root.shown-id == "downloads": VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Downloads"; }
                        Text {
                            text: root.download-space;
                            font-size: Theme.body;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if root.download-status != "": Text {
                            text: root.download-status;
                            font-size: Theme.body;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Size limit";
                            font-size: Theme.body;
                            color: Theme.muted;
                        }
                        ComboBox {
                            accessible-label: "Download size limit";
                            // In the order offline.rs's `LIMITS_GB` takes them.
                            model: ["No limit", "1 GB", "5 GB", "10 GB", "25 GB", "50 GB", "100 GB", "250 GB"];
                            current-index <=> root.download-limit;
                            enabled: !Input.modal;
                            selected => { root.choose-download-limit(self.current-index); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Remove all downloads";
                                enabled: root.download-songs > 0 && !Input.modal;
                                clicked => { root.open-dialog(Asking.remove-all-downloads); }
                            }
                        }
                    }
                    if root.page == Page.setting && root.shown-id == "library": VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Library"; }
                        if !root.may-administer: Note {
                            text: "Only the server's admins may have it scan the library.";
                            font-size: Theme.body;
                        }
                        if root.may-administer && root.scan-status != "": Text {
                            text: root.scan-status;
                            wrap: word-wrap;
                            font-size: Theme.body;
                        }
                        if root.may-administer: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Scan library";
                                enabled: !root.scanning && !Input.modal;
                                clicked => { root.start-scan(); }
                            }
                        }
                    }
                    if root.page == Page.setting && root.shown-id == "playback": VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Playback"; }
                        if root.can-play: Text {
                            text: "Volume leveling";
                            font-size: Theme.body;
                            color: Theme.muted;
                        }
                        if root.can-play: ComboBox {
                            accessible-label: "Volume leveling";
                            // In the order play.rs's `LEVELING` takes them.
                            model: ["Off", "By track", "By album"];
                            current-index <=> root.leveling;
                            enabled: !Input.modal;
                            selected => { root.choose-leveling(self.current-index); }
                        }
                        if root.can-play: QualityPicker {
                            name: root.has-mobile-data ? "Streaming on wifi" : "Streaming";
                            format <=> root.wifi-format;
                            bitrate <=> root.wifi-bitrate;
                            enabled: !Input.modal;
                            chosen(format, bitrate) => { root.choose-stream-quality(false, format, bitrate); }
                        }
                        if root.can-play && root.has-mobile-data: QualityPicker {
                            name: "Streaming on mobile data";
                            format <=> root.mobile-format;
                            bitrate <=> root.mobile-bitrate;
                            enabled: !Input.modal;
                            chosen(format, bitrate) => { root.choose-stream-quality(true, format, bitrate); }
                        }
                    }
                    // Each entry's order is the one sound.rs takes them in.
                    if root.page == Page.setting && root.shown-id == "sound": VerticalLayout {
                        max-width: 480px;
                        spacing: 12px;
                        Heading { text: "Sound processing"; }
                        if root.can-play: Text {
                            text: "Headroom, to leave room for the EQ's boosts";
                            font-size: Theme.body;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        if root.can-play: ComboBox {
                            accessible-label: "Headroom";
                            model: ["None", "−1 dB", "−2 dB", "−3 dB", "−4.5 dB", "−6 dB", "−9 dB", "−12 dB"];
                            current-index <=> root.headroom;
                            enabled: !Input.modal;
                            selected => { root.choose-headroom(self.current-index); }
                        }
                        if root.can-play: Text {
                            text: "Crossfeed, for headphones";
                            font-size: Theme.body;
                            color: Theme.muted;
                        }
                        if root.can-play: ComboBox {
                            accessible-label: "Crossfeed";
                            model: ["Off", "Light", "Medium", "Strong"];
                            current-index <=> root.crossfeed;
                            enabled: !Input.modal;
                            selected => { root.choose-crossfeed(self.current-index); }
                        }
                        if root.can-play: Text {
                            text: "Upsampling";
                            font-size: Theme.body;
                            color: Theme.muted;
                        }
                        if root.can-play: ComboBox {
                            accessible-label: "Upsampling";
                            model: ["Off", "To the highest multiple of the file's rate"];
                            current-index <=> root.upsampling;
                            enabled: !Input.modal;
                            selected => { root.choose-upsampling(self.current-index); }
                        }
                        if root.can-play: Switch {
                            text: "Parametric EQ";
                            checked <=> root.eq-on;
                            enabled: !Input.modal;
                            toggled => { root.toggle-eq(self.checked); }
                        }
                        if root.can-play && root.eq-on: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Headphone presets";
                                enabled: !Input.modal;
                                clicked => {
                                    root.open("setting:headphones");
                                    root.open-headphones();
                                }
                            }
                        }
                        if root.can-play && root.eq-on: HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                horizontal-stretch: 1;
                                accessible-label: "EQ preset";
                                model: root.eq-presets;
                                current-index <=> root.eq-preset;
                                enabled: !Input.modal;
                                selected => { root.choose-eq-preset(self.current-index); }
                            }
                            MoreMenu {
                                cross-axis-self-alignment: center;
                                label: "EQ presets";
                                opening => {
                                    self.entries = [{ id: "save", label: "Save as preset", icon: Icons.plus }];
                                    if root.eq-preset > 0 {
                                        self.entries.push({ id: "delete", label: "Delete preset", icon: Icons.trash, danger: true });
                                    }
                                    self.entries.push({ id: "import", label: "Paste AutoEQ settings", icon: Icons.pencil });
                                }
                                activated(id) => {
                                    if id == "save" {
                                        root.asked-name = root.eq-preset > 0 ? root.eq-presets[root.eq-preset] : "";
                                        root.open-dialog(Asking.save-eq-preset);
                                    } else if id == "delete" {
                                        root.delete-eq-preset();
                                    } else {
                                        root.open-dialog(Asking.import-eq);
                                    }
                                }
                            }
                        }
                        if root.can-play && root.eq-on: EqGraph {
                            points: root.eq-points;
                            grid: root.eq-grid;
                            curve: root.eq-curve;
                            selected <=> root.eq-selected;
                            enabled: !Input.modal;
                            picked-name: root.eq-selected < 0 || root.eq-selected >= root.eq-bands.length ? "" : "Band " + (root.eq-selected + 1) + ", " + root.eq-bands[root.eq-selected].frequency + " Hz" + (root.eq-bands[root.eq-selected].filter < 3 ? ", " + root.eq-bands[root.eq-selected].gain + " dB" : "");
                            added(x, y) => { root.add-band-at(x, y); }
                            moved(row, x, y) => { root.move-band(row, x, y); }
                            released => { root.release-band(); }
                            removed(row) => { root.remove-band(row); }
                        }
                        if root.can-play && root.eq-on: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Preamp, dB";
                                font-size: Theme.small;
                                color: Theme.muted;
                            }
                            LineEdit {
                                text <=> root.eq-preamp;
                                accessible-label: "EQ preamp in dB";
                                enabled: !Input.modal;
                                edited(text) => { root.edit-preamp(text); }
                            }
                        }
                        if root.can-play && root.eq-on: VerticalLayout {
                            spacing: 16px;
                            for line[row] in root.eq-bands: EqBandRow {
                                number: row + 1;
                                line: line;
                                selected: row == root.eq-selected;
                                enabled: !Input.modal;
                                edited(line) => {
                                    root.eq-selected = row;
                                    root.edit-band(row, line);
                                }
                                remove => { root.remove-band(row); }
                            }
                        }
                        if root.can-play && root.eq-on: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add band";
                                enabled: !Input.modal;
                                clicked => { root.add-band(); }
                            }
                        }
                    }
                    // OPRA's headphone presets: search for a headphone, and load
                    // one of its presets into the EQ. Each preset names who made
                    // it above OPRA, which distributes it; both as OPRA asks.
                    if root.page == Page.setting && root.shown-id == "headphones": VerticalLayout {
                        max-width: 560px;
                        spacing: 12px;
                        Heading { text: "Headphone presets"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Image {
                                width: 72px;
                                height: 28px;
                                source: @image-url("../data/opra-logo.png");
                                image-fit: contain;
                                colorize: Theme.text;
                                accessible-role: image;
                                accessible-label: "OPRA";
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "OPRA is an open, community-maintained directory of headphone EQ curves.";
                                font-size: Theme.small;
                                color: Theme.muted;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Link {
                                text: "github.com/opra-project/OPRA";
                                font-size: Theme.small;
                                clicked => { Platform.open-url("https://github.com/opra-project/OPRA"); }
                            }
                        }
                        Filter {
                            what: "headphones";
                            placeholder-text: "Brand or model";
                            text <=> root.headphone-filter;
                            edited(text) => { root.search-headphones(text); }
                        }
                        Note { text: root.headphone-status; }
                        if root.headphone-picked != "": VerticalLayout {
                            spacing: 8px;
                            SectionHeading { text: root.headphone-picked; }
                            for preset[row] in root.headphone-presets: Rectangle {
                                background: Theme.surface;
                                border-radius: Theme.radius;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text {
                                        text: "Preset by " + preset.author;
                                        font-size: Theme.heading;
                                        font-weight: 700;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: preset.details;
                                        font-size: Theme.body;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: preset.summary;
                                        font-size: Theme.small;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                    if preset.problem != "": Problem { text: preset.problem; }
                                    HorizontalLayout {
                                        padding-top: 4px;
                                        alignment: start;
                                        spacing: 16px;
                                        Button {
                                            text: "Load into EQ";
                                            enabled: preset.problem == "" && !Input.modal;
                                            clicked => { root.load-headphone(row); }
                                        }
                                        if preset.link != "": Link {
                                            cross-axis-self-alignment: center;
                                            text: "Source";
                                            clicked => { Platform.open-url(preset.link); }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        Text {
                                            text: "Distributed by";
                                            font-size: Theme.small;
                                            color: Theme.muted;
                                            vertical-alignment: center;
                                        }
                                        Link {
                                            text: "OPRA by Roon";
                                            font-size: Theme.small;
                                            clicked => { Platform.open-url("https://github.com/opra-project/OPRA"); }
                                        }
                                    }
                                }
                            }
                        }
                        for headphone[row] in root.headphone-results: ListRow {
                            title: headphone.title;
                            details: headphone.details;
                            link: "headphone:" + row;
                            open(link) => { root.pick-headphone(row); }
                        }
                    }
                    // Your tags, each under the one it sits in, each opening
                    // its page.
                    if root.page == Page.tags: VerticalLayout {
                        max-width: 800px;
                        spacing: 4px;
                        HorizontalLayout {
                            padding-bottom: 8px;
                            spacing: 8px;
                            Heading {
                                horizontal-stretch: 1;
                                text: "Tags";
                            }
                            Button {
                                text: "New tag";
                                enabled: !Input.modal;
                                clicked => { root.ask-tag(Asking.new-tag, "", ""); }
                            }
                        }
                        for tag in root.tag-rows: ListRow {
                            title: tag.title;
                            link: "tag:" + tag.id;
                            details: tag.details;
                            depth: tag.depth;
                            // All of them when opened; one so it shows.
                            entries: [{ id: "delete", label: "Delete", icon: Icons.trash, danger: true }];
                            open(link) => { root.open(link); }
                            opening => {
                                self.entries = [
                                    { id: "new", label: "New tag in it", icon: Icons.plus },
                                    { id: "rename", label: "Rename", icon: Icons.pencil },
                                ];
                                if tag.targets.length > 0 {
                                    self.entries.push({ id: "move", label: "Move to", icon: Icons.tag, choices: tag.targets });
                                }
                                self.entries.push({ id: "delete", label: "Delete", icon: Icons.trash, danger: true });
                            }
                            activated(id, choice) => {
                                if id == "new" {
                                    root.ask-tag(Asking.new-tag, tag.id, "");
                                } else if id == "rename" {
                                    root.ask-tag(Asking.rename-tag, tag.id, tag.title);
                                } else if id == "move" {
                                    root.move-tag(tag.id, choice);
                                } else {
                                    root.ask-tag(Asking.delete-tag, tag.id, tag.title);
                                }
                            }
                        }
                        if root.tag-rows.length == 0 && !root.loading && root.page-problem == "": Note { text: "No tags yet."; }
                    }
                    // The server's stations, then the radio directory's
                    // genres, each a shelf.
                    if root.page == Page.radio: VerticalLayout {
                        spacing: 24px;
                        // On a narrow page the buttons go under the heading.
                        if scroll.visible-width < 600px: Heading {
                            text: "Radio";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: scroll.visible-width < 600px ? start : stretch;
                            if scroll.visible-width >= 600px: Heading {
                                horizontal-stretch: 1;
                                text: "Radio";
                            }
                            Button {
                                text: "Languages";
                                enabled: !Input.modal;
                                clicked => { languages.show(); }
                            }
                            if root.may-administer: Button {
                                text: "Add station";
                                enabled: !Input.modal;
                                clicked => { root.ask-station(Asking.new-station, { }); }
                            }
                            languages := PopupWindow {
                                x: parent.width - self.width;
                                y: 44px;
                                width: min(260px, parent.width);
                                height: min(420px, root.height - 120px);
                                close-policy: PopupClosePolicy.close-on-click-outside;
                                Rectangle {
                                    background: Palette.background;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.hover;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-offset-y: 4px;
                                    drop-shadow-color: #0000004d;
                                    spoken := ScrollView {
                                        content-width: self.visible-width;
                                        content-height: speaking.preferred-height;
                                        speaking := VerticalLayout {
                                            width: spoken.visible-width;
                                            padding: 12px;
                                            spacing: 4px;
                                            Text {
                                                text: "Stations in these languages come first in each genre.";
                                                preferred-width: spoken.visible-width - 24px;
                                                wrap: word-wrap;
                                                color: Theme.muted;
                                            }
                                            for choice[i] in root.language-choices: CheckBox {
                                                text: choice.title;
                                                checked: choice.shown;
                                                toggled => { root.toggle-language(i); }
                                            }
                                            if root.language-choices.length == 0: Text {
                                                text: "The radio directory hasn't answered yet.";
                                                preferred-width: spoken.visible-width - 24px;
                                                wrap: word-wrap;
                                                color: Theme.muted;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Its tiles and the rows the dialogs fill in from
                        // come from one answer, so they line up.
                        if root.saved-stations.length > 0: CoverShelf {
                            title: "Your stations";
                            tiles: root.saved-stations;
                            entries: root.may-administer ? [
                                { id: "edit", label: "Edit", icon: Icons.pencil },
                                { id: "delete", label: "Delete", icon: Icons.trash, danger: true },
                            ] : [];
                            activated(index, id) => {
                                root.ask-station(id == "edit" ? Asking.edit-station : Asking.delete-station, root.station-rows[index]);
                            }
                        }
                        for shelf in root.station-shelves: CoverShelf {
                            title: shelf.title;
                            tiles: shelf.tiles;
                            more: true;
                            entries: root.may-administer ? [{ id: "save", label: "Save", icon: Icons.plus }] : [];
                            see-all => { root.open(shelf.link); }
                            activated(index) => { root.save-station(shelf.shelf, index); }
                            in-view(first, last) => { root.station-shelf-in-view(shelf.shelf, first, last); }
                        }
                    }
                    // Where the page ends, for its content height.
                    end := Rectangle { height: 0; }
                }
            }
            // Escape closes the sheet from the bar's controls too.
            if root.can-play && root.playing: FocusScope {
                visible: !root.phone || !root.page-covered;
                height: root.player-bar-height;
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Escape && root.now-playing-open {
                        root.close-now-playing();
                        return accept;
                    }
                    reject
                }
                PlayerBar {
                    width: parent.width;
                    height: parent.height;
                    cover: root.playing-cover;
                    title: root.playing-title;
                    names: root.playing-names;
                    paused: root.playing-paused;
                    position: root.playing-position;
                    duration: root.playing-duration;
                    waveform: root.playing-waveform;
                    quality: root.playing-quality;
                    level: root.playing-level;
                    path: root.playing-path;
                    problem: root.playing-problem;
                    shuffled: root.shuffled;
                    repeat: root.repeat;
                    open-playing => {
                        if root.now-playing-open {
                            root.close-now-playing();
                        } else {
                            root.open-now-playing();
                        }
                    }
                    toggle-shuffle => { root.toggle-shuffle(); }
                    cycle-repeat => { root.cycle-repeat(); }
                    toggle-pause => { root.toggle-pause(); }
                    previous => { root.previous-track(); }
                    next => { root.next-track(); }
                    seek(seconds) => { root.seek(seconds); }
                }
            }
        }
    }

    if root.step == Step.done && root.selected-tiles > 0: SelectionBar {
        x: root.sidebar-width + (root.width - root.sidebar-width - self.width) / 2;
        // Over the player's bar, when it is up.
        y: root.height - self.height - 24px - root.bottom-inset - (root.can-play && root.playing ? (root.phone ? 72px : 80px) : 0);
        width: self.preferred-width;
        height: self.preferred-height;
        count: root.selected-tiles;
        clear => { root.clear-selection(); }
        if root.playlist-targets.length > 0 || root.tags-offered || root.selection-moves.length > 0: MoreMenu {
            cross-axis-self-alignment: center;
            label: "More for the selection";
            color: Palette.accent-foreground;
            ring-color: Palette.accent-foreground;
            opening => {
                self.entries = [];
                if root.playlist-targets.length > 0 {
                    self.entries.push({ id: "playlist", label: "Add to playlist", icon: Icons.playlist, choices: root.playlist-targets });
                }
                if root.tags-offered {
                    self.entries.push({ id: "tags", label: "Tags", icon: Icons.tag });
                }
                if root.selection-moves.length > 0 {
                    self.entries.push({ id: "move", label: "Move to folder", icon: Icons.folder, choices: root.selection-moves });
                }
            }
            activated(id, choice) => {
                if id == "tags" {
                    root.tag-selection();
                    root.ask(Asking.tag-songs);
                } else if id == "move" {
                    root.move-selection(choice);
                } else {
                    root.add-selection-to-playlist(choice);
                }
            }
        }
    }

    // What plays, large, and the queue from it on, as a sheet that slides up
    // over the page, which keeps its place under it. Over the pages above the
    // player's bar on a desktop, whose bar stays its controls; over the whole
    // window on a phone. Its close button, Escape and Android's back slide it
    // down; so does any page opened, as from the artists' links on it.
    property <length> player-bar-height: root.can-play && root.playing ? (root.phone ? 72px : 80px) : 0;
    property <length> sheet-height: root.phone ? root.height : root.height - root.bottom-inset - root.player-bar-height;

    // Tab skips what is hidden, so once the sheet has slid over the top bar
    // and the page, the keys can't reach them. They stay drawn while it
    // slides, so nothing on screen blanks.
    property <bool> page-covered: root.now-playing-open && sheet.y <= 0;

    changed visit => { root.now-playing-open = false; }
    changed playing => {
        if !root.playing {
            root.close-now-playing();
        }
    }
    function open-now-playing() {
        root.now-playing-open = true;
        sheet-scroll.content-y = 0;
        sheet-scroll.focus();
    }
    function close-now-playing() {
        root.now-playing-open = false;
        Input.refocus += 1;
    }
    // Closes it first: a link to the page already under it changes nothing
    // there, so nothing else would.
    function open-from-now-playing(link: string) {
        root.close-now-playing();
        root.open(link);
    }

    // The frame cuts the sheet off where it slides in from and out to.
    Rectangle {
        x: root.sidebar-width;
        y: 0;
        width: root.width - root.sidebar-width;
        height: root.sheet-height;
        clip: true;
        visible: root.now-playing-open || sheet.y < self.height;

        sheet := Rectangle {
            y: root.now-playing-open ? 0 : parent.height;
            animate y { duration: 250ms; easing: ease-in-out; }
            background: Palette.background;
            // Nothing under it takes a click or the wheel.
            TouchArea { }
            // Escape closes it from wherever in the sheet the keys are.
            FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Back {
                        root.close-now-playing();
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    padding-top: root.phone ? root.safe-area-insets.top : 0;
                    padding-bottom: root.phone ? root.bottom-inset : 0;
                    padding-left: root.phone ? root.safe-area-insets.left : 0;
                    padding-right: root.phone ? root.safe-area-insets.right : 0;
                    HorizontalLayout {
                        padding: 8px;
                        padding-left: 16px;
                        IconButton {
                            icon: Icons.chevron-down;
                            label: "Close now playing";
                            clicked => { root.close-now-playing(); }
                        }
                    }
                    sheet-scroll := PageScroll {
                        active: root.now-playing-open;
                        can-go-back: true;
                        accessible-label: "Now playing";
                        back => { root.close-now-playing(); }
                        escape => { root.close-now-playing(); }
                        content-width: sheet-scroll.visible-width;
                        content-height: sheet-end.y - sheet-stage.spacing + sheet-stage.padding-bottom;
                        sheet-stage := VerticalLayout {
                            y: 0;
                            height: self.preferred-height;
                            x: max(0px, (sheet-scroll.visible-width - self.width) / 2);
                            width: min(sheet-scroll.visible-width, 1600px);
                            padding: 24px;
                            padding-top: 8px;
                            spacing: 24px;
                            alignment: start;
                            // What plays fills the sheet's first screen: the queue
                            // starts below its fold.
                            VerticalLayout {
                                min-height: sheet-scroll.visible-height - sheet-stage.padding-top - sheet-stage.spacing;
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 24px;
                                    alignment: start;
                                    NowPlaying {
                                        available: min(sheet-scroll.visible-width, 1600px) - 48px;
                                        cover: root.playing-art;
                                        title: root.playing-title;
                                        movement: root.playing-movement;
                                        movement-place: root.playing-movement-place;
                                        names: root.playing-names;
                                        album: root.playing-album;
                                        quality: root.playing-quality;
                                        level: root.playing-level;
                                        path: root.playing-path;
                                        open(link) => { root.open-from-now-playing(link); }
                                    }
                                    if Screen.phone: PlayerControls {
                                        paused: root.playing-paused;
                                        position: root.playing-position;
                                        duration: root.playing-duration;
                                        waveform: root.playing-waveform;
                                        shuffled: root.shuffled;
                                        repeat: root.repeat;
                                        toggle-pause => { root.toggle-pause(); }
                                        previous => { root.previous-track(); }
                                        next => { root.next-track(); }
                                        seek(seconds) => { root.seek(seconds); }
                                        toggle-shuffle => { root.toggle-shuffle(); }
                                        cycle-repeat => { root.cycle-repeat(); }
                                    }
                                }
                                OutputPicker {
                                    output-devices: root.output-devices;
                                    output-name: root.output-name;
                                    list-devices => { root.list-devices(); }
                                    choose-output(index) => { root.choose-output(index); }
                                }
                            }
                            // A song after the one playing plays on a tap, and
                            // moves by its grip, dragged by a mouse or a finger,
                            // or by Alt and the arrow keys.
                            if root.queue-lines.length > 0: HorizontalLayout {
                                spacing: 8px;
                                SectionHeading {
                                    horizontal-stretch: 1;
                                    text: "Queue";
                                }
                                Button {
                                    cross-axis-self-alignment: CrossAxisAlignment.end;
                                    text: "Clear";
                                    enabled: !Input.modal;
                                    clicked => { root.clear-queue(); }
                                }
                            }
                            Rectangle {
                                height: root.queue-lines.length * root.queue-row-height;
                                VerticalLayout {
                                    for line[row] in root.queue-lines: reordered := FocusScope {
                                        min-height: root.queue-row-height;
                                        max-height: root.queue-row-height;
                                        // A click on a row, beside its words and
                                        // buttons, gives it the keys to move it by.
                                        // Moved with the keys, the row has the keys
                                        // again where it lands.
                                        init => {
                                            if root.queue-focus-row == row {
                                                root.queue-focus-row = -1;
                                                self.focus();
                                            }
                                        }
                                        key-pressed(event) => {
                                            if !event.modifiers.alt || !reorder.draggable(row) {
                                                return reject;
                                            }
                                            if event.text != Key.UpArrow && event.text != Key.DownArrow {
                                                return reject;
                                            }
                                            let down = event.text == Key.DownArrow;
                                            let slot = root.step-slot(root.queue-lines, row, down);
                                            if slot >= 0 {
                                                root.queue-focus-row = down ? slot - 1 : slot;
                                                root.move-queued(row, slot);
                                            }
                                            accept
                                        }
                                        queued := ListRow {
                                            width: parent.width;
                                            height: parent.height;
                                            opacity: reorder.dragged == row ? 0.4 : 1;
                                            reserve: Screen.phone ? 44px : 32px;
                                            title: line.title;
                                            link: row > 0 ? "jump" : "";
                                            details: line.details;
                                            cover: line.cover;
                                            covered: !line.part;
                                            depth: line.part ? 1 : 0;
                                            current: line.current;
                                            expandable: line.work;
                                            expanded: line.expanded;
                                            // All of them when opened; one so it shows.
                                            entries: [{ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true }];
                                            open => { root.jump-to(row); }
                                            toggled => { root.toggle-queued-work(row); }
                                            opening => {
                                                self.entries = [];
                                                if row > 0 && !line.current {
                                                    self.entries.push({ id: "play", label: "Play now", icon: Icons.play });
                                                }
                                                if row > 1 && !line.part {
                                                    self.entries.push({ id: "next", label: "Play next", icon: Icons.next });
                                                }
                                                if line.album != "" {
                                                    self.entries.push({ id: "album", label: "Go to album", icon: Icons.album });
                                                }
                                                self.entries.push({ id: "remove", label: "Remove from queue", icon: Icons.trash, danger: true });
                                            }
                                            activated(id) => {
                                                if id == "play" {
                                                    root.jump-to(row);
                                                } else if id == "next" {
                                                    root.play-queued-next(row);
                                                } else if id == "album" {
                                                    root.open-from-now-playing(line.album);
                                                } else {
                                                    root.remove-queued(row);
                                                }
                                            }
                                        }
                                    }
                                }
                                reorder := QueueReorder {
                                    width: parent.width;
                                    height: parent.height;
                                    lines: root.queue-lines;
                                    row-height: root.queue-row-height;
                                    view-top: sheet-scroll.absolute-position.y;
                                    view-bottom: sheet-scroll.absolute-position.y + sheet-scroll.visible-height;
                                    slot-at(lines, from, at) => { root.drop-slot(lines, from, at) }
                                    moved(from, slot) => { root.move-queued(from, slot); }
                                    scroll(by) => {
                                        sheet-scroll.content-y = clamp(sheet-scroll.content-y + by, min(0, sheet-scroll.visible-height - sheet-scroll.content-height), 0);
                                    }
                                }
                            }
                            if root.queue-more > 0: Note {
                                text: root.queue-more == 1 ? "And 1 more" : "And " + root.queue-more + " more";
                                font-size: Theme.body;
                            }
                            sheet-end := Rectangle { height: 0; }
                        }
                    }
                }
            }
        }
    }

    // Over the player's bar, when it is up, as the selection bar.
    if root.step == Step.done && root.notice != "" && root.selected-tiles == 0: Rectangle {
        x: root.sidebar-width + (root.width - root.sidebar-width - self.width) / 2;
        y: root.height - self.height - 24px - root.bottom-inset - (root.can-play && root.playing ? (root.phone ? 72px : 80px) : 0);
        width: min(notice.preferred-width, root.width - root.sidebar-width - 32px);
        height: notice.preferred-height;
        border-radius: 12px;
        background: Theme.text;
        notice := HorizontalLayout {
            padding: 12px;
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: root.notice;
                font-size: Theme.body;
                color: Palette.background;
                wrap: word-wrap;
                accessible-live-region: polite;
            }
        }
    }

    // The sidebar opened over a narrow window; a tap beside it, Escape or
    // Android's back closes it. It takes the keys when it opens, and gives
    // them to the page when it closes.
    if root.step == Step.done && !root.docked && root.sidebar-open: Rectangle {
        background: #0000004d;
        TouchArea {
            clicked => {
                root.sidebar-open = false;
                Input.refocus += 1;
            }
        }
        FocusScope {
            x: 0;
            y: root.safe-area-insets.top;
            width: min(280px, root.width - 48px);
            height: parent.height - root.safe-area-insets.top - root.bottom-inset;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Back {
                    root.sidebar-open = false;
                    Input.refocus += 1;
                    return accept;
                }
                reject
            }
            Sidebar {
                items: root.sections;
                groups: root.section-groups;
                icons: root.section-icons;
                current <=> root.section;
                selected(index) => {
                    root.sidebar-open = false;
                    root.show-section(index);
                }
                new-playlist => {
                    root.sidebar-open = false;
                    root.ask(Asking.new-playlist);
                }
                dropped(index) => { root.drop-on-section(index); }
            }
        }
    }

    // Clear of the bars a phone draws over the window and of its keyboard.
    // A form taller than what is left scrolls, to the field being typed in.
    if root.step != Step.done: form := ScrollView {
        y: root.safe-area-insets.top;
        height: root.height - root.safe-area-insets.top - root.bottom-inset;
        content-width: self.visible-width;
        content-height: steps.height;
        // Slint measures an `if` element's height at its preferred width,
        // which for wrapped text is the whole text on one line. So each one
        // here prefers the column's width, and the form's height counts its
        // wrapped lines.
        property <length> column-width: min(420px, self.visible-width - 32px);

        steps := VerticalLayout {
            width: form.visible-width;
            height: max(form.visible-height, self.preferred-height);
            alignment: root.phone ? LayoutAlignment.start : LayoutAlignment.center;
            padding: 16px;
            padding-top: root.phone ? 32px : 16px;

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    preferred-width: 420px;
                    max-width: 420px;
                    spacing: 12px;

                    if root.step == Step.opening: Note {
                        preferred-width: form.column-width;
                        text: "Reading your saved sign-in…";
                        font-size: root.phone ? 16px * Theme.zoom : 0px;
                    }

                    if root.step == Step.server: VerticalLayout {
                        preferred-width: form.column-width;
                        spacing: 12px;
                        Heading { text: "Connect to your music server"; }
                        Note {
                            text: "The address of an OpenSubsonic or Subsonic server, such as Navidrome.";
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        LineEdit {
                            placeholder-text: "https://music.example.org";
                            accessible-label: "Server address";
                            text <=> root.address;
                            enabled: !root.busy;
                            // On a phone the keyboard would cover the form.
                            init => {
                                if !root.phone {
                                    self.focus();
                                }
                            }
                            accepted => { root.find-server(); }
                        }
                        if root.problem != "": Problem {
                            preferred-width: form.column-width;
                            text: root.problem;
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        StepButtons {
                            phone: root.phone;
                            busy: root.busy;
                            main: root.busy ? "Checking…" : "Continue";
                            main-enabled: !root.busy && root.address != "";
                            main-clicked => { root.find-server(); }
                        }
                    }

                    if root.step == Step.sign-in: VerticalLayout {
                        preferred-width: form.column-width;
                        spacing: 12px;
                        Heading { text: "Sign in"; }
                        Note {
                            text: root.address;
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        if root.unencrypted: Problem {
                            preferred-width: form.column-width;
                            text: "This address isn't encrypted (http). Anyone on the network between you and the server can read what you send.";
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        if root.api-key-offered: ComboBox {
                            accessible-label: "Sign in with";
                            model: ["API key", "Username and password"];
                            current-index <=> root.login-method;
                            enabled: !root.busy;
                        }
                        if root.api-key-offered && root.login-method == 0: LineEdit {
                            placeholder-text: "API key";
                            accessible-label: self.placeholder-text;
                            input-type: InputType.password;
                            init => {
                                if !root.phone {
                                    self.focus();
                                }
                            }
                            text <=> root.api-key;
                            enabled: !root.busy;
                            accepted => { root.sign-in(); }
                        }
                        if !root.api-key-offered || root.login-method == 1: VerticalLayout {
                            spacing: 12px;
                            LineEdit {
                                placeholder-text: "Username";
                                accessible-label: self.placeholder-text;
                                text <=> root.username;
                                enabled: !root.busy;
                                init => {
                                    if !root.phone {
                                        self.focus();
                                    }
                                }
                            }
                            LineEdit {
                                placeholder-text: "Password";
                                accessible-label: self.placeholder-text;
                                input-type: InputType.password;
                                text <=> root.password;
                                enabled: !root.busy;
                                accepted => { root.sign-in(); }
                            }
                        }
                        if root.problem != "": Problem {
                            preferred-width: form.column-width;
                            text: root.problem;
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        StepButtons {
                            phone: root.phone;
                            busy: root.busy;
                            back: true;
                            main: root.busy ? "Signing in…" : "Sign in";
                            main-enabled: !root.busy;
                            main-clicked => { root.sign-in(); }
                            back-clicked => {
                                root.problem = "";
                                root.step = Step.server;
                            }
                        }
                    }

                    if root.step == Step.listenbrainz: VerticalLayout {
                        preferred-width: form.column-width;
                        spacing: 12px;
                        Heading { text: "ListenBrainz"; }
                        Note {
                            text: "Optional. The app doesn't use ListenBrainz yet. Your user token is on https://listenbrainz.org/settings/";
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        LineEdit {
                            placeholder-text: "User token";
                            accessible-label: "ListenBrainz user token";
                            input-type: InputType.password;
                            init => {
                                if !root.phone {
                                    self.focus();
                                }
                            }
                            text <=> root.listenbrainz-token;
                            enabled: !root.busy;
                            accepted => { root.connect-listenbrainz(); }
                        }
                        if root.problem != "": Problem {
                            preferred-width: form.column-width;
                            text: root.problem;
                            font-size: root.phone ? 16px * Theme.zoom : 0px;
                        }
                        StepButtons {
                            phone: root.phone;
                            busy: root.busy;
                            back: true;
                            other: "Skip";
                            main: root.busy ? "Checking…" : "Connect";
                            main-enabled: !root.busy && root.listenbrainz-token != "";
                            main-clicked => { root.connect-listenbrainz(); }
                            other-clicked => { root.skip-listenbrainz(); }
                            back-clicked => {
                                root.problem = "";
                                root.step = Step.sign-in;
                            }
                        }
                    }
                }
            }
        }
    }

    // Asks for a playlist's name, or whether to delete it, over the page. A
    // tap beside it or Escape lets it go. One taller than the window
    // scrolls. A delete's takes the keys on Cancel, the tags' on itself.
    if root.step == Step.done && root.asking != Asking.nothing: Rectangle {
        background: #0000004d;
        TouchArea {
            clicked => { root.close-dialog(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(24px, (parent.height - root.bottom-inset - self.height) / 3);
            width: min(400px, parent.width - 32px);
            height: min(dialog.preferred-height, parent.height - root.bottom-inset - 48px);
            border-radius: 12px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #0000004d;
            // Keeps clicks on the dialog from letting it go.
            TouchArea { }
            FocusScope {
                accessible-role: groupbox;
                accessible-label: root.asked-title();
                init => {
                    if root.asking == Asking.tag-songs {
                        self.focus();
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Back {
                        root.close-dialog();
                        return accept;
                    }
                    reject
                }
                Flickable {
                    interactive: self.content-height > self.height;
                    content-height: dialog.preferred-height;
                    dialog := VerticalLayout {
                        width: parent.width;
                        padding: 20px;
                        spacing: 16px;
                        Text {
                            text: root.asked-title();
                            font-size: Theme.heading;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if root.asks-name: LineEdit {
                            text <=> root.asked-name;
                            placeholder-text: "Name";
                            accessible-label: self.placeholder-text;
                            init => { self.focus(); }
                            accepted => {
                                if root.may-answer() {
                                    root.answer();
                                }
                            }
                        }
                        if root.asks-password: LineEdit {
                            input-type: InputType.password;
                            text <=> root.asked-password;
                            placeholder-text: "New password";
                            accessible-label: self.placeholder-text;
                            init => { self.focus(); }
                        }
                        if root.asks-password: LineEdit {
                            input-type: InputType.password;
                            text <=> root.asked-repeat;
                            placeholder-text: "Repeat password";
                            accessible-label: self.placeholder-text;
                            accepted => {
                                if root.may-answer() {
                                    root.answer();
                                }
                            }
                        }
                        // Once the second password is as long as the first.
                        if root.asks-password && root.asked-repeat.character-count >= root.asked-password.character-count && root.asked-repeat != root.asked-password: Problem {
                            text: "The passwords differ.";
                        }
                        if root.asks-station: LineEdit {
                            text <=> root.asked-stream;
                            placeholder-text: "Stream address";
                            accessible-label: self.placeholder-text;
                        }
                        if root.asks-station: LineEdit {
                            text <=> root.asked-homepage;
                            placeholder-text: "Home page (optional)";
                            accessible-label: self.placeholder-text;
                            accepted => {
                                if root.may-answer() {
                                    root.answer();
                                }
                            }
                        }
                        if root.asking == Asking.import-eq: Note {
                            text: "From a headphone's ParametricEQ.txt in AutoEQ, or Equalizer APO's settings. It takes the EQ's place.";
                        }
                        if root.asking == Asking.import-eq: TextEdit {
                            height: 160px;
                            text <=> root.asked-text;
                            accessible-label: "AutoEQ settings";
                            init => { self.focus(); }
                            edited => { root.asked-problem = ""; }
                        }
                        if root.asking == Asking.import-eq && root.asked-problem != "": Problem { text: root.asked-problem; }
                        if root.asking == Asking.delete-tag: Note { text: "The tags in it go too. The tracks stay."; }
                        // Each tick puts a tag on the songs or takes it off at once;
                        // a name typed below makes a tag and ticks it.
                        if root.asking == Asking.tag-songs && root.tag-choices-loading: Note { text: "Loading…"; }
                        if root.asking == Asking.tag-songs && !root.tag-choices-loading: VerticalLayout {
                            spacing: 12px;
                            tag-picks := ScrollView {
                                preferred-height: min(ticks.preferred-height, 320px);
                                content-width: self.visible-width;
                                content-height: ticks.preferred-height;
                                ticks := VerticalLayout {
                                    width: tag-picks.visible-width;
                                    spacing: 4px;
                                    for choice[i] in root.tag-choices: HorizontalLayout {
                                        padding-left: choice.depth * 20px;
                                        CheckBox {
                                            text: choice.title;
                                            checked: choice.ticked;
                                            toggled => { root.toggle-tag(i); }
                                        }
                                    }
                                    if root.tag-choices.length == 0: Note { text: "No tags yet."; }
                                }
                            }
                            LineEdit {
                                placeholder-text: "New tag";
                                accessible-label: self.placeholder-text;
                                accepted(text) => {
                                    root.tag-with-new(text);
                                    self.text = "";
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            if root.asking != Asking.tag-songs: Button {
                                text: "Cancel";
                                init => {
                                    if root.deleting {
                                        self.focus();
                                    }
                                }
                                clicked => { root.close-dialog(); }
                            }
                            Button {
                                text: root.asked-action();
                                primary: true;
                                enabled: root.may-answer();
                                clicked => { root.answer(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
