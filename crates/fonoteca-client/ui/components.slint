// The parts the browsing pages share. Every name on screen is a link: its
// `link` names where it leads (such as "artist:<id>"), and the component hands
// it to `open`.

import { Palette, ScrollView } from "std-widgets.slint";

// An accent color the settings offer, in the shade for a light scheme and the
// one for a dark one, with the color of what is drawn on each.
export struct AccentChoice {
    name: string,
    light: color,
    dark: color,
    on-light: color,
    on-dark: color,
}

export global Theme {
    // How much bigger the phone's or the desktop's text size setting makes
    // text, which the window sets: at least 1.
    in-out property <float> zoom: 1;

    out property <brush> text: Palette.foreground;
    // 4.5:1 against the background and the surface in every style.
    out property <brush> muted: Palette.foreground.transparentize(35%);
    out property <brush> hover: Palette.foreground.transparentize(92%);
    out property <brush> surface: Palette.alternate-background;
    // The accent colors on offer, and the settings' entry for the one in
    // use: 0 is the system's, then the colors in order.
    in property <[AccentChoice]> accents;
    in property <int> accent-choice;
    // Whether the scheme is dark. A scheme left to the system reads as
    // unknown, but the style's own colors still follow the system's.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && root.page.to-hsv().value < 0.5);
    property <color> page: Palette.background;
    out property <brush> accent: root.accent-choice == 0 ? Palette.accent-background
        : root.dark ? root.accents[root.accent-choice - 1].dark : root.accents[root.accent-choice - 1].light;
    // What is drawn on the accent: icons, text and the bars of its colour.
    out property <brush> on-accent: root.accent-choice == 0 ? Palette.accent-foreground
        : root.dark ? root.accents[root.accent-choice - 1].on-dark : root.accents[root.accent-choice - 1].on-light;

    // The least a finger's target is on a phone, and an icon's size there,
    // as Material 3 sets them.
    out property <length> phone-target: 48px;
    out property <length> phone-icon: 24px;

    // On a phone each text style is Material 3's for its role: Body Medium
    // for the lines under a name, Body Large for a list's names, Title Large
    // for a section and Headline Small for what a page is about.
    out property <length> small: (Screen.phone ? 14px : 12px) * self.zoom;
    out property <length> body: (Screen.phone ? 16px : 14px) * self.zoom;
    out property <length> heading: (Screen.phone ? 22px : 20px) * self.zoom;
    out property <length> title: (Screen.phone ? 24px : 32px) * self.zoom;
    // The same on a phone as on a desktop: Label Medium for the bottom
    // bar's names and the word over a page's title; Body Medium for a
    // song's length and a page's facts, and Label Large, as large, for the
    // words of a small button or of a link that acts as one.
    out property <length> label: 12px * self.zoom;
    out property <length> detail: 14px * self.zoom;

    out property <length> gap: 16px;
    out property <length> radius: 6px;
    // The bar over the pages, as high as the logo over the sidebar beside it, and
    // the phone's bottom bar.
    out property <length> bar-height: 64px;

    out property <brush> danger: root.dark ? #ff6b6b : #c42b1c;
    // The signal path's lights, as Roon colours them, worst first: a lossy
    // file, changed for the device, changed as asked, untouched.
    out property <[color]> quality-colors: root.dark
        ? [#f2c94c, #4cd07d, #5aa9ff, #b38cff]
        : [#a87b00, #1b8a45, #1f6fd1, #7c3aed];
}

// The window's size and what a phone draws over the bottom of it, for the
// menus, which open as a sheet from the bottom on a phone.
export global Screen {
    in-out property <length> width;
    in-out property <length> height;
    in-out property <length> bottom;
    out property <bool> phone: Screen.width < 600px;
}

export struct Name {
    label: string,
    link: string,
}

// A place to go from the navigation: its name, its icon and the link it opens.
export struct NavEntry {
    title: string,
    icon: string,
    link: string,
}

// An entry of a menu: its words, its icon, a path of `Icons`, and whether
// it is red, for one that destroys. With `choices` it opens a submenu of
// them, such as the playlists to add to. `id` tells the menu's owner which
// entry was chosen.
export struct MenuEntry {
    id: string,
    label: string,
    icon: string,
    danger: bool,
    choices: [Name],
    // A second, smaller line under the label, for entries the label alone
    // doesn't tell apart; the menu says so with `two-line`.
    detail: string,
    // What the entry is where only its icon shows it, as "Bluetooth", which
    // a screen reader says before its label.
    kind: string,
    // The one chosen of the entries, checked at its end.
    checked: bool,
}

// An album or artist on a grid or shelf, and the page it opens; a folder of
// playlists, drawn as one.
// What made a tile's playlist, which picks the colour over its picture.
export enum KindTint { none, green, blue, red }

export struct AlbumTile {
    title: string,
    names: [Name],
    cover: image,
    link: string,
    selected: bool,
    folder: bool,
    // Whether all of it is kept on this device.
    downloaded: bool,
    // A station's logo, shown whole rather than filling the square.
    logo: bool,
    // Whether the logo wants a dark plate rather than a light one.
    dark-plate: bool,
    // A catalogue station the server has saved already.
    saved: bool,
    // A playlist ListenBrainz made, wide: the colour its kind has.
    tint: KindTint,
}

