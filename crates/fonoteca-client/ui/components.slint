    out property <string> more: "M3.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z M17.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z";
}

// Whether every press counts as a finger's. Tests turn it on, since Slint's
// test backend can only send mouse presses. Whether a shelf is being slid
// sideways, which the page then doesn't scroll. Whether a dialog is open,
// which leaves the keys nothing to reach behind it. Whether the last press
// was a finger's, which the page's drag, pull and edge swipes wait for.
export global Input {
    in-out property <bool> touch;
    in-out property <bool> finger;
    in-out property <bool> sliding;
    in-out property <bool> modal;
    // Counts up when the page is to take the keys back, as from a dialog.
    in-out property <int> refocus;
}

// A finger landing on a page. The page's drag holds it back from what is
// under it while it sees where it goes, and drops it once it takes it, so
// what is under the finger learns of it only as the finger first moves over
// it, and claims it then: a control with a drag of its own (GripArea), which
// the page's drag then leaves alone, or a shelf, which the page's drag
// slides when the finger goes sideways. A shelf sliding itself would have to
// wait out that hold, and a quick flick would tap the tile under the finger.
export global Landing {
    // Counts the fingers that have landed on a page, and gives the one a
    // control claimed, and the one a shelf did.
    in-out property <int> count;
    in-out property <int> gripped: -1;
    in-out property <int> shelved: -1;
    // Whether the page's drag slides that shelf, and how far it has; how
    // fast the finger went when it let go.
    in-out property <bool> sliding;
    in-out property <length> slid;
    in-out property <float> flung;
}

// How a drag glides on when a finger lets go of it while moving: as Android's
// lists do (OverScroller with the default scroll friction), in logical pixels,
// which are Android's dp. Slint 1.18's Flickable slows evenly with no top
// speed instead, so its glide grows with the square of the speed, and a quick
// swipe goes on far.
export global Fling {
    // The slowest and the fastest a fling goes, in px/s.
    property <float> slowest: 50;
    property <float> fastest: 8000;
    // How far along its glide a fling is over its time: fast at first.
    out property <easing> curve: cubic-bezier(0.175, 0.5, 0.35, 1);

    // OverScroller's spline: a fling at speed v glides
    // reach * (v / pace) ^ (rate / (rate - 1)) in (v / pace) ^ (1 / (rate - 1))
    // seconds. Its reach is the friction times Earth's gravity in dp/s², tuned
    // by 0.84; its pace is the speed that glides for a second.
    property <float> rate: ln(0.78) / ln(0.9);
    property <length> reach: 0.015 * 9.80665 * 39.37 * 160 * 0.84 * 1px;
    property <float> pace: self.reach / 1px / 0.35;

    // How far a fling at `speed` px/s glides, signed as the speed.
    public pure function distance(speed: float) -> length {
        if abs(speed) < self.slowest {
            return 0px;
        }
        sign(speed) * self.reach * pow(min(abs(speed), self.fastest) / self.pace, self.rate / (self.rate - 1))
    }

    // How long a fling at `speed` px/s glides.
    public pure function time(speed: float) -> duration {
        if abs(speed) < self.slowest {
            return 0ms;
        }
        1s * pow(min(abs(speed), self.fastest) / self.pace, 1 / (self.rate - 1))
    }
}

// How fast a finger drags along one axis, in px/s, to fling with: over the
// last 50 to 100ms of the drag only, as Android goes by its last tenth of a
// second, and not at all once it rested 40ms before letting go. Slint times
// each move by when it handled it, not when the finger made it, so a few
// moves handled at once would make a short span and a wild speed; a span
// counts as a frame at least.
export component FingerSpeed {
    property <duration> stretch: 50ms;
    property <duration> rest: 40ms;
    property <duration> frame: 16ms;
    // Where the finger was at the start of the stretch before the latest,
    // which the speed goes from, and of the latest; when it last moved.
    property <duration> from-time;
    property <length> from-at;
    property <duration> latest-time;
    property <length> latest-at;
    property <duration> moved-time;

    // The finger took the drag at `at`.
    public function begin(at: length) {
        root.from-time = animation-tick();
        root.from-at = at;
        root.latest-time = root.from-time;
        root.latest-at = at;
        root.moved-time = root.from-time;
    }

    // The finger took the drag at `at` on its second move, having landed at
    // `landed` at `since`: the speed goes from where it landed, unless it
    // came long enough after to have rested there.
    public function begin-from(landed: length, since: duration, at: length) {
        root.begin(at);
        if root.from-time - since <= root.rest {
            root.from-time = since;
            root.from-at = landed;
        }
    }

    // The finger moved to `at`.
    public function follow(at: length) {
        let now = animation-tick();
        if now - root.latest-time >= root.stretch {
            root.from-time = root.latest-time;
            root.from-at = root.latest-at;
            root.latest-time = now;
            root.latest-at = at;
        }
        root.moved-time = now;
    }

    // How fast the finger was going when it let go at `at`.
    public function at-release(at: length) -> float {
        let now = animation-tick();
        if now - root.moved-time > root.rest {
            return 0;
        }
        (at - root.from-at) / 1px / (max(now - root.from-time, root.frame) / 1s)
    }
}

// The playlist being dragged, by its link, while a drag is in flight; and
// what every drag carries, set once at start, as Slint starts no drag without
// it.
export global Drag {
    in-out property <string> link;
    in property <data-transfer> data;
}

// Where a playlist being dragged can be dropped to move it there: onto a
// folder, or the top level. It takes no other drag.
component FolderDrop inherits DropArea {
    callback moved();
    can-drop(event) => Drag.link != "" ? event.proposed-action : DragAction.none;
    dropped(event) => {
        root.moved();
        return event.proposed-action;
    }
}

// A finger held still on a TouchArea for half a second, which a phone takes
// for a long press; a mouse never makes one. The area hands on its pointer
// events and moves, and skips the click that ends a long press: `done`.
component Hold {
    callback held();
    out property <bool> done;

    public function pointer(event: PointerEvent) {
        if event.kind == PointerEventKind.down {
            root.done = false;
            timer.running = event.button == PointerEventButton.left && (Input.touch || event.touch-finger-id != 0);
        } else if event.kind != PointerEventKind.move {
            timer.running = false;
        }
    }

    // The finger is this far from where it went down.
    public function moved(dx: length, dy: length) {
        if abs(dx) > 8px || abs(dy) > 8px {
            timer.running = false;
        }
    }

    timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.done = true;
            root.held();
        }
    }
}

// Clicks, Enter and Space, and screen readers all end up in `clicked`; a
// right-click, a two-finger click, a long press and the Menu key in
// `context-clicked`.
export component Pressable {
    in property <bool> enabled: true;
    in property <string> label;
    in property <brush> ring-color: Theme.accent;
    out property <bool> hovered: root.enabled && touch.has-hover;
    out property <bool> focused: focus.has-focus;
    out property <bool> pressed: touch.pressed;
    // Whether Shift was held on the press or key that clicked it, and
    // whether a finger made the last press.
    out property <bool> shift;
    out property <bool> finger;
    callback clicked();
    callback context-clicked();

    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius + 3px;
        border-width: root.focused ? 2px : 0;
        border-color: root.ring-color;
    }

    focus := FocusScope {
        enabled: root.enabled && !Input.modal;
        focus-on-click: false;
        key-pressed(event) => {
            root.shift = event.modifiers.shift;
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                root.context-clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if !hold.done {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.shift = event.modifiers.shift;
                root.finger = Input.touch || event.touch-finger-id != 0;
                Input.finger = root.finger;
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-clicked();
            }
            hold.pointer(event);
        }
        moved => { hold.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
    }

    hold := Hold {
        held => { root.context-clicked(); }
    }

    @children
}

export component Link inherits Pressable {
    in property <string> text;
    in property <length> font-size: Theme.body;
    in property <int> font-weight: 400;
    in property <brush> color: Theme.muted;
    label: self.text;

    HorizontalLayout {
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.hovered || root.focused ? Theme.text : root.color;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Names in a row with commas, such as an album's artists. A long list
// continues on the next line.
export component Links inherits FlexboxLayout {
    in property <[Name]> names;
    // The first `split` names are one group, set apart from the rest by a dot.
    in property <int> split;
    in property <length> font-size: Theme.body;
    in property <brush> text-color: Theme.muted;
    // Whether the names open their pages; off, a click goes on to what is
    // behind them.
    in property <bool> linked: true;
    callback open(link: string);
    callback context-clicked();

    spacing-horizontal: 4px;

    for name[i] in root.names: Link {
        text: i == root.names.length - 1 ? name.label : i == root.split - 1 ? name.label + " ·" : name.label + ",";
        label: name.label;
        enabled: root.linked && name.link != "";
        font-size: root.font-size;
        color: root.text-color;
        clicked => { root.open(name.link); }
        context-clicked => { root.context-clicked(); }
    }
}

// Links kept to `lines` lines: the names that don't fit are left out, and the
// comma before them shows there are more.
export component LinksLine inherits Rectangle {
    in property <[Name]> names;
    in property <int> lines: 1;
    // How the names that fit share the line.
    in property <LayoutAlignment> alignment: LayoutAlignment.stretch;
    in property <length> font-size: Theme.body;
    in property <brush> text-color: Theme.muted;
    in property <bool> linked: true;
    callback open(link: string);
    callback context-clicked();

    height: min(links.preferred-height, line.preferred-height * root.lines);
    clip: true;

    line := Text {
        visible: false;
        text: " ";
        font-size: root.font-size;
    }
    links := Links {
        alignment: root.alignment;
        names: root.names;
        linked: root.linked;
        font-size: root.font-size;
        text-color: root.text-color;
        open(link) => { root.open(link); }
        context-clicked => { root.context-clicked(); }
    }
}

// Cover art or a photo, with a note, a person or a folder drawn where there
// is none.
export component Artwork inherits Rectangle {
    in property <image> source;
    in property <bool> round;
    in property <bool> folder;
    in property <length> size: 160px;
    in property <bool> highlighted;
    // Shows all of the picture, as a logo needs, rather than filling the square.
    in property <bool> logo;
    // Whether a logo sits on a dark plate rather than a light one: white ink
    // on dark, dark ink on light, and a logo with a background of its own on
    // the plate of that background, so either reads in light and dark mode.
    in property <bool> dark-plate;
    // Room around a logo, so it doesn't run into the square's edges.
    property <length> inset: root.logo ? root.size * 0.12 : 0;

    width: root.size;
    height: root.size;
    border-radius: root.round ? root.size / 2 : Theme.radius;
    clip: true;
    background: Theme.surface;

    if root.logo: Rectangle { background: root.dark-plate ? #2b2b2e : #f1f1f1; }
    if root.source.width == 0: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.4;
        height: root.size * 0.4;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.folder ? Icons.folder : root.round ? Icons.person : Icons.note;
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }
    Image {
        x: root.inset;
        y: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        source: root.source;
        image-fit: root.logo ? contain : cover;
    }
    Rectangle {
        background: root.highlighted ? #00000026 : transparent;
    }
}

export component IconButton inherits Pressable {
    in property <string> icon;
    in property <bool> filled;
    in property <brush> color: Theme.text;
    in property <length> icon-size: Screen.phone ? Theme.phone-icon : 20px;
    in property <brush> hover-color: Theme.hover;
    // A round plate behind the icon, for the one button that leads.
    in property <brush> plate: transparent;
    in property <length> stroke: 1.75px;

    width: Screen.phone ? Theme.phone-target : 32px;
    height: self.width;

    Rectangle {
        border-radius: self.height / 2;
        background: root.plate;
    }
    Rectangle {
        border-radius: self.height / 2;
        background: root.hovered ? root.hover-color : transparent;
    }
    Path {
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.enabled ? root.color : Theme.muted.transparentize(60%);
        stroke-width: root.stroke;
        fill: root.filled ? root.color : transparent;
    }
}

// A row of a menu: its icon, its words, red when it destroys, and an arrow
// when it opens a submenu. Lit while `lit`, or pressed; ringed too while
// `keyed`, when the keys lit it.
component MenuRow {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    in property <string> detail;
    in property <string> kind;
    in property <bool> checked;
    in property <bool> strong;
    in property <bool> more;
    in property <bool> lit;
    in property <bool> keyed;
    in property <length> icon-size: 18px;
    in property <length> font-size: Theme.body;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    accessible-role: button;
    accessible-label: (root.kind == "" ? "" : root.kind + ": ") + (root.detail == "" ? root.label : root.label + ", " + root.detail);
    accessible-expandable: root.more;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: 4px;
        background: root.lit || touch.pressed ? Theme.hover : transparent;
        border-width: root.lit && root.keyed ? 2px : 0;
        border-color: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.icon != "": Path {
            cross-axis-self-alignment: center;
            width: root.icon-size;
            height: root.icon-size;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            stroke: root.danger ? Theme.danger : Theme.muted;
            stroke-width: 1.75px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                font-size: root.font-size;
                font-weight: root.strong ? 600 : 400;
                color: root.danger ? Theme.danger : Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: Theme.small;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.checked: Path {
            cross-axis-self-alignment: center;
            width: root.icon-size;
            height: root.icon-size;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.check;
            stroke: Theme.accent;
            stroke-width: 2px;
        }
        if root.more: Path {
            cross-axis-self-alignment: center;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.forward;
            stroke: Theme.muted;
            stroke-width: 2px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// What a phone's popup opens as, so it stays on the screen: a sheet from the
// bottom of the window, over the dimmed rest of it, which a tap on closes.
// It is as tall as its children, `content-height` high, up to three
// quarters of the window, past which they scroll.
component Sheet inherits Rectangle {
    in property <length> content-height;
    callback dismissed();

    background: #0000004d;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    Rectangle {
        y: parent.height - self.height;
        height: min(root.content-height, Screen.height * 75%) + Screen.bottom;
        background: Palette.background;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        // Keeps taps on the sheet from closing it.
        TouchArea { }
        Flickable {
            y: 0;
            height: parent.height - Screen.bottom;
            content-height: root.content-height;
            @children
        }
    }
}

// The 3-dot button and its menu. On a desktop the menu opens under the
// button, or over it near the window's bottom, and a submenu beside it on
// the side with room. On a phone the menu is a sheet from the bottom of the
// window, and a submenu takes the entries' place in it. A menu that changes
// with what it is for sets `entries` in `opening`. `activated` gives the
// entry chosen, and from a submenu the link of the choice.
export component MoreMenu {
    in-out property <[MenuEntry]> entries;
    in property <string> label: "More";
    in property <string> icon: Icons.more;
    in property <bool> filled: true;
    in property <brush> color: Theme.muted;
    in property <brush> hover-color: Theme.hover;
    in property <brush> ring-color: Theme.accent;
    // Whether the entries carry a `detail` line under their label, and how
    // wide the desktop's panel is for them.
    in property <bool> two-line;
    in property <length> panel: 224px;
    out property <bool> hovered: button.hovered;
    out property <bool> pressed: button.pressed;
    callback opening();
    callback activated(id: string, choice: string);

    // The entry lit, the one whose submenu is open, and the choice lit in it,
    // and whether the keys lit them rather than the mouse.
    property <int> current: -1;
    property <int> open: -1;
    property <int> choice: -1;
    property <bool> keyed;
    property <[Name]> choices: root.entries[root.open].choices;
    // An entry chosen opened a dialog; the button takes the keys back when
    // it closes, after the page has, and not if the dialog took it away.
    property <bool> awaiting;
    property <bool> modal: Input.modal;
    changed modal => {
        if !self.modal && self.awaiting {
            self.awaiting = false;
            refocus.running = true;
        }
    }
    refocus := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            button.focus();
        }
    }

    property <length> row-height: 32px * Theme.zoom;
    property <length> entry-height: (root.two-line ? 44px : 32px) * Theme.zoom;
    // A sheet's rows are Material's one-line list rows, its entries with
    // a `detail` its two-line ones.
    property <length> sheet-row-height: 56px * Theme.zoom;
    property <length> sheet-entry-height: root.two-line ? 72px * Theme.zoom : root.sheet-row-height;
    property <length> pad: 4px;
    property <length> gap: 4px;
    property <length> above: root.absolute-position.y - 8px;
    property <length> below: Screen.height - Screen.bottom - root.absolute-position.y - root.height - 8px;
    property <bool> up: root.below < 240px && root.above > root.below;
    property <length> menu-x: root.absolute-position.x + root.panel > Screen.width - 8px ? root.width - root.panel : 0;
    property <bool> sub-left: root.absolute-position.x + root.menu-x + 2 * root.panel + root.gap > Screen.width - 8px;
    // A long list of entries scrolls.
    property <length> main-height: min(2 * root.pad + root.entries.length * root.entry-height, (root.up ? root.above : root.below) - root.gap);
    // A long submenu scrolls.
    property <length> sub-height: min(min(2 * root.pad + root.choices.length * root.row-height, 320px), (root.up ? root.above : root.below) - root.gap);
    property <length> menu-height: root.open >= 0 ? max(root.main-height, root.sub-height) : root.main-height;
    property <length> main-y: root.up ? root.menu-height - root.main-height : 0;
    // Lined up with its entry, within the menu's height where it fits.
    property <length> sub-y: clamp(root.main-y + root.open * root.entry-height, 0, root.menu-height - root.sub-height);

    width: Screen.phone ? Theme.phone-target : 32px;
    height: self.width;

    // Opens the menu, as the button does, for what else is part of the button.
    public function show() {
        root.opening();
        root.current = -1;
        root.open = -1;
        root.choice = -1;
        root.keyed = false;
        popup.show();
    }

    // The item `by`, 1 or -1, from `i` of `n`, round the ends; from none,
    // the first or the last.
    function step(i: int, by: int, n: int) -> int {
        i < 0 ? (by > 0 ? 0 : n - 1) : mod(i + by + n, n)
    }

    // Lights entry `i`, and opens its submenu or closes another's.
    function light(i: int) {
        root.current = i;
        root.open = root.entries[i].choices.length > 0 ? i : -1;
        root.choice = -1;
    }

    // Entry `i` chosen: opens its submenu, or is done.
    function choose(i: int) {
        root.light(i);
        if root.open < 0 {
            popup.close();
            root.activated(root.entries[i].id, "");
            root.awaiting = Input.modal;
        }
    }

    function pick(j: int) {
        popup.close();
        root.activated(root.entries[root.open].id, root.choices[j].link);
        root.awaiting = Input.modal;
    }

    button := IconButton {
        width: parent.width;
        height: parent.height;
        icon: root.icon;
        filled: root.filled;
        color: root.color;
        hover-color: root.hover-color;
        ring-color: root.ring-color;
        label: root.label;
        accessible-expandable: true;
        accessible-expanded: popup.is-open;
        clicked => { root.show(); }
    }

    popup := PopupWindow {
        x: Screen.phone ? -root.absolute-position.x : root.menu-x - (root.open >= 0 && root.sub-left ? root.panel + root.gap : 0);
        y: Screen.phone ? -root.absolute-position.y : root.up ? -root.menu-height - root.gap : root.height + root.gap;
        width: Screen.phone ? Screen.width : root.open >= 0 ? 2 * root.panel + root.gap : root.panel;
        height: Screen.phone ? Screen.height : root.menu-height;
        close-policy: close-on-click-outside;
        forward-focus: keys;

        // A screen reader is told of the entry the keys light: the rows are
        // its accessible children in order, the entries' then the choices'
        // on a desktop, the back row then the choices' on a phone.
        keys := FocusScope {
            accessible-role: list;
            accessible-label: root.label;
            accessible-delegate-focus: root.choice >= 0 ? (Screen.phone ? 1 : root.entries.length) + root.choice : Screen.phone && root.open >= 0 ? -1 : root.current;
            key-pressed(event) => {
                root.keyed = true;
                let by = event.text == Key.DownArrow ? 1 : event.text == Key.UpArrow ? -1 : 0;
                if by != 0 && (root.choice >= 0 || (Screen.phone && root.open >= 0)) {
                    root.choice = root.step(root.choice, by, root.choices.length);
                    return accept;
                }
                if by != 0 {
                    root.current = root.step(root.current, by, root.entries.length);
                    root.open = -1;
                    root.choice = -1;
                    return accept;
                }
                if event.text == Key.RightArrow && root.choice < 0 && root.current >= 0 && root.entries[root.current].choices.length > 0 {
                    root.light(root.current);
                    root.choice = 0;
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.Escape || event.text == Key.Back) && root.open >= 0 {
                    root.open = -1;
                    root.choice = -1;
                    return accept;
                }
                // Slint lets an Escape close the menu, but not Android's back.
                if event.text == Key.Back {
                    popup.close();
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    if root.choice >= 0 {
                        root.pick(root.choice);
                    } else if root.current >= 0 {
                        root.choose(root.current);
                        if root.open >= 0 {
                            root.choice = 0;
                        }
                    }
                    return accept;
                }
                reject
            }

            // Off the menu a click closes it, as one outside the popup does.
            if !Screen.phone: TouchArea {
                clicked => { popup.close(); }
            }

            if !Screen.phone: Rectangle {
                x: root.open >= 0 && root.sub-left ? root.panel + root.gap : 0;
                y: root.main-y;
                width: root.panel;
                height: root.main-height;
                background: Palette.background;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.hover;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000004d;
                main-scroll := Flickable {
                    content-height: 2 * root.pad + root.entries.length * root.entry-height;
                    VerticalLayout {
                        padding: root.pad;
                        for entry[i] in root.entries: MenuRow {
                            height: root.entry-height;
                            icon: entry.icon;
                            label: entry.label;
                            detail: entry.detail;
                            kind: entry.kind;
                            checked: entry.checked;
                            danger: entry.danger;
                            more: entry.choices.length > 0;
                            lit: root.current == i;
                            keyed: root.keyed;
                            // Scrolled into view when the keys light it; the mouse
                            // lights what is already under it, and the wheel would
                            // be undone.
                            changed lit => {
                                if self.lit && root.keyed {
                                    main-scroll.content-y = clamp(main-scroll.content-y, main-scroll.height - self.y - self.height, -self.y);
                                }
                            }
                            // The mouse on an entry opens its submenu, or closes
                            // another's.
                            changed hovered => {
                                if self.hovered {
                                    root.keyed = false;
                                    root.light(i);
                                }
                            }
                            clicked => { root.choose(i); }
                        }
                    }
                }
            }

            if !Screen.phone && root.open >= 0: Rectangle {
                x: root.sub-left ? 0 : root.panel + root.gap;
                y: root.sub-y;
                width: root.panel;
                height: root.sub-height;
                background: Palette.background;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.hover;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000004d;
                sub-scroll := Flickable {
                    content-height: 2 * root.pad + root.choices.length * root.row-height;
                    VerticalLayout {
                        padding: root.pad;
                        for choice[j] in root.choices: MenuRow {
                            height: root.row-height;
                            label: choice.label;
                            lit: root.choice == j;
                            keyed: root.keyed;
                            // Scrolled into view when the keys light it.
                            changed lit => {
                                if self.lit {
                                    sub-scroll.content-y = clamp(sub-scroll.content-y, sub-scroll.height - self.y - self.height, -self.y);
                                }
                            }
                            changed hovered => {
                                if self.hovered {
                                    root.keyed = false;
                                    root.choice = j;
                                }
                            }
                            clicked => { root.pick(j); }
                        }
                    }
                }
            }

            if Screen.phone: Sheet {
                content-height: sheet-list.preferred-height;
                dismissed => { popup.close(); }
                sheet-list := VerticalLayout {
                    padding: 8px;
                    if root.open < 0: VerticalLayout {
                        for entry[i] in root.entries: MenuRow {
                            height: root.sheet-entry-height;
                            icon: entry.icon;
                            label: entry.label;
                            detail: entry.detail;
                            kind: entry.kind;
                            checked: entry.checked;
                            danger: entry.danger;
                            more: entry.choices.length > 0;
                            icon-size: Theme.phone-icon;
                            font-size: Theme.body;
                            lit: root.current == i;
                            keyed: root.keyed;
                            clicked => { root.choose(i); }
                        }
                    }
                    if root.open >= 0: VerticalLayout {
                        // Back to the entries.
                        MenuRow {
                            height: root.sheet-row-height;
                            icon: Icons.back;
                            label: root.entries[root.open].label;
                            strong: true;
                            icon-size: Theme.phone-icon;
                            font-size: Theme.body;
                            clicked => {
                                root.open = -1;
                                root.choice = -1;
                            }
                        }
                        for choice[j] in root.choices: MenuRow {
                            height: root.sheet-row-height;
                            label: choice.label;
                            font-size: Theme.body;
                            lit: root.choice == j;
                            keyed: root.keyed;
                            clicked => { root.pick(j); }
                        }
                    }
                }
            }
        }
    }
}

// An album, playlist or genre in a shelf or grid, or an artist, round; a
// radio station, with its menu of `entries` beside its name.
export component CoverTile inherits Pressable {
    in property <image> cover;
    in property <string> title;
    in property <[Name]> names;
    in property <length> size: 160px;
    in property <bool> round;
    in property <bool> folder;
    in property <bool> logo;
    in property <bool> dark-plate;
    // A catalogue station already saved: it shows a check and its menu is
    // hidden, keeping the room, so its row lines up with the others.
    in property <bool> saved;
    // While its page is selecting, every tile shows whether it is selected.
    in property <bool> selecting;
    in property <bool> selected;
    in property <[MenuEntry]> entries;
    // Whether it is kept on this device, and whether its menu offers to keep
    // or let go of it ("download" and "remove-download").
    in property <bool> downloaded;
    in property <bool> downloadable;
    // A folder a playlist can be dragged onto, lit while one is over it.
    in property <bool> drop-target;
    callback open(link: string);
    callback activated(id: string, choice: string);
    callback dropped();
    label: self.title;
    accessible-item-selectable: self.selecting;
    accessible-item-selected: self.selected;

    // Behind the whole tile, its outline just outside it.
    if root.selected: Rectangle {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent.transparentize(85%);
    }
    VerticalLayout {
        width: root.size;
        alignment: start;
        spacing: 4px;
        Artwork {
            size: root.size;
            round: root.round;
            folder: root.folder;
            logo: root.logo;
            dark-plate: root.dark-plate;
            source: root.cover;
            highlighted: root.hovered || drop.has-drag;
            if root.downloaded: Rectangle {
                x: root.round ? root.size * 0.85 - self.width : root.size - self.width - 10px;
                y: root.round ? root.size * 0.15 : 10px;
                width: 24px;
                height: 24px;
                border-radius: self.height / 2;
                background: #00000059;
                Path {
                    x: 4px;
                    y: 4px;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.download;
                    stroke: white;
                    stroke-width: 2.5px;
                    accessible-role: image;
                    accessible-label: "Downloaded";
                }
            }
            if root.saved: Rectangle {
                x: root.size - self.width - 10px;
                y: 10px;
                width: 24px;
                height: 24px;
                border-radius: self.height / 2;
                background: #00000059;
                Path {
                    x: 4px;
                    y: 4px;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.check;
                    stroke: white;
                    stroke-width: 2.5px;
                    accessible-role: image;
                    accessible-label: "Saved";
                }
            }
            // Inside the circle when round.
            if root.selecting: Rectangle {
                x: root.round ? root.size * 0.15 : 10px;
                y: self.x;
                width: 32px;
                height: 32px;
                border-radius: self.height / 2;
                border-width: root.selected ? 0 : 2px;
                border-color: white;
                background: root.selected ? Theme.accent : #00000059;
                if root.selected: Path {
                    x: 5px;
                    y: 5px;
                    width: 22px;
                    height: 22px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.check;
                    stroke: Theme.on-accent;
                    stroke-width: 3px;
                }
            }
        }
        Rectangle { height: 2px; }
        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                text: root.title;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: root.round ? center : left;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.entries.length > 0 || root.downloadable: MoreMenu {
                visible: !root.saved;
                label: "More for " + root.title;
                opening => {
                    self.entries = root.entries;
                    if root.downloadable && root.downloaded {
                        self.entries.push({ id: "remove-download", label: "Remove download", icon: Icons.trash });
                    } else if root.downloadable {
                        self.entries.push({ id: "download", label: "Download", icon: Icons.download });
                    }
                }
                activated(id, choice) => { root.activated(id, choice); }
            }
        }
        if root.names.length > 0: LinksLine {
            names: root.names;
            alignment: root.round ? LayoutAlignment.center : LayoutAlignment.stretch;
            font-size: Theme.small;
            open(link) => { root.open(link); }
            context-clicked => { root.context-clicked(); }
        }
    }
    drop := FolderDrop {
        enabled: root.drop-target;
        moved => { root.dropped(); }
    }
}

// An artist, composer or other performer, with what they did here.
export component PersonTile inherits Pressable {
    in property <image> photo;
    in property <string> name;
    in property <string> role;
    in property <length> size: 140px;
    label: self.role == "" ? self.name : self.name + ", " + self.role;

    VerticalLayout {
        width: root.size;
        alignment: start;
        spacing: 4px;
        Artwork {
            size: root.size;
            round: true;
            source: root.photo;
            highlighted: root.hovered;
        }
        Rectangle { height: 2px; }
        Text {
            text: root.name;
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.role != "": Text {
            text: root.role;
            font-size: Theme.small;
            color: Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// The tint and outline of a selected row. The outline runs on past the row
// where a neighbour is selected, and is cut off there, so selected rows next
// to each other read as one block.
component SelectedRowOutline inherits Rectangle {
    in property <bool> joined-above;
    in property <bool> joined-below;

    clip: true;
    Rectangle {
        property <length> past: Theme.radius + 2px;
        y: root.joined-above ? -self.past : 0;
        height: parent.height + (root.joined-above ? self.past : 0) + (root.joined-below ? self.past : 0);
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent.transparentize(85%);
    }
}

// The album's cover in a row of the tracks table, or of a row that shows one
// as it does; a folder's icon stands in until it has a cover.
component LineCover inherits Rectangle {
    in property <image> source;
    in property <bool> folder;
    border-radius: 3px;
    background: Theme.hover;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    if root.folder && root.source.width == 0: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.folder;
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }
}

// A track, or on a classical album a work: a work's row is strong, and the
// rows of its movements under it are parts, indented. Its names are its
// composers, `split` of them, then its performers.
export component TrackRow inherits Pressable {
    in property <string> title;
    in property <[Name]> names;
    in property <int> split;
    in property <string> duration;
    // When a work was written, after its title, and when and where it was
    // recorded, under its names.
    in property <string> years;
    in property <string> performed;
    in property <bool> loved;
    in property <bool> lovable: true;
    // Whether it shows its album's cover before its title, at the size of
    // the tracks table's cover column.
    in property <bool> covered;
    in property <image> cover;
    // Whether its song is kept on this device.
    in property <bool> downloaded;
    in property <bool> strong;
    in property <bool> part;
    // The playlists its menu can add it to, as names linking to their ids,
    // whether it can take it off the playlist it is on, and whether it can
    // open the tags dialog for it.
    in property <[Name]> playlists;
    in property <bool> removable;
    in property <bool> taggable;
    // Whether its menu can play from it.
    in property <bool> playable;
    // Whether its menu can download its song, or take back a download of it
    // alone.
    in property <bool> downloadable;
    in property <bool> download-removable;
    // Whether its song is selected, and whether the page is selecting, when
    // a click selects rather than plays.
    in property <bool> selected;
    in property <bool> selecting;
    // Whether the rows above and below it are selected too.
    in property <bool> joined-above;
    in property <bool> joined-below;
    // Whether the library lacks its song: greyed, and it can't be played,
    // selected or opened.
    in property <bool> unavailable;
    callback open(link: string);
    callback toggle-love();
    // With Shift held, everything from the row last picked to this one.
    callback select(range: bool);
    callback add-to-playlist(id: string);
    callback remove();
    callback tag();
    callback play();
    callback download();
    callback remove-download();
    // Puts its song in the queue, to play next or at the end.
    callback queue(next: bool);
    label: self.title;
    enabled: !root.unavailable;
    opacity: root.unavailable ? 0.45 : 1;
    clicked => {
        if root.selecting {
            root.select(root.shift);
        } else if root.playable {
            root.play();
        }
    }
    context-clicked => { root.select(root.shift); }

    if root.selected: SelectedRowOutline {
        joined-above: root.joined-above;
        joined-below: root.joined-below;
    }
    Rectangle {
        border-radius: Theme.radius;
        background: !root.selected && root.hovered ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        if root.covered: LineCover {
            cross-axis-self-alignment: center;
            width: 42px;
            height: 42px;
            source: root.cover;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-left: root.part ? 20px : 0px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: Theme.body;
                    min-width: root.strong ? 96px : 0px;
                    font-weight: root.strong ? 600 : 400;
                    color: Theme.text;
                    wrap: root.strong ? word-wrap : no-wrap;
                    overflow: elide;
                }
                if root.years != "": Text {
                    text: root.years;
                    font-size: Theme.small;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.names.length > 0: Links {
                names: root.names;
                split: root.split;
                font-size: Theme.small;
                open(link) => { root.open(link); }
                context-clicked => { root.select(false); }
            }
            if root.performed != "": Text {
                text: root.performed;
                font-size: Theme.small;
                color: Theme.muted;
                overflow: elide;
            }
        }
        IconButton {
            cross-axis-self-alignment: center;
            visible: root.lovable && !root.unavailable;
            enabled: root.lovable && !root.unavailable;
            icon: Icons.heart;
            filled: root.loved;
            color: root.loved ? Theme.accent : Theme.muted;
            label: "Love " + root.title;
            accessible-checkable: true;
            accessible-checked: root.loved;
            clicked => { root.toggle-love(); }
        }
        // A slot kept whether or not the song is downloaded, so the hearts
        // and times of the rows stay in line.
        if root.downloadable || root.downloaded: Rectangle {
            width: 14px;
            if root.downloaded: Path {
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.download;
                stroke: Theme.muted;
                stroke-width: 2px;
                accessible-role: image;
                accessible-label: "Downloaded";
            }
        }
        Text {
            horizontal-stretch: 0;
            min-width: 44px;
            text: root.duration;
            font-size: Theme.detail;
            color: Theme.muted;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if !root.unavailable && (root.playlists.length > 0 || root.removable || root.taggable || root.playable || root.downloadable): MoreMenu {
            cross-axis-self-alignment: center;
            label: "More for " + root.title;
            opening => {
                self.entries = [];
                if root.playable {
                    self.entries.push({ id: "play", label: "Play from here", icon: Icons.play });
                    self.entries.push({ id: "next", label: "Play next", icon: Icons.next });
                    self.entries.push({ id: "queue", label: "Add to queue", icon: Icons.queue });
                }
                if root.playlists.length > 0 {
                    self.entries.push({ id: "playlist", label: "Add to playlist", icon: Icons.playlist, choices: root.playlists });
                }
                if root.removable {
                    self.entries.push({ id: "remove", label: "Remove from playlist", icon: Icons.unlist });
                }
                if root.taggable {
                    self.entries.push({ id: "tags", label: "Tags", icon: Icons.tag });
                }
                if root.downloadable && !root.downloaded {
                    self.entries.push({ id: "download", label: "Download", icon: Icons.download });
                }
                if root.downloadable && root.download-removable {
                    self.entries.push({ id: "remove-download", label: "Remove download", icon: Icons.trash });
                }
            }
            activated(id, choice) => {
                if id == "play" {
                    root.play();
                } else if id == "next" || id == "queue" {
                    root.queue(id == "next");
                } else if id == "playlist" {
                    root.add-to-playlist(choice);
                } else if id == "tags" {
                    root.tag();
                } else if id == "download" {
                    root.download();
                } else if id == "remove-download" {
                    root.remove-download();
                } else {
                    root.remove();
                }
            }
        }
    }
}

// A column of the tracks table: its heading and width, how narrow it gets on
// a window short of room, whether it takes the room left over, whether it
// holds the heart or the album's cover, and whether the table is sorted by it
// and which way.
export struct TrackColumn {
    title: string,
    width: length,
    least: length,
    stretch: bool,
    heart: bool,
    cover: bool,
    sorted: bool,
    descending: bool,
}

// A row of the tracks table: its song's title, what it shows in each column,
// in the columns' order, whether its song is loved, its album's cover, whether it is a
// folder, whether it is selected, and its album and artists for its menu,
// where they have a page. Its own link, a song's or a folder's, and for a
// folder whether all of it is kept on this device.
export struct TrackLine {
    title: string,
    cells: [[Name]],
    loved: bool,
    cover: image,
    folder: bool,
    selected: bool,
    album: Name,
    artists: [Name],
    link: string,
    downloaded: bool,
}

// One item of a list, such as a user: its name, a link to its page when it
// has one, a line about it, and its menu, which `opening` may fill. Items
// under another, such as tags, sit `depth` steps in. A list is not a table:
// no columns, filter, heart or selection.
export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> link;
    in property <string> details;
    in property <int> depth;
    // A cover before the words, when `covered`; and whether it is the one
    // playing.
    in property <image> cover;
    in property <bool> covered;
    in property <bool> current;
    // Whether what is playing is paused, which its row says on its cover.
    in property <bool> paused;
    // A row that opens to the rows under it, with a button to do so.
    in property <bool> expandable;
    in property <bool> expanded;
    in-out property <[MenuEntry]> entries;
    // Room kept free at the right, for what is laid over the row.
    in property <length> reserve;
    callback open(link: string);
    callback toggled();
    callback opening();
    callback activated(id: string, choice: string);
    accessible-role: list-item;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;
    accessible-label: self.title;
    accessible-description: root.current ? (root.paused ? "Paused. " : "Playing. ") + self.details : self.details;
    border-radius: Theme.radius;
    background: root.current ? Theme.accent.transparentize(88%) : transparent;

    // The row playing: a bar at its edge, and on its cover the state.
    if root.current: Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding: 8px;
        padding-left: 8px + root.depth * 20px;
        padding-right: 8px + root.reserve;
        spacing: 12px;
        if root.covered: Artwork {
            cross-axis-self-alignment: center;
            size: 40px;
            source: root.cover;
            if root.current: Rectangle {
                background: #00000099;
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    // Paused, it is the pause button's mark; playing, sound bars.
                    commands: root.paused ? Icons.pause : "M6 13v5 M12 6v12 M18 10v8";
                    fill: root.paused ? white : transparent;
                    stroke: white;
                    stroke-width: root.paused ? 0px : 2.5px;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            if root.link == "": Text {
                text: root.title;
                font-size: Theme.body;
                font-weight: root.current ? 700 : 600;
                color: root.current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            if root.link != "": Link {
                text: root.title;
                font-weight: 600;
                color: root.current ? Theme.accent : Theme.text;
                clicked => { root.open(root.link); }
            }
            if root.details != "": Text {
                text: root.details;
                font-size: Theme.small;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if root.expandable: IconButton {
            cross-axis-self-alignment: center;
            label: (root.expanded ? "Hide the movements of " : "Show the movements of ") + root.title;
            icon: root.expanded ? Icons.chevron-up : Icons.chevron-down;
            clicked => { root.toggled(); }
        }
        if root.entries.length > 0: MoreMenu {
            cross-axis-self-alignment: center;
            label: "More for " + root.title;
            entries: root.entries;
            opening => { root.opening(); }
            activated(id, choice) => { root.activated(id, choice); }
        }
    }
}

// A section of the settings on their list: its icon, its name, a line on
// what it holds, and an arrow to the page it opens.
export component SettingsRow inherits Pressable {
    in property <string> icon;
    in property <string> title;
    in property <string> summary;
    label: self.title;
    // Material's one-line and two-line list rows on a phone.
    min-height: !Screen.phone ? 52px : root.summary == "" ? 56px : 72px;

    Rectangle {
        border-radius: Theme.radius;
        background: root.hovered ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        Path {
            cross-axis-self-alignment: center;
            width: Screen.phone ? Theme.phone-icon : 22px;
            height: self.width;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            stroke: Theme.muted;
            stroke-width: 1.75px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.summary != "": Text {
                text: root.summary;
                font-size: Theme.small;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Path {
            cross-axis-self-alignment: center;
            width: Screen.phone ? Theme.phone-icon : 16px;
            height: self.width;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.forward;
            stroke: Theme.muted;
            stroke-width: 1.75px;
        }
    }
}

// On a phone the columns keep their widths, so the title stays wide, and the
// table scrolls sideways sooner.
component TableCell inherits Rectangle {
    in property <TrackColumn> column;
    min-width: Screen.phone ? self.column.width : self.column.least;
    preferred-width: self.column.width;
    max-width: self.column.stretch ? 100000px : self.column.width;
    horizontal-stretch: self.column.stretch ? 1 : 0;
}

// The headings over the tracks table's rows, as wide as they are. A click on
// one sorts the table by it; on the one it is sorted by, turns that around.
export component TrackHeader inherits HorizontalLayout {
    in property <[TrackColumn]> columns;
    callback sort(index: int);
    padding-left: 8px;
    padding-right: 8px;
    spacing: 12px;
    height: (Screen.phone ? Theme.phone-target : 32px) * Theme.zoom;

    for column[c] in root.columns: TableCell {
        column: column;
        Pressable {
            width: parent.width;
            height: parent.height;
            // Covers have nothing to sort by.
            enabled: !column.cover;
            label: column.cover ? column.title : "Sort by " + column.title;
            accessible-description: !column.sorted ? "" : column.descending ? "Sorted descending" : "Sorted ascending";
            clicked => { root.sort(c); }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    horizontal-stretch: 0;
                    text: column.heart || column.cover ? "" : column.title;
                    font-size: Theme.small;
                    font-weight: 600;
                    color: column.sorted ? Theme.text : Theme.muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if column.sorted: Path {
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: column.descending ? Icons.down : Icons.up;
                    stroke: Theme.text;
                    stroke-width: 2px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }
    // Over the rows' menu buttons.
    Rectangle {
        width: Screen.phone ? Theme.phone-target : 32px;
    }
}

// The 3-dot menu of a song, whether in a table's row or on the now playing
// sheet, whose song is the one that plays.
export component TrackMenu inherits MoreMenu {
    in property <TrackLine> line;
    // The playlists its menu can add the song to, as names linking to their
    // ids; none for a row that holds no songs, such as a composition's.
    // Whether it opens the tags dialog for the song.
    in property <[Name]> playlists;
    in property <bool> taggable;
    // Whether it plays the songs from the song on, and queues it; and whether
    // it selects it, for a song in a table. A folder's row has an album's
    // menu: it plays and queues every song in it, and is downloaded as one.
    in property <bool> playable;
    in property <bool> selectable: true;
    in property <bool> downloadable;
    callback open(link: string);
    callback toggle-love();
    callback select(range: bool);
    callback add-to-playlist(id: string);
    callback tag();
    callback play();
    // Puts the song in the queue, to play next or at the end.
    callback queue(next: bool);
    callback download();
    callback remove-download();

    label: "More for " + root.line.title;
    opening => {
        self.entries = [];
        if root.playable {
            self.entries.push({ id: "play", label: root.line.folder ? "Play now" : "Play from here", icon: Icons.play });
            self.entries.push({ id: "next", label: "Play next", icon: Icons.next });
            self.entries.push({ id: "queue", label: "Add to queue", icon: Icons.queue });
        }
        self.entries.push({ id: "love", label: root.line.loved ? "Unlove" : "Love", icon: Icons.heart });
        if root.line.album.link != "" {
            self.entries.push({ id: "album", label: "Go to album", icon: Icons.album });
        }
        if root.line.artists.length == 1 {
            self.entries.push({ id: "artist", label: "Go to artist", icon: Icons.artist });
        } else if root.line.artists.length > 1 {
            self.entries.push({ id: "artist", label: "Go to artist", icon: Icons.artist, choices: root.line.artists });
        }
        if root.playlists.length > 0 {
            self.entries.push({ id: "playlist", label: "Add to playlist", icon: Icons.playlist, choices: root.playlists });
        }
        if root.taggable {
            self.entries.push({ id: "tags", label: "Tags", icon: Icons.tag });
        }
        if root.line.folder && root.downloadable && root.line.downloaded {
            self.entries.push({ id: "remove-download", label: "Remove download", icon: Icons.trash });
        } else if root.line.folder && root.downloadable {
            self.entries.push({ id: "download", label: "Download", icon: Icons.download });
        }
        if root.selectable {
            self.entries.push({ id: "select", label: root.line.selected ? "Deselect" : "Select", icon: Icons.check });
        }
    }
    activated(id, choice) => {
        if id == "play" {
            root.play();
        } else if id == "next" || id == "queue" {
            root.queue(id == "next");
        } else if id == "love" {
            root.toggle-love();
        } else if id == "album" {
            root.open(root.line.album.link);
        } else if id == "artist" {
            root.open(choice != "" ? choice : root.line.artists[0].link);
        } else if id == "playlist" {
            root.add-to-playlist(choice);
        } else if id == "tags" {
            root.tag();
        } else if id == "download" {
            root.download();
        } else if id == "remove-download" {
            root.remove-download();
        } else {
            root.select(false);
        }
    }
}

// A row of the tracks table, cells lined up under `TrackHeader`'s headings.
// Names in it are links, and the heart loves its song. A right-click or a
// long press selects it, as do clicks while the page is selecting; the button
// at its end opens its menu.
export component TrackLineRow inherits Rectangle {
    in property <[TrackColumn]> columns;
    in property <TrackLine> line;
    in property <bool> striped;
    in property <bool> selecting;
    // Whether the rows above and below it are selected too.
    in property <bool> joined-above;
    in property <bool> joined-below;
    // The playlists its menu can add its song to, as names linking to their
    // ids; none for a row that holds no songs, such as a composition's.
    // Whether its menu opens the tags dialog for its song.
    in property <[Name]> playlists;
    in property <bool> taggable;
    // Whether its menu plays the songs from it on, and downloads a folder.
    in property <bool> playable;
    in property <bool> downloadable;
    callback open(link: string);
    callback toggle-love();
    // With Shift held, everything from the row last picked to this one.
    callback select(range: bool);
    callback add-to-playlist(id: string);
    callback tag();
    callback play();
    // Puts its song in the queue, to play next or at the end.
    callback queue(next: bool);
    callback download();
    callback remove-download();
    property <bool> shift;

    height: 54px * Theme.zoom;
    border-radius: Theme.radius;
    background: root.line.selected ? transparent : touch.has-hover ? Theme.hover : root.striped ? Theme.hover.transparentize(50%) : transparent;
    accessible-role: list-item;
    accessible-label: root.line.title;
    accessible-item-selectable: root.selecting;
    accessible-item-selected: root.line.selected;

    if root.line.selected: SelectedRowOutline {
        joined-above: root.joined-above;
        joined-below: root.joined-below;
    }

    // The row's content sits in it, so the row stays hovered over its links.
    touch := TouchArea {
        mouse-cursor: root.selecting ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.selecting && !hold.done {
                root.select(root.shift);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.shift = event.modifiers.shift;
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.select(root.shift);
            }
            hold.pointer(event);
        }
        moved => { hold.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }

        hold := Hold {
            held => { root.select(false); }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            for column[c] in root.columns: slot := TableCell {
                property <[Name]> names: root.line.cells[c];
                // Most cells are one plain value, which a Text draws for less.
                property <bool> plain: self.names.length <= 1 && self.names[0].link == "";
                column: column;
                // As wide as its column on a phone.
                if column.heart: IconButton {
                    y: (parent.height - self.height) / 2;
                    width: Screen.phone ? 40px : 32px;
                    icon: Icons.heart;
                    filled: root.line.loved;
                    color: root.line.loved ? Theme.accent : Theme.muted;
                    label: "Love " + root.line.title;
                    accessible-checkable: true;
                    accessible-checked: root.line.loved;
                    clicked => { root.toggle-love(); }
                }
                if column.cover: LineCover {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    height: self.width;
                    source: root.line.cover;
                    folder: root.line.folder;
                }
                if !column.heart && !column.cover && slot.plain: Text {
                    width: parent.width;
                    height: parent.height;
                    text: slot.names[0].label;
                    font-size: Theme.body;
                    color: column.stretch ? Theme.text : Theme.muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if !column.heart && !column.cover && !slot.plain: LinksLine {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    alignment: start;
                    names: slot.names;
                    // Two names, such as a piece's composers, fit the row.
                    lines: 2;
                    text-color: column.stretch ? Theme.text : Theme.muted;
                    open(link) => { root.open(link); }
                    context-clicked => { root.select(false); }
                }
            }
            TrackMenu {
                cross-axis-self-alignment: center;
                line: root.line;
                playlists: root.playlists;
                taggable: root.taggable;
                playable: root.playable;
                downloadable: root.downloadable;
                open(link) => { root.open(link); }
                toggle-love => { root.toggle-love(); }
                select(range) => { root.select(range); }
                add-to-playlist(id) => { root.add-to-playlist(id); }
                tag => { root.tag(); }
                play => { root.play(); }
                queue(next) => { root.queue(next); }
                download => { root.download(); }
                remove-download => { root.remove-download(); }
            }
        }
    }
}

// A titled row of tiles that scrolls sideways, with the rest behind "See all".
export component Shelf {
    in property <string> title;
    in property <bool> more;
    callback see-all();

    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: Theme.gap;
            Text {
                horizontal-stretch: 1;
                text: root.title;
                font-size: Theme.heading;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.more: Link {
                cross-axis-self-alignment: center;
                text: "See all";
                font-size: Theme.detail;
                clicked => { root.see-all(); }
            }
        }
        Flickable {
            height: row.preferred-height;
            content-width: row.preferred-width;
            row := HorizontalLayout {
                width: self.preferred-width;
                spacing: Theme.gap;
                @children
            }
        }
    }
}

// A genre's banner: the wide picture of an artist known for it, in the tint
// every genre's picture shares, with the genre's name over it.
export component GenreBanner inherits Rectangle {
    in property <image> picture;
    in property <string> name;
    // A smaller line under the name.
    in property <string> caption;
    in property <length> name-size: 28px;
    in property <bool> hovered;
    // The tint's dark end, while the picture is on its way or where there is
    // none.
    in property <brush> backdrop: #1c1c2c;
    // Over the picture, fading in with it.
    in property <brush> wash: transparent;

    border-radius: Theme.radius;
    clip: true;
    background: root.backdrop;
    art := Image {
        width: 100%;
        height: 100%;
        source: root.picture;
        image-fit: cover;
        opacity: self.source.width > 0 ? 1 : 0;
        animate opacity { duration: 400ms; }
    }
    Rectangle {
        background: root.wash;
        opacity: art.opacity;
    }
    Rectangle {
        background: root.hovered ? #00000026 : transparent;
    }
    // So the name reads on a bright picture too.
    Rectangle { background: @linear-gradient(0deg, #00000066 0%, #00000000 60%); }
    VerticalLayout {
        alignment: center;
        padding: 12px;
        Text {
            text: root.name;
            color: white;
            font-size: root.name-size;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
            // A long name of its own keeps the caption in the tile.
            max-lines: 2;
            overflow: elide;
        }
        if root.caption != "": Text {
            text: root.caption;
            color: #ffffffcc;
            font-size: Theme.detail;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// The colours of a playlist ListenBrainz made, by what kind it is: green for
// the weekly ones, red for the yearly, blue for the others.
export global KindTints {
    pure function dark(tint: KindTint) -> color {
        return tint == KindTint.green ? #1f5a3a : tint == KindTint.red ? #6a2326 : #22427a;
    }
    pure function light(tint: KindTint) -> color {
        return tint == KindTint.green ? #3f9b66 : tint == KindTint.red ? #b8454a : #3f78c4;
    }
    // Where there is no picture.
    pure public function backdrop(tint: KindTint) -> brush {
        return @linear-gradient(135deg, dark(tint) 0%, light(tint) 100%);
    }
    // Over a picture, which it dims.
    pure public function wash(tint: KindTint) -> brush {
        return dark(tint).with-alpha(0.6);
    }
}

// A genre in a grid, opening its page.
export component GenreTile inherits Pressable {
    in property <image> picture;
    in property <string> name;
    in property <string> albums;
    in property <length> name-size: 28px;
    in property <string> caption;
    in property <brush> backdrop: #1c1c2c;
    in property <brush> wash: transparent;
    label: self.albums == "" ? self.name : self.name + ", " + self.albums;

    GenreBanner {
        picture: root.picture;
        name: root.name;
        caption: root.caption;
        backdrop: root.backdrop;
        wash: root.wash;
        name-size: root.name-size;
        hovered: root.hovered;
    }
}

// Genres in rows of two pictures across the width, each as wide as a banner
// is: 16 to 9.
export component GenreGrid {
    in property <[AlbumTile]> tiles;
    callback open(link: string);

    property <float> tile-ratio: 9 / 16;
    property <length> gap: Theme.gap;
    property <int> columns: 2;
    property <length> size: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> tile-height: self.size * self.tile-ratio;
    height: self.tiles.length == 0 ? 0 : ceil(self.tiles.length / self.columns) * (self.tile-height + self.gap) - self.gap;

    for tile[i] in root.tiles: GenreTile {
        x: mod(i, root.columns) * (root.size + root.gap);
        y: floor(i / root.columns) * (root.tile-height + root.gap);
        width: root.size;
        height: root.tile-height;
        picture: tile.cover;
        name: tile.title;
        albums: tile.names.length > 0 ? tile.names[0].label : "";
        name-size: max(16px, min(32px, root.size / 9));
        clicked => { root.open(tile.link); }
    }
}

// Album tiles in rows across the width. Tiles are at least `min-size` wide
// and widen to fill their row. The grid places them itself rather than in a
// layout, so it knows its height for any width and a scroll view around it
// reaches the last row.
export component CoverGrid {
    in property <[AlbumTile]> tiles;
    in property <length> min-size: 200px;
    // The part of the grid on screen, in the grid's own coordinates.
    in property <length> view-top;
    in property <length> view-height;
    // Round tiles, for artists.
    in property <bool> round;
    // While some tiles are selected, a click selects another tile, or lets a
    // selected one go, instead of opening it.
    in property <bool> selecting;
    // Each tile's menu, the same for all but folders, which have none.
    in property <[MenuEntry]> entries;
    // Whether tiles that aren't folders can be dragged with a mouse onto
    // those that are, playlists into folders.
    in property <bool> movable;
    // Whether their menus offer to download them.
    in property <bool> downloadable;
    callback open(link: string);
    // A tile right-clicked, or clicked while selecting; with Shift held,
    // every tile from the one last picked to it.
    callback select(index: int, range: bool);
    // The tiles on screen and a screen below it, whenever that changes.
    callback in-view(first: int, last: int);
    callback activated(index: int, id: string, choice: string);
    // A tile dropped onto the folder tile at `index`.
    callback dropped(index: int);

    property <length> gap: Theme.gap;
    property <length> row-gap: 24px;
    // Two at least, so a phone doesn't get one cover the width of the screen.
    property <int> columns: max(2, floor((self.width + self.gap) / (self.min-size + self.gap)));
    property <length> size: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <int> rows: ceil(self.tiles.length / self.columns);
    property <length> row-height: probe.preferred-height;
    height: self.rows == 0 ? 0 : self.rows * (self.row-height + self.row-gap) - self.row-gap;

    property <length> pitch: self.row-height + self.row-gap;
    property <int> first-in-view: max(0, floor(self.view-top / self.pitch)) * self.columns;
    property <int> last-in-view: min(self.tiles.length, (floor((self.view-top + 2 * self.view-height) / self.pitch) + 1) * self.columns) - 1;
    init => {
        self.in-view(self.first-in-view, self.last-in-view);
    }
    changed first-in-view => {
        self.in-view(self.first-in-view, self.last-in-view);
    }
    changed last-in-view => {
        self.in-view(self.first-in-view, self.last-in-view);
    }

    // Measures a tile's height at this width.
    probe := CoverTile {
        visible: false;
        enabled: false;
        size: root.size;
        title: "Probe";
        names: [{ label: "Probe", link: "" }];
        entries: root.entries;
        downloadable: root.downloadable;
    }

    // A finger never drags: it scrolls, and a long press selects.
    for tile[i] in root.tiles: drag := DragArea {
        x: mod(i, root.columns) * (root.size + root.gap);
        y: floor(i / root.columns) * (root.row-height + root.row-gap);
        width: root.size;
        height: root.row-height;
        enabled: root.movable && !tile.folder && !card.finger;
        allow-move: true;
        data: Drag.data;
        changed dragging => {
            if self.dragging {
                Drag.link = tile.link;
            }
        }
        drag-finished => { Drag.link = ""; }
        card := CoverTile {
            width: parent.width;
            height: parent.height;
            opacity: drag.dragging ? 0.4 : 1;
            size: root.size;
            round: root.round;
            folder: tile.folder;
            logo: tile.logo;
            dark-plate: tile.dark-plate;
            cover: tile.cover;
            title: tile.title;
            names: tile.names;
            selecting: root.selecting;
            selected: tile.selected;
            entries: tile.folder ? [] : root.entries;
            downloaded: tile.downloaded;
            downloadable: root.downloadable && !tile.folder;
            drop-target: root.movable && tile.folder;
            activated(id, choice) => { root.activated(i, id, choice); }
            dropped => { root.dropped(i); }
            clicked => {
                if root.selecting {
                    root.select(i, self.shift);
                } else if tile.link != "" {
                    root.open(tile.link);
                }
            }
            context-clicked => { root.select(i, self.shift); }
            open(link) => {
                if root.selecting {
                    root.select(i, false);
                } else {
                    root.open(link);
                }
            }
        }
    }
}

// A titled row of album tiles that slides sideways: as many to the width, and
// as wide, as a CoverGrid's of the same width, so the two line up. It comes to
// rest with a tile at its left edge. A finger or a mouse dragging it glides on
// when let go while moving, as a fling does, to the tile nearest to where the
// glide ends; a sideways scroll goes on to the next tile in its direction, the
// buttons a whole width at a time.
export component CoverShelf {
    in property <string> title;
    in property <[AlbumTile]> tiles;
    in property <length> min-size: 200px;
    in property <bool> round;
    // Wide tiles, two to one, each a banner with its title over it.
    in property <bool> wide;
    in property <bool> selecting;
    // Each tile's menu, the same for all.
    in property <[MenuEntry]> entries;
    // Whether "See all" beside the title opens a page with all of them.
    in property <bool> more;
    callback open(link: string);
    callback select(index: int, range: bool);
    callback in-view(first: int, last: int);
    callback activated(index: int, id: string);
    callback see-all();

    property <length> gap: Theme.gap;
    property <int> columns: max(self.wide ? 1 : 2, floor((self.width + self.gap) / (self.min-size + self.gap)));
    property <length> size: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> tile-height: self.wide ? self.size / 2 : probe.preferred-height;
    property <[AlbumTile]> cover-tiles: self.wide ? [] : self.tiles;
    property <[AlbumTile]> banner-tiles: self.wide ? self.tiles : [];
    property <length> pitch: self.size + self.gap;
    // The tile at the left edge, and the furthest one that can be.
    property <int> first;
    property <int> last-first: max(0, self.tiles.length - self.columns);
    // The tile at the left edge on its way there, gliding over `glide-time`:
    // a fling's own time, else a `step`.
    property <float> at: self.first;
    property <duration> step: 250ms;
    property <duration> glide-time: self.step;
    animate at { duration: root.glide-time; easing: Fling.curve; }
    // How far a sideways scroll has moved it, while scrolling.
    property <length> scrolled;
    property <bool> scrolling;

    changed last-first => { self.first = min(self.first, self.last-first); }

    // The tiles on screen and a screen to the right.
    property <int> first-in-view: self.first;
    property <int> last-in-view: min(self.tiles.length, self.first + 2 * self.columns) - 1;
    init => {
        self.in-view(self.first-in-view, self.last-in-view);
    }
    changed first-in-view => {
        self.in-view(self.first-in-view, self.last-in-view);
    }
    changed last-in-view => {
        self.in-view(self.first-in-view, self.last-in-view);
    }

    // Comes to rest with `tile`, or the nearest one there can be, at the
    // left edge, gliding there over `time`.
    function rest-on(tile: int, time: duration) {
        self.glide-time = time;
        self.first = clamp(tile, 0, self.last-first);
    }

    // Comes to rest on the next tile the way it was `moved`.
    function settle(moved: length) {
        if moved < 0 {
            self.rest-on(self.first + ceil(-moved / self.pitch), self.step);
        } else if moved > 0 {
            self.rest-on(self.first - ceil(moved / self.pitch), self.step);
        }
    }

    // Comes to rest on the tile nearest to where it glides to once let go
    // of at `speed`, `moved` from where it rested.
    function fling(moved: length, speed: float) {
        let glided = self.first * self.pitch - moved - Fling.distance(speed);
        self.rest-on(Math.round(glided / self.pitch), max(self.step, Fling.time(speed)));
    }

    // The finger that first moved over the shelf after landing on the page,
    // by its count (Landing), and whether the page's drag slides the shelf
    // for it; once it lets go, the shelf flings.
    property <int> landing: -1;
    property <bool> page-slides: self.landing == Landing.count && Landing.sliding;
    changed page-slides => {
        if !self.page-slides {
            self.fling(Landing.slid, Landing.flung);
        }
    }
    function claim() {
        self.landing = Landing.count;
        Landing.shelved = Landing.count;
    }

    // Measures a tile's height at this width. A wide shelf has no use for it,
    // and a square tile's height would add to the shelf's own.
    probe := CoverTile {
        visible: false;
        enabled: false;
        size: root.wide ? 1px : root.size;
        title: "Probe";
        names: [{ label: "Probe", link: "" }];
        entries: root.entries;
    }

    speed := FingerSpeed { }

    // A sideways scroll settles once it pauses.
    pause := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            root.scrolling = false;
            root.settle(root.scrolled);
            root.scrolled = 0;
        }
    }

    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                text: root.title;
                font-size: Theme.heading;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            // As tall as the row, a target big enough for a finger.
            if root.more: Link {
                text: "See all";
                font-size: Theme.detail;
                label: "See all " + root.title;
                clicked => { root.see-all(); }
            }
            // A finger slides the shelf on a phone, where the title takes
            // the arrows' room.
            if root.last-first > 0 && !Screen.phone: IconButton {
                icon: Icons.back;
                label: "Previous in " + root.title;
                enabled: root.first > 0;
                clicked => { root.rest-on(root.first - root.columns, root.step); }
            }
            if root.last-first > 0 && !Screen.phone: IconButton {
                icon: Icons.forward;
                label: "Next in " + root.title;
                enabled: root.first < root.last-first;
                clicked => { root.rest-on(root.first + root.columns, root.step); }
            }
        }
        swipe := SwipeGestureHandler {
            height: root.tile-height;
            // Its ends take a drag too, which goes nowhere there, rather
            // than a tap on the tile under it.
            handle-swipe-left: root.last-first > 0;
            handle-swipe-right: root.last-first > 0;
            // While it slides the page lets go of the finger, which would
            // otherwise take it over on drifting up or down.
            moved => {
                if !self.swiping {
                    return;
                }
                if Input.sliding {
                    speed.follow(self.current-position.x);
                } else {
                    speed.begin(self.current-position.x);
                    Input.sliding = true;
                }
            }
            swiped => {
                Input.sliding = false;
                root.fling(self.current-position.x - self.pressed-position.x, speed.at-release(self.current-position.x));
            }
            cancelled => { Input.sliding = false; }

            TouchArea {
                changed mouse-x => { root.claim(); }
                changed mouse-y => { root.claim(); }
                scroll-event(event) => {
                    if abs(event.delta-x) <= abs(event.delta-y) {
                        return reject;
                    }
                    root.scrolled = clamp(root.scrolled + event.delta-x, (root.first - root.last-first) * root.pitch, root.first * root.pitch);
                    root.scrolling = true;
                    if pause.running {
                        pause.restart();
                    } else {
                        pause.start();
                    }
                    accept
                }

                // Cut off a little outside, so a selected tile's outline shows.
                Rectangle {
                    x: -8px;
                    y: -8px;
                    width: parent.width + 16px;
                    height: parent.height + 16px;
                    clip: true;
                    Rectangle {
                        // Where a finger, the page's drag or a scroll has the
                        // tiles, which glide back from there to where they rest.
                        property <length> offset;
                        x: 8px - root.at * root.pitch + self.offset;
                        y: 8px;
                        states [
                            swiping when swipe.swiping || root.page-slides: {
                                offset: clamp(root.page-slides ? Landing.slid : swipe.current-position.x - swipe.pressed-position.x, (root.first - root.last-first) * root.pitch, root.first * root.pitch);
                                out {
                                    animate offset { duration: root.glide-time; easing: Fling.curve; }
                                }
                            }
                            scrolling when root.scrolling: {
                                offset: root.scrolled;
                                out {
                                    animate offset { duration: root.glide-time; easing: Fling.curve; }
                                }
                            }
                        ]

                        for tile[i] in root.banner-tiles: GenreTile {
                            x: i * root.pitch;
                            y: 0;
                            width: root.size;
                            height: root.tile-height;
                            picture: tile.cover;
                            name: tile.title;
                            albums: tile.names.length > 0 ? tile.names[0].label : "";
                            caption: self.albums;
                            name-size: max(16px, min(32px, root.size / 10));
                            backdrop: KindTints.backdrop(tile.tint);
                            wash: KindTints.wash(tile.tint);
                            // A tile reached with Tab slides into view.
                            changed focused => {
                                if self.focused && i < root.first {
                                    root.rest-on(i, root.step);
                                } else if self.focused && i >= root.first + root.columns {
                                    root.rest-on(i - root.columns + 1, root.step);
                                }
                            }
                            clicked => { root.open(tile.link); }
                        }

                        for tile[i] in root.cover-tiles: CoverTile {
                            x: i * root.pitch;
                            y: 0;
                            width: root.size;
                            height: root.tile-height;
                            size: root.size;
                            round: root.round;
                            logo: tile.logo;
                            dark-plate: tile.dark-plate;
                            saved: tile.saved;
                            cover: tile.cover;
                            title: tile.title;
                            names: tile.names;
                            selecting: root.selecting;
                            selected: tile.selected;
                            entries: root.entries;
                            activated(id) => { root.activated(i, id); }
                            // A tile reached with Tab slides into view.
                            changed focused => {
                                if self.focused && i < root.first {
                                    root.rest-on(i, root.step);
                                } else if self.focused && i >= root.first + root.columns {
                                    root.rest-on(i - root.columns + 1, root.step);
                                }
                            }
                            clicked => {
                                if root.selecting {
                                    root.select(i, self.shift);
                                } else if tile.link != "" {
                                    root.open(tile.link);
                                }
                            }
                            context-clicked => { root.select(i, self.shift); }
                            open(link) => {
                                if root.selecting {
                                    root.select(i, false);
                                } else {
                                    root.open(link);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Floats over the bottom of a page while something on it is selected: how
// many, the actions for them as children, and a button that ends selecting.
export component SelectionBar inherits Rectangle {
    in property <int> count;
    callback clear();

    border-radius: 12px;
    background: Theme.accent;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #0000004d;
    accessible-role: region;
    accessible-label: "Selection";

    // Keeps clicks on the bar from reaching the tiles under it.
    TouchArea { }
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        spacing: 8px;
        Text {
            text: root.count + " selected";
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.on-accent;
            vertical-alignment: center;
            accessible-live-region: polite;
        }
        // Their focus rings are in the bar's text colour, as the accent
        // colour would not show on it.
        @children
        IconButton {
            cross-axis-self-alignment: center;
            icon: Icons.close;
            label: "Clear selection";
            color: Theme.on-accent;
            ring-color: Theme.on-accent;
            clicked => { root.clear(); }
        }
    }
}

// The Play button of an album's or a playlist's header, split in two joined
// segments: Play itself, and a chevron opening a menu to play the songs next
// or add them to the queue.
export component PlayButton inherits HorizontalLayout {
    in property <bool> enabled: true;
    callback play();
    // How to queue the songs: "next", "queue", "shuffle-now", "shuffle-next"
    // or "shuffle-last".
    callback queue(how: string);

    property <length> bar-height: Screen.phone ? Theme.phone-target : 32px;
    property <length> outer-radius: Screen.phone ? root.bar-height / 2 : Theme.radius;
    property <length> inner-radius: 2px;
    property <brush> segment: root.enabled ? Theme.accent : Theme.accent.transparentize(50%);
    // Lightens a segment under the pointer, more while pressed.
    function shade(hovered: bool, pressed: bool) -> brush {
        Theme.on-accent.transparentize(pressed ? 70% : hovered ? 85% : 100%)
    }

    spacing: 0;

    Pressable {
        enabled: root.enabled;
        label: "Play";
        height: root.bar-height;
        clicked => { root.play(); }

        Rectangle {
            background: root.segment;
            border-top-left-radius: root.outer-radius;
            border-bottom-left-radius: root.outer-radius;
            border-top-right-radius: root.inner-radius;
            border-bottom-right-radius: root.inner-radius;
        }
        Rectangle {
            background: root.shade(parent.hovered, parent.pressed);
            border-top-left-radius: root.outer-radius;
            border-bottom-left-radius: root.outer-radius;
            border-top-right-radius: root.inner-radius;
            border-bottom-right-radius: root.inner-radius;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 6px;
            alignment: center;
            // Material's small button on a phone: a 20px icon and Label
            // Large words.
            Path {
                cross-axis-self-alignment: center;
                width: Screen.phone ? 20px : 16px;
                height: self.width;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.play;
                fill: Theme.on-accent;
            }
            Text {
                text: "Play";
                font-size: Theme.detail;
                font-weight: 600;
                color: Theme.on-accent;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        width: 1px;
        height: root.bar-height;

        Rectangle {
            y: 6px;
            height: parent.height - 12px;
            background: Theme.on-accent.transparentize(60%);
        }
    }
    Rectangle {
        width: Screen.phone ? Theme.phone-target : 36px;
        height: root.bar-height;
        background: root.segment;
        border-top-right-radius: root.outer-radius;
        border-bottom-right-radius: root.outer-radius;
        border-top-left-radius: root.inner-radius;
        border-bottom-left-radius: root.inner-radius;

        Rectangle {
            background: root.shade(more.hovered, more.pressed);
            border-top-right-radius: root.outer-radius;
            border-bottom-right-radius: root.outer-radius;
            border-top-left-radius: root.inner-radius;
            border-bottom-left-radius: root.inner-radius;
        }
        more := MoreMenu {
            x: 0;
            width: parent.width;
            height: parent.height;
            label: "More ways to play";
            icon: Icons.chevron;
            filled: false;
            color: Theme.on-accent;
            hover-color: transparent;
            entries: [
                { id: "next", label: "Play next", icon: Icons.next },
                { id: "queue", label: "Add to queue", icon: Icons.queue },
                { id: "shuffle-now", label: "Shuffle now", icon: Icons.shuffle },
                { id: "shuffle-next", label: "Shuffle next", icon: Icons.shuffle },
                { id: "shuffle-last", label: "Shuffle last", icon: Icons.shuffle },
            ];
            activated(id, choice) => { root.queue(id); }
        }
    }
}

// The top of an album, artist, composer or work page. On a narrow window the
// text moves under the artwork. Children go in a row under the facts.
export component PageHeader inherits FlexboxLayout {
    in property <image> artwork;
    // A page whose banner stands in for the cover leaves the cover out.
    in property <bool> show-artwork: true;
    in property <bool> round;
    in property <string> kind;
    in property <string> title;
    in property <[Name]> names;
    in property <string> facts;
    callback open(link: string);

    alignment: stretch;
    cross-axis-alignment: start;
    spacing: 24px;

    if root.show-artwork: Artwork {
        size: 220px;
        round: root.round;
        source: root.artwork;
    }
    VerticalLayout {
        preferred-width: 280px;
        horizontal-stretch: 1;
        alignment: start;
        spacing: 6px;
        if root.kind != "": Text {
            text: root.kind;
            font-size: Theme.label;
            font-weight: 600;
            color: Theme.muted;
        }
        Text {
            text: root.title;
            font-size: Theme.title;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.names.length > 0: Links {
            names: root.names;
            font-size: Theme.body;
            text-color: Theme.text;
            open(link) => { root.open(link); }
        }
        if root.facts != "": Text {
            text: root.facts;
            font-size: Theme.detail;
            color: Theme.muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            @children
        }
    }
}

// The page header's button for keeping the page's songs on this device:
// Download, then how far it has come, then Downloaded. A press while they are
// on their way or kept asks to remove them.
export component DownloadButton inherits HorizontalLayout {
    // 0 not kept, 1 on their way, 2 kept.
    in property <int> state;
    in property <string> progress;
    callback clicked();

    spacing: 4px;
    IconButton {
        cross-axis-self-alignment: center;
        icon: root.state == 2 ? Icons.check : Icons.download;
        color: root.state == 0 ? Theme.muted : Theme.accent;
        label: root.state == 0 ? "Download" : root.state == 1 ? "Downloading " + root.progress + ", remove" : "Downloaded, remove download";
        clicked => { root.clicked(); }
    }
    if root.state == 1: Text {
        cross-axis-self-alignment: center;
        text: root.progress;
        font-size: Theme.small;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

// A section of the sidebar.
component NavButton inherits Pressable {
    in property <string> text;
    in property <string> icon;
    in property <bool> current;
    label: self.text;
    accessible-item-selectable: true;
    accessible-item-selected: self.current;
    min-height: Screen.phone ? Theme.phone-target : 0;

    Rectangle {
        border-radius: Theme.radius;
        background: root.current ? Theme.hover : root.hovered ? Theme.hover.transparentize(50%) : transparent;
    }
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 12px;
        if root.icon != "": Path {
            cross-axis-self-alignment: center;
            width: 18px;
            height: 18px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            stroke: root.current ? Theme.text : Theme.muted;
            stroke-width: 1.75px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Theme.body;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Theme.text : Theme.muted;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// A group's own section, drawn as the group's heading, with a menu of what
// the group offers: the playlists', creating one. A playlist dragged onto
// it goes to the top level.
component NavHeading inherits Pressable {
    in property <string> text;
    in property <bool> current;
    callback new-playlist();
    callback dropped();
    label: self.text;
    accessible-item-selectable: true;
    accessible-item-selected: self.current;
    min-height: Screen.phone ? Theme.phone-target : 32px * Theme.zoom;

    Rectangle {
        border-radius: Theme.radius;
        background: root.current || drop.has-drag ? Theme.hover : root.hovered ? Theme.hover.transparentize(50%) : transparent;
    }
    drop := FolderDrop {
        moved => { root.dropped(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.text;
            font-size: Theme.small;
            font-weight: 600;
            color: root.current ? Theme.text : Theme.muted;
            overflow: elide;
        }
        MoreMenu {
            cross-axis-self-alignment: center;
            label: "More for " + root.text;
            entries: [{ id: "new", label: "New playlist", icon: Icons.plus }];
            activated => { root.new-playlist(); }
        }
    }
}

// The app's logo over the list of library sections down the left side, the
// list scrolling when there are more than fit. `groups[i]` names the group of `items[i]`: sections of one
// group follow each other under its heading, and a section without one is set
// apart by a gap. A group whose first section carries its name has that
// section as its heading. `icons[i]` is drawn in front of `items[i]`. A
// playlist dragged onto a heading goes to `dropped`.
export component Sidebar inherits Rectangle {
    in property <[string]> items;
    in property <[string]> groups;
    in property <[string]> icons;
    in-out property <int> current;
    callback selected(index: int);
    callback new-playlist();
    callback dropped(index: int);

    background: Theme.surface;
    accessible-role: navigation;
    accessible-label: "Library";

    // The app's glyph and name, lined up with the entries' icons and labels.
    HorizontalLayout {
        y: 0;
        height: Theme.bar-height;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        Image {
            cross-axis-self-alignment: center;
            width: 18px;
            height: 26px;
            source: @image-url("clef.png");
            image-fit: contain;
            colorize: Theme.text;
        }
        Text {
            horizontal-stretch: 1;
            text: "Fonoteca";
            font-size: Theme.heading;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    scroll := ScrollView {
        y: Theme.bar-height;
        height: root.height - Theme.bar-height;
        content-width: self.visible-width;
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: scroll.visible-width;
            padding: 12px;
            spacing: 2px;
            alignment: start;
            for item[i] in root.items: entry := VerticalLayout {
                property <bool> starts: (i == 0 && root.groups[0] != "") || (i > 0 && root.groups[i] != root.groups[i - 1]);
                property <bool> heading: self.starts && item == root.groups[i];
                spacing: 2px;
                if entry.starts && !entry.heading: VerticalLayout {
                    padding-top: i == 0 ? 0 : 16px;
                    padding-bottom: 4px;
                    padding-left: 12px;
                    if root.groups[i] != "": Text {
                        text: root.groups[i];
                        font-size: Theme.small;
                        font-weight: 600;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                if entry.heading: VerticalLayout {
                    padding-top: i == 0 ? 0 : 8px;
                    NavHeading {
                        text: item;
                        current: i == root.current;
                        new-playlist => { root.new-playlist(); }
                        dropped => { root.dropped(i); }
                        clicked => {
                            root.current = i;
                            root.selected(i);
                        }
                    }
                }
                if !entry.heading: NavButton {
                    text: item;
                    icon: root.icons[i];
                    current: i == root.current;
                    clicked => {
                        root.current = i;
                        root.selected(i);
                    }
                }
            }
        }
    }
}

// One destination of the BottomBar: its icon over its name, the current one
// lit the way the sidebar lights its entry, with a rounded fill.
component BarItem inherits Pressable {
    in property <string> text;
    in property <string> icon;
    in property <bool> current;
    label: self.text;
    accessible-item-selectable: true;
    accessible-item-selected: self.current;
    // Equal widths, whatever the names measure bold or plain.
    preferred-width: 0;
    horizontal-stretch: 1;
    height: Theme.phone-target;

    Rectangle {
        border-radius: Theme.radius;
        background: root.current ? Theme.hover : root.hovered ? Theme.hover.transparentize(50%) : transparent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: Theme.phone-icon;
                height: Theme.phone-icon;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: root.current ? Theme.text : Theme.muted;
                stroke-width: 1.75px;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.label;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Theme.text : Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// The navigation of a phone, along the bottom of the window in the place of
// the sidebar: the sidebar's entries as icon over name, in a bar as high as
// the top bar.
export component BottomBar inherits Rectangle {
    in property <[NavEntry]> entries;
    in property <int> current;
    callback selected(index: int);

    height: Theme.bar-height;
    background: Theme.surface;
    accessible-role: navigation;
    accessible-label: "Main";

    HorizontalLayout {
        padding: (Theme.bar-height - Theme.phone-target) / 2;
        spacing: 4px;
        for entry[i] in root.entries: BarItem {
            text: entry.title;
            icon: entry.icon;
            current: i == root.current;
            clicked => { root.selected(i); }
        }
    }
}

// Back and forward through the pages seen, and at the end the search, the
// settings and the account. With `menu`, a button first that opens the
// sidebar. On a `phone` the buttons are a finger's size and the settings are
// on the bottom bar instead, which puts the search beside the account.
export component TopBar inherits HorizontalLayout {
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> menu;
    in property <bool> phone;
    callback back();
    callback forward();
    callback search();
    callback open-menu();
    callback settings();
    callback account();

    property <length> button-size: root.phone ? Theme.phone-target : 32px;
    property <length> icon-size: root.phone ? Theme.phone-icon : 20px;

    height: Theme.bar-height;
    padding: 8px;
    // The first and last icons line up with the pages' 24px margins.
    padding-left: 24px - (root.button-size - root.icon-size) / 2;
    padding-right: self.padding-left;
    spacing: 4px;

    if root.menu: IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.menu;
        label: "Menu";
        clicked => { root.open-menu(); }
    }
    IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.back;
        label: "Back";
        enabled: root.can-go-back;
        clicked => { root.back(); }
    }
    IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.forward;
        label: "Forward";
        enabled: root.can-go-forward;
        clicked => { root.forward(); }
    }
    Rectangle { }
    IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.search;
        label: "Search";
        clicked => { root.search(); }
    }
    if !root.phone: IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.settings;
        label: "Settings";
        clicked => { root.settings(); }
    }
    IconButton {
        cross-axis-self-alignment: center;
        width: root.button-size;
        height: root.button-size;
        icon-size: root.icon-size;
        icon: Icons.person;
        label: "Account";
        clicked => { root.account(); }
    }
}

// A step of the signal path, and its light: from 0, a lossy file, to 3,
// untouched.
export struct PathStep {
    text: string,
    quality: int,
}

// A song in the queue on the now playing sheet: its title, its artists and
// length, its cover, its album's link, and whether it is the one playing. A
// work queued whole is one `work` line that opens (`expanded`) to a `part`
// line for each of its movements.
export struct QueueLine {
    title: string,
    details: string,
    cover: image,
    album: string,
    current: bool,
    work: bool,
    expanded: bool,
    part: bool,
}

// A TouchArea with a drag of its own, as a seek bar has: a finger that
// first moves over it after landing on a page is its, and the page's drag
// leaves it alone (Landing). Says when the pointer moved.
component GripArea inherits TouchArea {
    callback pointer-moved();
    changed mouse-x => {
        Landing.gripped = Landing.count;
        root.pointer-moved();
    }
    changed mouse-y => {
        Landing.gripped = Landing.count;
        root.pointer-moved();
    }
}

// Laid over a list of rows `row-height` high, one for each of `lines`, it puts
// a grip at the right of those that can move: not the first, which plays, nor
// a movement, nor a work that is open. A grip dragged by a mouse or a finger
// takes the row along as a copy, shows with a line where the row lands, and
// scrolls the view by `scroll` when the pointer comes near the edge of the
// space between `view-top` and `view-bottom`, in the window. Says `moved`
// with the slot, a gap among the rows, when let go. Only the grips take
// presses, so a finger anywhere else on a row scrolls the page.
export component QueueReorder {
    in property <[QueueLine]> lines;
    in property <length> row-height;
    // The rows from `split` on sit `gap` lower, under a heading.
    in property <int> split;
    in property <length> gap;
    in property <length> view-top;
    in property <length> view-bottom;
    // The row being dragged, or -1.
    out property <int> dragged: -1;
    pure callback slot-at(lines: [QueueLine], from: int, at: float) -> int;
    callback moved(from: int, slot: int);
    callback scroll(by: length);

    // How fast the view scrolls at the edge at most, per 16ms, and how far
    // from the edge it starts.
    property <length> scroll-step: 16px;
    property <length> scroll-zone: root.row-height;
    // Where the pointer is in the window, and how far down its row it took
    // hold.
    property <length> pointer-y;
    property <length> grab;
    property <length> ghost-y: clamp(root.pointer-y - root.absolute-position.y - root.grab, 0, max(0px, root.height - root.row-height));
    // The slot the row would land in, or -1 where that moves nothing.
    property <int> slot: root.dragged < 0 ? -1 : root.slot-at(root.lines, root.dragged, root.rows-at(root.ghost-y + root.row-height / 2));

    pure function row-y(row: int) -> length {
        row * root.row-height + (row >= root.split ? root.gap : 0)
    }
    // How many rows down `y` is, the gap not counted.
    pure function rows-at(y: length) -> float {
        let split-y = root.split * root.row-height;
        y <= split-y ? y / root.row-height : max(root.split, (y - root.gap) / root.row-height)
    }

    public pure function draggable(row: int) -> bool {
        row > 0 && !root.lines[row].part && !(root.lines[row].work && root.lines[row].expanded)
    }

    function finish(drop: bool) {
        if drop && root.slot >= 0 {
            root.moved(root.dragged, root.slot);
        }
        root.dragged = -1;
    }

    // A list made anew leaves the grips behind that were let go of.
    changed lines => { root.dragged = -1; }

    for line[row] in root.lines: Rectangle {
        y: root.row-y(row);
        width: root.width;
        height: root.row-height;
        grip := GripArea {
            x: parent.width - self.width;
            width: Screen.phone ? Theme.phone-target : 32px;
            enabled: root.draggable(row);
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-moved => {
                if root.dragged == row {
                    root.pointer-y = self.absolute-position.y + self.mouse-y;
                }
            }
            changed pressed => {
                if self.pressed {
                    root.dragged = row;
                    root.grab = self.pressed-y;
                    root.pointer-y = self.absolute-position.y + self.pressed-y;
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up {
                    root.finish(true);
                } else if event.kind == PointerEventKind.cancel {
                    root.finish(false);
                }
            }
            if root.draggable(row): Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.grip;
                stroke: grip.has-hover || grip.pressed ? Theme.text : Theme.muted;
                stroke-width: 1.75px;
            }
        }
    }

    if root.dragged >= 0: Rectangle {
        y: root.ghost-y;
        width: root.width;
        height: root.row-height;
        border-radius: Theme.radius;
        background: Theme.surface;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #0000004d;
        ListRow {
            width: parent.width;
            height: parent.height;
            reserve: Screen.phone ? Theme.phone-target : 32px;
            title: root.lines[root.dragged].title;
            details: root.lines[root.dragged].details;
            cover: root.lines[root.dragged].cover;
            covered: true;
            current: root.lines[root.dragged].current;
        }
    }
    if root.slot >= 0: Rectangle {
        y: root.row-y(root.slot) - self.height / 2;
        width: root.width;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    Timer {
        interval: 16ms;
        running: root.dragged >= 0;
        triggered => {
            let near-top = root.view-top + root.scroll-zone - root.pointer-y;
            let near-bottom = root.pointer-y - (root.view-bottom - root.scroll-zone);
            if near-top > 0 {
                root.scroll(min(near-top, root.scroll-zone) / root.scroll-zone * root.scroll-step);
            } else if near-bottom > 0 {
                root.scroll(-min(near-bottom, root.scroll-zone) / root.scroll-zone * root.scroll-step);
            }
        }
    }
}

// Draws a song's `levels` as the bars of a seek bar `width` wide: the
// commands of a path in a view box as wide and 1 high. The app builds them,
// as Slint has no loop to.
export global Waveform {
    pure callback path(levels: [float], width: length) -> string;
}

// The track's position, to drag or click to a new one, which it hands to
// `seek` once let go. With the song's `waveform`, its levels over time, it
// is drawn as bars, the part played in the accent colour; without one it is
// a plain line.
component SeekBar {
    in property <float> position;
    in property <float> duration;
    in property <[float]> waveform;
    callback seek(seconds: float);

    // As many bars as the width has room for, so they stay as thin on a
    // wider bar.
    property <string> bars: Waveform.path(root.waveform, root.width);

    property <float> dragged: clamp(touch.mouse-x / root.width, 0, 1) * root.duration;
    property <float> shown: touch.pressed ? root.dragged : root.position;
    property <float> fraction: root.duration > 0 ? clamp(root.shown / root.duration, 0, 1) : 0;

    min-width: 80px;
    height: 28px;
    accessible-role: slider;
    accessible-label: "Position";
    accessible-value: round(root.shown);
    accessible-value-minimum: 0;
    accessible-value-maximum: round(root.duration);
    accessible-value-step: 10;
    accessible-action-increment => { root.seek(min(root.position + 10, root.duration)); }
    accessible-action-decrement => { root.seek(max(root.position - 10, 0)); }

    if root.waveform.length == 0: Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.hover;
        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    if root.waveform.length > 0: Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: 1;
        fit: fill;
        commands: root.bars;
        fill: Theme.text.transparentize(70%);
    }
    if root.waveform.length > 0: Rectangle {
        x: 0;
        width: root.width * root.fraction;
        clip: true;
        Path {
            x: 0;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: 1;
            fit: fill;
            commands: root.bars;
            fill: Theme.accent;
        }
    }
    if root.waveform.length > 0: Rectangle {
        x: root.width * root.fraction - self.width / 2;
        width: 2px;
        background: Theme.text;
    }
    if root.waveform.length == 0 && (touch.has-hover || touch.pressed): Rectangle {
        x: root.width * root.fraction - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
    }
    touch := GripArea {
        enabled: root.duration > 0;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.seek(root.dragged);
            }
        }
    }
}

// A band of the parametric EQ as the settings show it: its filter's entry,
// and its frequency in Hz, gain in dB and Q as typed.
export struct EqBandLine {
    filter: int,
    frequency: string,
    gain: string,
    q: string,
}

// A point of the EQ's graph, as how far from its left and how far from its
// top it is, each from 0 to 1.
export struct EqPoint {
    x: float,
    y: float,
}

// A line of the graph's grid, how far along its axis it is, from 0 to 1, and
// its words; a vertical one is a frequency.
export struct EqGridLine {
    position: float,
    label: string,
    vertical: bool,
}

// The number of a band, on its point of the graph and on its row, so they
// are seen to be the same band; lit while the band is the one picked.
component EqBadge inherits Rectangle {
    in property <int> number;
    in property <bool> selected;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: Theme.accent;
    background: root.selected ? Theme.accent : Palette.background;
    Text {
        text: root.number;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.small;
        font-weight: 700;
        color: root.selected ? Theme.on-accent : Theme.text;
    }
}

// The EQ as a graph: gain up the side, frequency along the bottom on a log
// axis, and the curve all the bands make. Each band has a point to drag
// (a pass only sideways), and a click on the graph asks for a band there.
// Points and places are fractions of the graph, from its left and top.
// The curve is the commands of a path in a 1000 by 1000 box. Under the
// graph, the picked band is named, with a button to remove it: a phone has
// no right click.
export component EqGraph inherits VerticalLayout {
    in property <[EqPoint]> points;
    in property <[EqGridLine]> grid;
    in property <string> curve;
    // What the picked band is called, or nothing.
    in property <string> picked-name;
    in property <bool> enabled: true;
    in-out property <int> selected: -1;
    callback added(x: float, y: float);
    callback moved(row: int, x: float, y: float);
    callback released();
    callback removed(row: int);

    // Room round the plot for the points at its edges.
    property <length> inset: 14px;
    // The size of a point's target, which a finger can find.
    property <length> target: 44px;
    // How far a press may drift and still be a click.
    property <length> slack: 6px;
    // The band whose point is being dragged, or -1.
    property <int> dragging: -1;
    spacing: 8px;

    frame := Rectangle {
        min-height: 160px;
        preferred-height: 220px;
        border-radius: Theme.radius;
        background: Theme.surface;
        accessible-role: groupbox;
        accessible-label: "EQ graph";

        plot := Rectangle {
            x: root.inset;
            y: root.inset;
            width: parent.width - 2 * root.inset;
            height: parent.height - 2 * root.inset;

            for line in root.grid: Rectangle {
                x: line.vertical ? line.position * plot.width : 0px;
                y: line.vertical ? 0px : line.position * plot.height;
                width: line.vertical ? 1px : plot.width;
                height: line.vertical ? plot.height : 1px;
                background: Palette.foreground.transparentize(line.label == "0" ? 70% : 88%);
            }
            for line in root.grid: Text {
                x: line.vertical ? line.position * plot.width + 3px : 2px;
                y: line.vertical ? plot.height - self.height : line.position * plot.height - self.height;
                text: line.label;
                font-size: Theme.small;
                color: Theme.muted;
            }
            Path {
                width: plot.width;
                height: plot.height;
                viewbox-width: 1000;
                viewbox-height: 1000;
                // Stretched, as the graph is not square.
                fit: fill;
                commands: root.curve;
                stroke: Theme.accent;
                stroke-width: 2px;
            }
        }
        // Under the points, so a press on one goes to it.
        background-touch := GripArea {
            // Whether a press or a finger began on it, and where; a finger's
            // press is held back by the page and dropped once the finger
            // moves, so the first move begins it then.
            property <bool> begun;
            property <bool> dragged;
            property <length> begun-x;
            property <length> begun-y;
            enabled: root.enabled;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.begun = true;
                    self.dragged = false;
                    self.begun-x = self.mouse-x;
                    self.begun-y = self.mouse-y;
                } else if event.kind == PointerEventKind.move && (self.pressed || Input.finger) {
                    if !self.begun {
                        self.begun = true;
                        self.dragged = false;
                        self.begun-x = self.mouse-x;
                        self.begun-y = self.mouse-y;
                    }
                    if abs(self.mouse-x - self.begun-x) >= root.slack || abs(self.mouse-y - self.begun-y) >= root.slack {
                        self.dragged = true;
                    }
                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.begun && !self.dragged && abs(self.mouse-x - self.begun-x) < root.slack && abs(self.mouse-y - self.begun-y) < root.slack {
                        root.added((self.mouse-x - root.inset) / plot.width, (self.mouse-y - root.inset) / plot.height);
                    }
                    self.begun = false;
                }
            }
        }
        for point[row] in root.points: Rectangle {
            x: root.inset + point.x * plot.width - self.width / 2;
            y: root.inset + point.y * plot.height - self.height / 2;
            width: root.target;
            height: root.target;
            accessible-role: button;
            accessible-label: "Band " + (row + 1) + " point";
            accessible-checkable: true;
            accessible-checked: row == root.selected;
            accessible-action-default => { root.selected = row; }
            EqBadge {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                number: row + 1;
                selected: row == root.selected;
            }
            GripArea {
                // Where the pointer took hold of the point, which a finger's
                // first move gives, as the page drops its press.
                property <length> grip-x;
                property <length> grip-y;
                enabled: root.enabled;
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.selected = row;
                        root.dragging = row;
                        self.grip-x = self.mouse-x;
                        self.grip-y = self.mouse-y;
                    } else if event.kind == PointerEventKind.move && Input.finger && root.dragging != row {
                        root.selected = row;
                        root.dragging = row;
                        self.grip-x = self.mouse-x;
                        self.grip-y = self.mouse-y;
                    } else if event.kind == PointerEventKind.move && root.dragging == row {
                        // Where the point goes is where it is plus how far the
                        // pointer is from where it took hold, so it stays under it.
                        root.moved(row,
                            (point.x * plot.width + self.mouse-x - self.grip-x) / plot.width,
                            (point.y * plot.height + self.mouse-y - self.grip-y) / plot.height);
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        if root.dragging == row {
                            root.dragging = -1;
                            root.released();
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        // As high as the button, so the page doesn't jump when it appears.
        min-height: Screen.phone ? Theme.phone-target : 32px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.picked-name != "" ? root.picked-name : "Click the graph to add a band, drag a point to move it.";
            font-size: Theme.small;
            color: Theme.muted;
            wrap: word-wrap;
        }
        if root.selected >= 0: IconButton {
            cross-axis-self-alignment: center;
            icon: Icons.trash;
            label: "Remove band " + (root.selected + 1) + " from the graph";
            enabled: root.enabled;
            clicked => { root.removed(root.selected); }
        }
    }
}

component EqFieldLabel inherits Text {
    font-size: Theme.small;
    color: Theme.muted;
}

// The controls are drawn here rather than taken from Slint's styles, whose
// accent the app can't change. A finger's target is high on a phone, as
// Material 3 sets it: a Button 40px drawn in 48px, a Switch 32px and a
// CheckBox 18px, which Slint's Material style takes taps for in less.
export component Button inherits Pressable {
    in property <string> text;
    in property <bool> primary;
    label: root.text;
    ring-color: root.primary ? Theme.text : Theme.accent;
    height: Screen.phone ? Theme.phone-target : 32px;
    opacity: root.enabled ? 1 : 0.4;

    Rectangle {
        border-radius: Theme.radius;
        border-width: root.primary ? 0 : 1px;
        border-color: Theme.text.transparentize(75%);
        background: root.primary
            ? (root.pressed ? Theme.accent.darker(20%) : root.hovered ? Theme.accent.darker(10%) : Theme.accent)
            : (root.pressed ? Theme.text.transparentize(80%) : root.hovered ? Theme.hover : transparent);
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.detail;
            color: root.primary ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A button drawn as its icon and its words alone, with neither border nor
// background but the tint an icon button has under the pointer: Material's
// text button, as small as its words on a phone are.
export component GhostButton inherits Pressable {
    in property <string> icon;
    in property <string> text;
    label: self.text;
    height: Screen.phone ? Theme.phone-target : 32px;

    Rectangle {
        border-radius: self.height / 2;
        background: root.hovered ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        Path {
            cross-axis-self-alignment: center;
            width: Screen.phone ? 20px : 16px;
            height: self.width;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            stroke: Theme.text;
            stroke-width: 1.75px;
        }
        Text {
            text: root.text;
            font-size: Theme.detail;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// A row of a Switch or a CheckBox: its mark, then its words. A press turns it
// over and says `toggled`.
component Toggle inherits Pressable {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();
    label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    min-height: Screen.phone ? Theme.phone-target : 32px;
    opacity: root.enabled ? 1 : 0.4;
    clicked => {
        root.checked = !root.checked;
        root.toggled();
    }
}

export component Switch inherits Toggle {
    accessible-role: switch;
    property <length> track-height: Screen.phone ? 32px : 20px;
    property <length> knob: root.track-height - 8px;

    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            cross-axis-self-alignment: center;
            width: root.track-height * 2;
            height: root.track-height;
            border-radius: self.height / 2;
            border-width: 2px;
            border-color: root.checked ? Theme.accent : Theme.muted;
            background: root.checked ? Theme.accent : transparent;
            Rectangle {
                x: root.checked ? parent.width - self.width - 4px - 2px : 4px - 2px;
                width: root.knob;
                height: root.knob;
                border-radius: self.height / 2;
                background: root.checked ? Theme.on-accent : Theme.muted;
                animate x { duration: 100ms; }
            }
        }
        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

export component CheckBox inherits Toggle {
    accessible-role: checkbox;
    property <length> box: Screen.phone ? 24px : 18px;

    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            cross-axis-self-alignment: center;
            width: root.box;
            height: root.box;
            border-radius: 4px;
            border-width: 2px;
            border-color: root.checked ? Theme.accent : Theme.muted;
            background: root.checked ? Theme.accent : transparent;
            if root.checked: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M5 12.5 L10 17.5 L19 7";
                stroke: Theme.on-accent;
                stroke-width: 3px;
            }
        }
        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// A row of a Choice's list: the words, a tick on the one in use, and a tint
// on the one the keys or the pointer are on.
component ChoiceRow inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    in property <bool> chosen;
    callback clicked();
    out property <bool> hovered: touch.has-hover;
    border-radius: Theme.radius - 2px;
    background: root.lit ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            cross-axis-self-alignment: center;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M5 12.5 L10 17.5 L19 7";
            stroke: root.chosen ? Theme.accent : transparent;
            stroke-width: 3px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A choice from a list, which opens under it. Up and Down move along the
// list, Return takes the entry, and Escape closes it.
export component Choice inherits Pressable {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    out property <string> current-value: root.model[root.current-index];
    callback selected(value: string);

    property <length> row-height: (Screen.phone ? 48px : 32px) * Theme.zoom;
    property <length> pad: 4px;
    property <int> lit;

    label: root.current-value;
    accessible-role: combobox;
    accessible-value: root.current-value;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    min-height: Screen.phone ? 56px : 32px;
    opacity: root.enabled ? 1 : 0.4;
    clicked => {
        root.lit = max(0, root.current-index);
        popup.show();
    }

    function step(by: int) {
        root.lit = clamp(root.lit + by, 0, root.model.length - 1);
    }
    function pick(index: int) {
        root.current-index = index;
        root.selected(root.model[index]);
        popup.close();
    }

    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: popup.is-open || root.focused ? Theme.accent : Theme.text.transparentize(75%);
        background: root.hovered ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            accessible-role: none;
            text: root.current-value;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            cross-axis-self-alignment: center;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M5 9 L12 16 L19 9";
            stroke: Theme.muted;
            stroke-width: 2.5px;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: min(2 * root.pad + root.model.length * root.row-height, 320px);
        close-policy: close-on-click-outside;
        forward-focus: keys;

        keys := FocusScope {
            accessible-role: list;
            accessible-label: root.label;
            accessible-delegate-focus: root.lit;
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.step(1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.step(-1);
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    root.pick(root.lit);
                    return accept;
                }
                // Slint lets an Escape close the popup, but not Android's back.
                if event.text == Key.Back {
                    popup.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: Palette.background;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.hover;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000004d;
                scroll := Flickable {
                    content-height: 2 * root.pad + root.model.length * root.row-height;
                    VerticalLayout {
                        padding: root.pad;
                        for entry[i] in root.model: ChoiceRow {
                            height: root.row-height;
                            text: entry;
                            lit: root.lit == i;
                            chosen: root.current-index == i;
                            // Scrolled into view when the keys light it.
                            changed lit => {
                                if self.lit {
                                    scroll.content-y = clamp(scroll.content-y, scroll.height - self.y - self.height, -self.y);
                                }
                            }
                            changed hovered => {
                                if self.hovered {
                                    root.lit = i;
                                }
                            }
                            clicked => { root.pick(i); }
                        }
                    }
                }
            }
        }
    }
}

// A line of text to type in, with its words in the accent colour once
// selected, and a border in it while it has the keys.
export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback accepted(text: string);
    callback edited(text: string);
    callback key-pressed(event: KeyEvent) -> EventResult;

    forward-focus: input;
    min-height: Screen.phone ? 56px : 32px;
    border-radius: Theme.radius;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.has-focus ? Theme.accent : Theme.text.transparentize(75%);
    background: Theme.hover;
    opacity: root.enabled ? 1 : 0.5;
    clip: true;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value: input.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(value) => {
        input.text = value;
        root.edited(value);
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if input.text == "": Text {
        accessible-role: none;
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder-text;
        font-size: Theme.body;
        color: Theme.muted;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        enabled: root.enabled;
        input-type: root.input-type;
        font-size: Theme.body;
        color: Theme.text;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        accessible-role: none;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        key-pressed(event) => { root.key-pressed(event) }
    }
}

// The accent colors to pick from, the system's first, as discs in the colour
// each has in the scheme in use, in as many rows as the width needs so that
// none is out of reach. `chosen` is the one in use.
export component AccentSwatches {
    in property <[AccentChoice]> choices;
    in property <int> chosen;
    in property <bool> enabled: true;
    callback picked(index: int);

    property <length> size: Screen.phone ? 48px : 36px;
    property <length> gap: 8px;
    property <int> count: root.choices.length + 1;
    property <int> columns: max(1, floor((root.width + root.gap) / (root.size + root.gap)));
    property <int> rows: ceil(root.count / root.columns);
    height: root.rows * (root.size + root.gap) - root.gap;

    for index in root.count: Pressable {
        x: mod(index, root.columns) * (root.size + root.gap);
        y: floor(index / root.columns) * (root.size + root.gap);
        width: root.size;
        height: root.size;
        label: index == 0 ? "System accent" : root.choices[index - 1].name;
        enabled: root.enabled;
        clicked => { root.picked(index); }

        Rectangle {
            width: parent.width - 8px;
            height: self.width;
            border-radius: self.width / 2;
            background: index == 0 ? Palette.accent-background
                : Theme.dark ? root.choices[index - 1].dark : root.choices[index - 1].light;
            border-width: index == root.chosen ? 3px : 0;
            border-color: Theme.text;
        }
    }
}

// A format and quality to take audio in, for the settings: Original, which
// has no bitrate, or a lossy format and the most kbit/s it may use. `name`
// says what it is for ("Streaming on wifi"). The two entries are the ones
// quality.rs takes, by their order.
export component QualityPicker inherits VerticalLayout {
    in property <string> name;
    in-out property <int> format;
    in-out property <int> bitrate;
    in property <bool> enabled: true;
    callback chosen(format: int, bitrate: int);
    spacing: 8px;

    Text {
        text: root.name;
        font-size: Theme.body;
        color: Theme.muted;
    }
    HorizontalLayout {
        spacing: 8px;
        Choice {
            horizontal-stretch: 1;
            accessible-label: root.name + " format";
            model: ["Original", "MP3", "Opus", "AAC"];
            current-index <=> root.format;
            enabled: root.enabled;
            selected => { root.chosen(root.format, root.bitrate); }
        }
        Choice {
            horizontal-stretch: 1;
            accessible-label: root.name + " bitrate";
            // Original has none, so its box is empty rather than showing one
            // that isn't used.
            model: root.format > 0 ? ["320 kbit/s", "256 kbit/s", "192 kbit/s", "160 kbit/s", "128 kbit/s", "96 kbit/s", "64 kbit/s"] : [];
            current-index <=> root.bitrate;
            enabled: root.enabled && root.format > 0;
            selected => { root.chosen(root.format, root.bitrate); }
        }
    }
}

// The `number`th band of the EQ in the settings: its filter on one line, the
// numbers under it, so it fits a phone. A pass has no gain.
export component EqBandRow inherits VerticalLayout {
    in property <EqBandLine> line;
    in property <int> number;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback edited(line: EqBandLine);
    callback remove();
    property <string> name: "Band " + root.number;
    spacing: 8px;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.selected;

    // A typed-in field no longer follows `line` by its binding, so a band
    // moved on the graph is put in them here.
    changed line => {
        frequency.text = root.line.frequency;
        gain.text = root.line.gain;
        q.text = root.line.q;
    }

    function edit() {
        root.edited({ filter: filter.current-index, frequency: frequency.text, gain: gain.text, q: q.text });
    }

    HorizontalLayout {
        spacing: 8px;
        EqBadge {
            cross-axis-self-alignment: center;
            number: root.number;
            selected: root.selected;
        }
        filter := Choice {
            horizontal-stretch: 1;
            accessible-label: root.name + " filter";
            // In the order sound.rs's `FILTERS` takes them.
            model: ["Peak", "Low shelf", "High shelf", "Low pass", "High pass"];
            current-index: root.line.filter;
            enabled: root.enabled;
            selected => { root.edit(); }
        }
        IconButton {
            cross-axis-self-alignment: center;
            icon: Icons.trash;
            label: "Remove " + root.name;
            enabled: root.enabled;
            clicked => { root.remove(); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            spacing: 4px;
            EqFieldLabel { text: "Hz"; }
            frequency := LineEdit {
                min-width: 64px;
                text: root.line.frequency;
                accessible-label: root.name + " frequency in Hz";
                enabled: root.enabled;
                edited => { root.edit(); }
            }
        }
        VerticalLayout {
            spacing: 4px;
            EqFieldLabel { text: "dB"; }
            gain := LineEdit {
                min-width: 64px;
                text: root.line.gain;
                accessible-label: root.name + " gain in dB";
                enabled: root.enabled && filter.current-index < 3;
                edited => { root.edit(); }
            }
        }
        VerticalLayout {
            spacing: 4px;
            EqFieldLabel { text: "Q"; }
            q := LineEdit {
                min-width: 64px;
                text: root.line.q;
                accessible-label: root.name + " Q";
                enabled: root.enabled;
                edited => { root.edit(); }
            }
        }
    }
}

// Whether the queue is shuffled, lit when it is; a press turns it over. Its
// icon says which too, as a colour alone is easy to miss, and its label
// says it to a screen reader.
component ShuffleButton inherits IconButton {
    in property <bool> shuffled;
    icon: root.shuffled ? Icons.shuffle : Icons.shuffle-off;
    color: root.shuffled ? Theme.accent : Theme.muted;
    label: root.shuffled ? "Shuffle on" : "Shuffle off";
}

// Whether the queue repeats: 0 not, 1 all of it, 2 the track; lit while it
// does, with an icon and a label of each. A press goes on to the next.
component RepeatButton inherits IconButton {
    in property <int> repeat;
    icon: root.repeat == 0 ? Icons.repeat-off : root.repeat == 1 ? Icons.repeat : Icons.repeat-one;
    color: root.repeat > 0 ? Theme.accent : Theme.muted;
    label: root.repeat == 0 ? "Repeat off" : root.repeat == 1 ? "Repeat all" : "Repeat one";
}

// Plays or pauses, as a filled round button so it stands out from the
// others.
component PlayPauseButton inherits IconButton {
    in property <bool> paused;
    icon: root.paused ? Icons.play : Icons.pause;
    filled: true;
    color: Palette.background;
    // Filled only, since a stroke on a glyph this size leaves a seam and a
    // notch; the plate lightens under the pointer, where its tint would not
    // show.
    stroke: 0px;
    plate: root.hovered ? Theme.text.transparentize(25%) : Theme.text;
    label: root.paused ? "Play" : "Pause";
}

// Where the track is and how long it is, either side of the bar that moves
// it.
component SeekRow inherits HorizontalLayout {
    in property <float> position;
    in property <float> duration;
    in property <[float]> waveform;
    callback seek(seconds: float);

    function clock(seconds: float) -> string {
        let s = floor(max(seconds, 0));
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }

    spacing: 8px;
    Text {
        min-width: 40px;
        text: root.clock(root.position);
        font-size: Theme.small;
        color: Theme.muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    SeekBar {
        cross-axis-self-alignment: center;
        horizontal-stretch: 1;
        position: root.position;
        duration: root.duration;
        waveform: root.waveform;
        seek(seconds) => { root.seek(seconds); }
    }
    Text {
        min-width: 40px;
        text: root.duration > 0 ? root.clock(root.duration) : "";
        font-size: Theme.small;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

// The now playing sheet's controls on a phone, whose bar has room for play
// and next only: where the track is, then shuffle, previous, play, next and
// repeat.
export component PlayerControls inherits VerticalLayout {
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    // A live stream: only play and pause, with no position.
    in property <bool> live;
    in property <[float]> waveform;
    in property <bool> shuffled;
    in property <int> repeat;
    callback toggle-pause();
    callback previous();
    callback next();
    callback seek(seconds: float);
    callback toggle-shuffle();
    callback cycle-repeat();
    // Narrow phones give the smaller buttons a finger's target and no more.
    property <length> side: Screen.width < 360px ? Theme.phone-target : 56px;
    spacing: 8px;

    if !root.live: SeekRow {
        position: root.position;
        duration: root.duration;
        waveform: root.waveform;
        seek(seconds) => { root.seek(seconds); }
    }
    HorizontalLayout {
        alignment: root.live ? center : space-between;
        if !root.live: ShuffleButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 28px;
            shuffled: root.shuffled;
            clicked => { root.toggle-shuffle(); }
        }
        if !root.live: IconButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 32px;
            icon: Icons.previous;
            filled: true;
            label: "Previous";
            clicked => { root.previous(); }
        }
        PlayPauseButton {
            cross-axis-self-alignment: center;
            width: 80px;
            icon-size: 48px;
            paused: root.paused;
            clicked => { root.toggle-pause(); }
        }
        if !root.live: IconButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 32px;
            icon: Icons.next;
            filled: true;
            label: "Next";
            clicked => { root.next(); }
        }
        if !root.live: RepeatButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 28px;
            repeat: root.repeat;
            clicked => { root.cycle-repeat(); }
        }
    }
}

// The steps of a signal path, each with its light.
component PathSteps inherits VerticalLayout {
    in property <[PathStep]> path;
    padding: 12px;
    for step in root.path: HorizontalLayout {
        height: 28px;
        spacing: 8px;
        Rectangle {
            cross-axis-self-alignment: center;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.quality-colors[step.quality];
        }
        Text {
            text: step.text;
            font-size: Theme.small;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The light of a signal path, by its quality's name or without it, which
// opens the steps of the path in a popup, or on a phone in a sheet, as the
// menus do.
export component SignalPathLight inherits Pressable {
    in property <string> quality;
    in property <int> level;
    in property <[PathStep]> path;
    in property <bool> dot-only;
    // Whether the steps open above the light and end where it does, or below
    // it and start where it does, where they aren't a sheet.
    in property <bool> opens-upward: true;
    property <brush> light: Theme.quality-colors[root.level];

    label: "Signal path: " + root.quality;
    accessible-expandable: true;
    accessible-expanded: steps.is-open;
    // A finger's target is taller and wider than the chip drawn in it.
    width: max(badge.preferred-width, Screen.phone ? Theme.phone-target : 0px);
    height: Screen.phone ? Theme.phone-target : 28px;
    clicked => { steps.show(); }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: badge.preferred-width;
        height: 28px;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.light;
        background: root.hovered ? Theme.hover : transparent;
    }
    badge := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: 28px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Rectangle {
            cross-axis-self-alignment: center;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.light;
        }
        if !root.dot-only: Text {
            text: root.quality;
            font-size: Theme.small;
            color: root.light;
            vertical-alignment: center;
        }
    }
    steps := PopupWindow {
        in property <length> list-height: 24px + root.path.length * 28px;
        x: Screen.phone ? -root.absolute-position.x : root.opens-upward ? parent.width - self.width : 0px;
        y: Screen.phone ? -root.absolute-position.y : root.opens-upward ? -self.height - 8px : parent.height + 8px;
        width: Screen.phone ? Screen.width : min(480px, Screen.width - 32px);
        height: Screen.phone ? Screen.height : self.list-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: keys;

        keys := FocusScope {
            // Slint lets an Escape close it, but not Android's back.
            key-pressed(event) => {
                if event.text == Key.Back {
                    steps.close();
                    return accept;
                }
                reject
            }

            if !Screen.phone: Rectangle {
                background: Palette.background;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.hover;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000004d;
                PathSteps {
                    path: root.path;
                }
            }
            if Screen.phone: Sheet {
                content-height: steps.list-height;
                dismissed => { steps.close(); }
                PathSteps {
                    path: root.path;
                }
            }
        }
    }
}

// One line of text, which scrolls to its end and back, pausing at each, when
// it doesn't fit. A text that fits, or a ticker that isn't `active`, asks for
// no frames: the offset reads the animation clock only while it moves.
component Ticker inherits Rectangle {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight: 400;
    in property <brush> text-color: Theme.text;
    // Whether what it is on is open, as a closed page keeps no time.
    in property <bool> active: true;
    property <length> speed: 40px;
    property <float> pause-ms: 1500;
    property <length> overflow: max(0px, label.preferred-width - root.width);
    property <bool> moving: root.active && root.overflow > 0;
    property <duration> started;
    property <float> scroll-ms: root.overflow / root.speed * 1000;

    clip: true;
    preferred-height: label.preferred-height;
    min-height: label.preferred-height;

    changed moving => { root.started = animation-tick(); }
    changed text => { root.started = animation-tick(); }

    // How far along its way out, from 0 to 1, a ticker is `elapsed-ms` after
    // it started: held at the start, out, held at the end, back.
    pure function progress(elapsed-ms: float) -> float {
        let at = mod(elapsed-ms, 2 * (root.pause-ms + root.scroll-ms));
        if at < root.pause-ms {
            return 0;
        }
        if at < root.pause-ms + root.scroll-ms {
            return (at - root.pause-ms) / root.scroll-ms;
        }
        if at < 2 * root.pause-ms + root.scroll-ms {
            return 1;
        }
        return 1 - (at - 2 * root.pause-ms - root.scroll-ms) / root.scroll-ms;
    }

    label := Text {
        x: root.moving ? -root.overflow * root.progress((animation-tick() - root.started) / 1ms) : 0;
        width: self.preferred-width;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.text-color;
    }
}

// A name as a pill that opens its page, as each artist of what plays does;
// one without a page is a plain pill.
component NameChip inherits Pressable {
    in property <Name> name;
    in property <length> pill;
    label: self.name.label;
    enabled: self.name.link != "";
    // A finger's target is taller than the pill drawn in it.
    min-height: Screen.phone ? Theme.phone-target : root.pill;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.pill;
        border-radius: self.height / 2;
        background: root.hovered ? Theme.hover : transparent;
        border-width: 1px;
        border-color: Theme.muted.transparentize(60%);
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.name.label;
            font-size: Theme.small;
            color: root.hovered || root.focused ? Theme.text : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One chip for each of `names`, in one row that scrolls sideways where they
// don't all fit.
export component NameChips inherits Flickable {
    in property <[Name]> names;
    in property <length> pill: Screen.phone ? 32px : 24px;
    callback open(link: string);
    height: row.preferred-height;
    content-width: row.preferred-width;
    // Another song's artists start from the first.
    changed names => { self.content-x = 0; }

    row := HorizontalLayout {
        width: self.preferred-width;
        spacing: 8px;
        for name in root.names: NameChip {
            name: name;
            pill: root.pill;
            clicked => { root.open(name.link); }
        }
    }
}

// The title of what plays with the part of it that plays, and its album and
// its artists, which open their pages. Each line stays where it is from song
// to song: the artists keep to one row, and while `keeps-part-line` a song
// that is no part of a work keeps the line of the part, empty.
component NowPlayingDetails inherits VerticalLayout {
    in property <string> title;
    in property <string> movement;
    in property <string> movement-place;
    in property <bool> keeps-part-line;
    in property <[Name]> names;
    in property <Name> album;
    // Whether the sheet is open, which the titles scroll only while.
    in property <bool> active;
    callback open(link: string);
    spacing: 8px;
    alignment: start;

    Ticker {
        active: root.active;
        text: root.title;
        font-size: Theme.title;
        font-weight: 700;
    }
    if root.keeps-part-line || root.movement != "" || root.movement-place != "": Ticker {
        active: root.active;
        text: root.movement != "" && root.movement-place != "" ? root.movement + " · " + root.movement-place : root.movement + root.movement-place;
        font-size: Theme.body;
        text-color: Theme.muted;
    }
    if root.album.link != "": HorizontalLayout {
        alignment: start;
        Link {
            text: root.album.label;
            clicked => { root.open(root.album.link); }
        }
    }
    if root.names.length > 0: NameChips {
        names: root.names;
        open(link) => { root.open(link); }
    }
}

// The sound device in use, its kind's icon on the button that opens the menu
// of the outputs to play on, and named beside it where there is room.
export component OutputPicker inherits HorizontalLayout {
    in property <[MenuEntry]> output-devices;
    in property <string> output-name;
    // The icon of the kind of device in use, and what the kind is called
    // where its name doesn't say.
    in property <string> output-icon;
    in property <string> output-kind;
    in property <bool> named: true;
    callback list-devices();
    callback choose-output(index: int);
    alignment: center;
    spacing: 8px;

    menu := MoreMenu {
        cross-axis-self-alignment: center;
        label: "Sound device";
        icon: root.output-icon;
        // Drawn in outline as in the menu: filled, a speaker's box and a
        // screen would be solid.
        filled: false;
        two-line: true;
        panel: 320px;
        entries: root.output-devices;
        opening => { root.list-devices(); }
        activated(id) => { root.choose-output(Math.floor(id.to-float())); }
    }
    // The name opens the menu too; the button stays the one a screen reader finds.
    if root.named: Text {
        max-width: 240px;
        min-height: menu.height;
        text: root.output-name;
        accessible-label: root.output-kind == "" ? root.output-name : root.output-kind + ": " + root.output-name;
        font-size: Theme.small;
        color: name-touch.has-hover ? Theme.text : Theme.muted;
        vertical-alignment: center;
        overflow: elide;
        name-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { menu.show(); }
        }
    }
}

// What plays, large, on a phone's or a tablet's now playing page: its cover
// as wide as the page, which opens its album, and its words under it. On a
// page too short for all it holds, the cover gives way to what comes under
// it, down to `least-cover`.
export component NowPlaying inherits VerticalLayout {
    // The page's width for it, which it can't read from its own: the
    // cover's height follows from it.
    in property <length> available;
    in property <image> cover;
    in property <string> title;
    in property <string> movement;
    in property <string> movement-place;
    // Whether a song that is no part of a work keeps the line of the part,
    // as one among works does, so that what follows stays in place.
    in property <bool> keeps-part-line;
    in property <[Name]> names;
    in property <Name> album;
    in property <bool> active;
    callback open(link: string);
    property <length> least-cover: 160px;
    spacing: 24px;

    Rectangle {
        min-height: min(root.least-cover, root.available);
        preferred-height: root.available;
        Pressable {
            x: (parent.width - self.width) / 2;
            width: min(parent.width, parent.height);
            height: self.width;
            label: "Album cover";
            enabled: root.album.link != "";
            clicked => { root.open(root.album.link); }
            Artwork {
                size: parent.width;
                source: root.cover;
            }
        }
    }
    // Measured at its preferred width, the words would count as one line
    // each, and what follows would be placed over the wrapped ones.
    NowPlayingDetails {
        preferred-width: root.available;
        active: root.active;
        title: root.title;
        movement: root.movement;
        movement-place: root.movement-place;
        keeps-part-line: root.keeps-part-line;
        names: root.names;
        album: root.album;
        open(link) => { root.open(link); }
    }
}

// The words of what plays, or a note in their place while they are on their
// way or where there are none.
export component LyricsView inherits VerticalLayout {
    in property <string> lyrics;
    in property <string> note;
    // The width the lines wrap at, which it can't read from its own: its
    // height follows from it.
    in property <length> available;

    if root.lyrics != "": Text {
        preferred-width: root.available;
        text: root.lyrics;
        font-size: Theme.heading;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.lyrics == "": Text {
        preferred-width: root.available;
        text: root.note;
        font-size: Theme.body;
        color: Theme.muted;
        wrap: word-wrap;
        accessible-live-region: polite;
    }
}

// The track playing, under the pages: its cover, title and artists, the
// buttons and position, and how well it reaches the speakers, whose steps
// open from it. A problem takes the artists' place. On a desktop, `full`,
// it holds all that a phone's now playing page does, whose page shows the
// banner and the lyrics instead: the cover and the album open the album and
// the artists their pages, and the bar has the part of a work that plays,
// the sound device and processing, the lyrics, the heart, the song's menu,
// the queue and the button that opens and closes the page.
export component PlayerBar inherits Rectangle {
    in property <bool> full;
    in property <image> cover;
    in property <string> title;
    in property <string> movement;
    in property <string> movement-place;
    in property <[Name]> names;
    in property <Name> album;
    in property <bool> loved;
    // The playlists the song's menu adds to, and whether it tags.
    in property <[Name]> playlists;
    in property <bool> taggable;
    in property <[MenuEntry]> output-devices;
    in property <string> output-name;
    in property <string> output-icon;
    in property <string> output-kind;
    // Whether what plays is heard, with a sound device and settings for it:
    // not in the browser, which only shows what would play.
    in property <bool> has-sound;
    // Whether the now playing page is open, and the queue.
    in property <bool> page-open;
    in property <bool> queue-open;
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    // A live stream: no previous, next, shuffle, repeat or position.
    in property <bool> live;
    in property <[float]> waveform;
    // The signal path's light, by its name and from 0 to 3, or -1 for none.
    in property <string> quality;
    in property <int> level: -1;
    in property <[PathStep]> path;
    in property <string> problem;
    // Whether the queue is shuffled, and whether it repeats: 0 not, 1 all
    // of it, 2 the track.
    in property <bool> shuffled;
    in property <int> repeat;
    callback open-playing();
    callback toggle-pause();
    callback previous();
    callback next();
    callback seek(seconds: float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open(link: string);
    callback toggle-love();
    callback add-to-playlist(id: string);
    callback tag();
    callback list-devices();
    callback choose-output(index: int);
    callback sound-settings();
    callback lyrics();
    callback toggle-queue();
    // A window this narrow, whose bar is under 760px once the sidebar is
    // docked, draws everything closer and smaller, play and pause the least.
    // The bar's own width can't say so: it follows from what it holds.
    property <bool> compact: !Screen.phone && Screen.width < 1000px;
    property <length> side: root.compact ? 36px : 40px;
    // A full bar names the sound device only where its window is this wide.
    property <bool> roomy: Screen.width >= 1400px;
    property <string> part: root.movement != "" && root.movement-place != "" ? root.movement + " · " + root.movement-place : root.movement + root.movement-place;

    height: Screen.phone ? 72px : 80px;
    background: Theme.surface;

    // The whole bar opens it, but for the controls drawn over it.
    Pressable {
        width: parent.width;
        height: parent.height;
        label: "Now playing";
        clicked => { root.open-playing(); }
    }
    if !root.full: HorizontalLayout {
        padding-left: root.compact ? 12px : 16px;
        padding-right: root.compact ? 12px : 16px;
        spacing: root.compact ? 6px : 12px;
        alignment: stretch;
        Artwork {
            cross-axis-self-alignment: center;
            size: 48px;
            source: root.cover;
        }
        // Long titles and names are cut short, so they don't size it.
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            preferred-width: 300px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Screen.phone ? Theme.body : 0px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.problem != "": Text {
                text: root.problem;
                font-size: Theme.small;
                color: Theme.danger;
                overflow: elide;
            }
            if root.problem == "" && root.names.length > 0: LinksLine {
                names: root.names;
                linked: false;
                alignment: LayoutAlignment.start;
                font-size: Theme.small;
            }
        }
        if !Screen.phone && !root.live: ShuffleButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 24px;
            shuffled: root.shuffled;
            clicked => { root.toggle-shuffle(); }
        }
        if !Screen.phone && !root.live: IconButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 24px;
            icon: Icons.previous;
            filled: true;
            label: "Previous";
            clicked => { root.previous(); }
        }
        PlayPauseButton {
            cross-axis-self-alignment: center;
            width: Screen.phone ? 48px : 56px;
            icon-size: Screen.phone ? 24px : 36px;
            paused: root.paused;
            clicked => { root.toggle-pause(); }
        }
        if !root.live: IconButton {
            cross-axis-self-alignment: center;
            width: Screen.phone ? Theme.phone-target : root.side;
            icon-size: 24px;
            icon: Icons.next;
            filled: true;
            label: "Next";
            clicked => { root.next(); }
        }
        if !Screen.phone && !root.live: RepeatButton {
            cross-axis-self-alignment: center;
            width: root.side;
            icon-size: 24px;
            repeat: root.repeat;
            clicked => { root.cycle-repeat(); }
        }
        if !Screen.phone && !root.live: SeekRow {
            cross-axis-self-alignment: center;
            horizontal-stretch: 1;
            preferred-width: 380px;
            position: root.position;
            duration: root.duration;
            waveform: root.waveform;
            seek(seconds) => { root.seek(seconds); }
        }
        if root.quality != "": SignalPathLight {
            cross-axis-self-alignment: center;
            quality: root.quality;
            level: root.level;
            path: root.path;
            // A phone, or a bar this narrow, has room for the light only.
            dot-only: Screen.phone || root.compact;
        }
    }
    if root.full: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 140px;
            preferred-width: 320px;
            spacing: 12px;
            Pressable {
                cross-axis-self-alignment: center;
                width: 56px;
                height: 56px;
                label: "Album cover";
                enabled: root.album.link != "";
                clicked => { root.open(root.album.link); }
                Artwork {
                    size: 56px;
                    source: root.cover;
                }
            }
            // Long titles are cut short and the artists scroll sideways, so
            // they don't size it.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.title;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    if root.part != "": Text {
                        text: root.part;
                        font-size: Theme.small;
                        color: Theme.muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.album.link != "": HorizontalLayout {
                    alignment: start;
                    Link {
                        text: root.album.label;
                        font-size: Theme.small;
                        clicked => { root.open(root.album.link); }
                    }
                }
                if root.problem != "": Text {
                    text: root.problem;
                    font-size: Theme.small;
                    color: Theme.danger;
                    overflow: elide;
                }
                if root.problem == "" && root.names.length > 0: NameChips {
                    names: root.names;
                    pill: 22px;
                    open(link) => { root.open(link); }
                }
            }
        }
        // The controls over the position.
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 200px;
            preferred-width: 420px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                if !root.live: ShuffleButton {
                    cross-axis-self-alignment: center;
                    icon-size: 20px;
                    shuffled: root.shuffled;
                    clicked => { root.toggle-shuffle(); }
                }
                if !root.live: IconButton {
                    cross-axis-self-alignment: center;
                    icon-size: 20px;
                    icon: Icons.previous;
                    filled: true;
                    label: "Previous";
                    clicked => { root.previous(); }
                }
                PlayPauseButton {
                    cross-axis-self-alignment: center;
                    width: 40px;
                    icon-size: 28px;
                    paused: root.paused;
                    clicked => { root.toggle-pause(); }
                }
                if !root.live: IconButton {
                    cross-axis-self-alignment: center;
                    icon-size: 20px;
                    icon: Icons.next;
                    filled: true;
                    label: "Next";
                    clicked => { root.next(); }
                }
                if !root.live: RepeatButton {
                    cross-axis-self-alignment: center;
                    icon-size: 20px;
                    repeat: root.repeat;
                    clicked => { root.cycle-repeat(); }
                }
            }
            if !root.live: SeekRow {
                position: root.position;
                duration: root.duration;
                waveform: root.waveform;
                seek(seconds) => { root.seek(seconds); }
            }
        }
        // In two rows of four where the window is narrow, else in one.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            FlexboxLayout {
                width: root.compact ? 4 * 32px + 3 * self.spacing : self.preferred-width;
                flex-wrap: root.compact ? FlexboxLayoutWrap.wrap : FlexboxLayoutWrap.no-wrap;
                spacing: 4px;
                cross-axis-alignment: center;
                if root.quality != "": SignalPathLight {
                    quality: root.quality;
                    level: root.level;
                    path: root.path;
                    dot-only: !root.roomy;
                }
                if root.has-sound: OutputPicker {
                    named: root.roomy;
                    output-devices: root.output-devices;
                    output-name: root.output-name;
                    output-icon: root.output-icon;
                    output-kind: root.output-kind;
                    list-devices => { root.list-devices(); }
                    choose-output(index) => { root.choose-output(index); }
                }
                if root.has-sound: IconButton {
                    icon: Icons.sound;
                    label: "Sound processing";
                    clicked => { root.sound-settings(); }
                }
                if !root.live: IconButton {
                    icon: Icons.lyrics;
                    label: "Lyrics";
                    clicked => { root.lyrics(); }
                }
                if !root.live: IconButton {
                    icon: Icons.heart;
                    filled: root.loved;
                    color: root.loved ? Theme.accent : Theme.text;
                    label: "Love " + root.title;
                    accessible-checkable: true;
                    accessible-checked: root.loved;
                    clicked => { root.toggle-love(); }
                }
                if !root.live: TrackMenu {
                    line: {
                        title: root.title,
                        loved: root.loved,
                        album: root.album,
                        artists: root.names,
                    };
                    playlists: root.playlists;
                    taggable: root.taggable;
                    selectable: false;
                    open(link) => { root.open(link); }
                    toggle-love => { root.toggle-love(); }
                    add-to-playlist(id) => { root.add-to-playlist(id); }
                    tag => { root.tag(); }
                }
                if !root.live: IconButton {
                    icon: Icons.queue;
                    label: "Queue";
                    accessible-checkable: true;
                    accessible-checked: root.queue-open;
                    color: root.queue-open ? Theme.accent : Theme.text;
                    clicked => { root.toggle-queue(); }
                }
                IconButton {
                    icon: root.page-open ? Icons.chevron-down : Icons.chevron-up;
                    label: root.page-open ? "Close now playing" : "Open now playing";
                    clicked => { root.open-playing(); }
                }
            }
        }
    }
}

// One place of a ranking of what the user played most: its rank, its picture
// when the ranking has them, its name, a line under it such as the artist,
// and how often it was played. It opens the library's page when it has a
// `link`.
export struct RankedEntry {
    rank: int,
    title: string,
    detail: string,
    plays: string,
    picture: image,
    link: string,
}

// A ranking with its title, and a note in the place of its entries where
// there are none. An artist's picture is round.
export struct RankedList {
    title: string,
    entries: [RankedEntry],
    note: string,
    pictured: bool,
    round: bool,
}

export component RankedRow inherits Pressable {
    in property <RankedEntry> entry;
    in property <bool> pictured;
    in property <bool> round;
    enabled: root.entry.link != "";
    label: root.entry.rank + ". " + root.entry.title + (root.entry.detail == "" ? "" : ", " + root.entry.detail) + ", " + root.entry.plays;
    // Material's two-line list item holds a 56px picture on a phone.
    min-height: Screen.phone ? 72px : 56px;

    Rectangle {
        border-radius: Theme.radius;
        background: root.hovered ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Text {
            width: 28px * Theme.zoom;
            text: root.entry.rank;
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.pictured: Artwork {
            cross-axis-self-alignment: center;
            size: Screen.phone ? 56px : 40px;
            round: root.round;
            source: root.entry.picture;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.entry.detail != "": Text {
                text: root.entry.detail;
                font-size: Theme.small;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Text {
            text: root.entry.plays;
            font-size: Theme.small;
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component RankedListView inherits VerticalLayout {
    in property <RankedList> list;
    // The ranking of an earlier period, while the new one is on its way.
    in property <bool> stale;
    // The columns its rows fill, each from the top down.
    in property <int> columns: 1;
    callback open(link: string);
    // Side by side, each ranking starts at the top whatever the others hold.
    alignment: start;
    spacing: 4px;

    property <int> per-column: max(1, ceil(root.list.entries.length / root.columns));

    Text {
        text: root.list.title;
        font-size: Theme.body;
        font-weight: 700;
        color: Theme.text;
    }
    if root.list.entries.length == 0: Text {
        text: root.list.note;
        font-size: Theme.small;
        color: Theme.muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 24px;
        for column in root.columns: VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 0;
            alignment: start;
            for entry[i] in root.list.entries: VerticalLayout {
                if floor(i / root.per-column) == column: RankedRow {
                    entry: entry;
                    pictured: root.list.pictured;
                    round: root.list.round;
                    opacity: root.stale ? 0.5 : 1;
                    clicked => { root.open(entry.link); }
                }
            }
        }
    }
}

// A choice of one period, as a pill that fills when it is the one picked.
component PeriodChip inherits Pressable {
    in property <string> text;
    in property <bool> current;
    label: self.text;
    accessible-item-selectable: true;
    accessible-item-selected: self.current;
    // A finger's target is taller than the pill drawn in it.
    min-height: Screen.phone ? Theme.phone-target : 32px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: Screen.phone ? 36px : 28px;
        border-radius: self.height / 2;
        background: root.current ? Theme.accent.transparentize(75%) : root.hovered ? Theme.hover : transparent;
        border-width: root.current ? 0px : 1px;
        border-color: Theme.muted.transparentize(60%);
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            font-size: Theme.small;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
    }
}

// One dot of the slider's row: the slide it shows, tappable.
component SlideDot inherits Pressable {
    in property <bool> current;
    // A finger's target is bigger than the dot drawn in it.
    min-width: Screen.phone ? Theme.phone-target : 32px;
    min-height: Screen.phone ? Theme.phone-target : 32px;
    accessible-item-selectable: true;
    accessible-item-selected: self.current;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.current ? Theme.accent : Theme.muted.transparentize(60%);
    }
}

// What the user played most, over a period picked from `periods`: one ranking
// each of albums, artists and genres: in three equal columns when three rows
// fit across, else albums and artists side by side over the genres in two
// columns of their own when two do, else one slide at a time.
export component ListeningStats inherits VerticalLayout {
    in property <[string]> periods;
    in property <int> period;
    in property <[RankedList]> lists;
    // Whether the rankings are those of another period than the one picked.
    in property <bool> stale;
    callback period-picked(index: int);
    callback open(link: string);
    alignment: start;
    spacing: 12px;

    // What a row needs across: its padding, rank, picture and spacing, a name
    // of about twenty letters, and the plays. Columns and their gaps need as
    // many times that.
    property <length> name-width: 160px;
    property <length> row-need: 92px + (28px + root.name-width + 72px) * Theme.zoom;
    property <length> column-gap: 24px;
    property <bool> fits-two: root.width >= 2 * root.row-need + root.column-gap;
    property <bool> fits-three: root.width >= 3 * root.row-need + 2 * root.column-gap;

    // The slide shown when it doesn't, and the share of its width a drag has
    // to cover to move to the next.
    property <int> slide;
    property <int> last-slide: max(0, root.lists.length - 1);
    property <float> at: root.slide;
    animate at { duration: 250ms; easing: Fling.curve; }
    property <float> drag-share: 0.15;

    function slide-to(index: int) {
        root.slide = clamp(index, 0, root.last-slide);
    }

    // Moves to the next slide, or back, once `moved` sideways is far enough.
    function settle(moved: length) {
        if moved <= -root.drag-share * root.width {
            root.slide-to(root.slide + 1);
        } else if moved >= root.drag-share * root.width {
            root.slide-to(root.slide - 1);
        }
    }

    // The finger that first moved over the slides after landing on the page,
    // by its count (Landing), and whether the page's drag slides them for
    // it; once it lets go, they settle. Without this a quick flick, let go
    // within the 100ms the page holds a finger back, would tap the row under
    // it.
    property <int> landing: -1;
    property <bool> page-slides: root.landing == Landing.count && Landing.sliding;
    changed page-slides => {
        if !root.page-slides {
            root.settle(Landing.slid);
        }
    }
    function claim() {
        root.landing = Landing.count;
        Landing.shelved = Landing.count;
    }

    HorizontalLayout {
        spacing: 4px;
        Text {
            horizontal-stretch: 1;
            text: "Your listening";
            font-size: Theme.heading;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        if !root.fits-two: IconButton {
            icon: Icons.back;
            label: "Previous ranking";
            enabled: root.slide > 0;
            clicked => { root.slide-to(root.slide - 1); }
        }
        if !root.fits-two: IconButton {
            icon: Icons.forward;
            label: "Next ranking";
            enabled: root.slide < root.last-slide;
            clicked => { root.slide-to(root.slide + 1); }
        }
    }
    FlexboxLayout {
        spacing-horizontal: 8px;
        for name[i] in root.periods: PeriodChip {
            text: name;
            current: i == root.period;
            clicked => { root.period-picked(i); }
        }
    }
    if root.fits-three: HorizontalLayout {
        spacing: root.column-gap;
        for list in root.lists: RankedListView {
            // Equal columns whatever the entries' own widths.
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 0;
            list: list;
            stale: root.stale;
            open(link) => { root.open(link); }
        }
    }
    // The albums and the artists side by side, the genres below them over
    // the full width, in two columns of their own.
    if root.fits-two && !root.fits-three && root.lists.length == 3: VerticalLayout {
        spacing: root.column-gap;
        HorizontalLayout {
            spacing: root.column-gap;
            for list in [root.lists[0], root.lists[1]]: RankedListView {
                horizontal-stretch: 1;
                preferred-width: 0;
                min-width: 0;
                list: list;
                stale: root.stale;
                open(link) => { root.open(link); }
            }
        }
        RankedListView {
            columns: 2;
            list: root.lists[2];
            stale: root.stale;
            open(link) => { root.open(link); }
        }
    }
    if !root.fits-two: swipe := SwipeGestureHandler {
        height: slides.preferred-height;
        handle-swipe-left: true;
        handle-swipe-right: true;
        // A finger's drag is the page's, which slides them (Landing); this
        // is a mouse's.
        swiped => {
            if !Input.finger {
                root.settle(self.current-position.x - self.pressed-position.x);
            }
        }

        TouchArea {
            changed mouse-x => { root.claim(); }
            changed mouse-y => { root.claim(); }
            Rectangle {
                clip: true;
                width: parent.width;
                height: parent.height;
                slides := HorizontalLayout {
                    // The drag moves the slides, which glide to rest after it.
                    property <length> offset;
                    x: -root.at * root.width + self.offset;
                    width: root.lists.length * root.width;
                    states [
                        swiping when swipe.swiping || root.page-slides: {
                            offset: clamp(root.page-slides ? Landing.slid : swipe.current-position.x - swipe.pressed-position.x, (root.slide - root.last-slide) * root.width, root.slide * root.width);
                            out {
                                animate offset { duration: 250ms; easing: Fling.curve; }
                            }
                        }
                    ]
                    for list in root.lists: RankedListView {
                        horizontal-stretch: 1;
                        preferred-width: 0;
                        min-width: 0;
                        list: list;
                        stale: root.stale;
                        open(link) => { root.open(link); }
                    }
                }
            }
        }
    }
    if !root.fits-two: HorizontalLayout {
        alignment: center;
        for list[i] in root.lists: SlideDot {
            label: list.title;
            current: i == root.slide;
            clicked => { root.slide-to(i); }
        }
    }
}
